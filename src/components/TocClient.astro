---
// Client-side component for TOC scroll detection and mobile interactions
---

<script>
  import { extractTocFromDOM } from "@/utils/extractToc";

  // TOC item type definition
  type TocItem = {
    id: string;
    title: string;
    children?: TocItem[];
  };

  // Ensure init across events: initial load / DOM ready / Astro route changes
  const tryInit = () => initializeTocWithRetry();
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    setTimeout(tryInit, 0);
  } else {
    document.addEventListener("DOMContentLoaded", tryInit, { once: true });
  }
  document.addEventListener("astro:page-load", tryInit);
  document.addEventListener("astro:after-swap", tryInit);

  async function initializeTocWithRetry(maxRetries = 20, intervalMs = 100) {
    // Wait for #article and at least one heading
    let attempt = 0;
    while (attempt < maxRetries) {
      const article = document.getElementById("article");
      const hasHeadings = !!document.querySelector(
        "#article h2, #article h3, #article h4, #article h5, #article h6"
      );
      if (article && hasHeadings) break;
      attempt += 1;
      await new Promise(r => setTimeout(r, intervalMs));
    }

    const tocItems = extractTocFromDOM();

    const tocContainer = document.getElementById("toc-sidebar");
    const tocToggle = document.getElementById("toc-toggle");
    const tocOpenDesktop = document.getElementById("toc-open-desktop");

    if (tocItems.length === 0) {
      // Hide buttons and container when no TOC
      if (tocContainer) tocContainer.style.display = "none";
      if (tocToggle) tocToggle.style.display = "none";
      if (tocOpenDesktop) tocOpenDesktop.style.display = "none";
      return;
    }

    // Show immediately when TOC exists to avoid flicker
    if (tocContainer) {
      tocContainer.style.display = "";
      // Add xl:block to show on large screens
      tocContainer.classList.add("xl:block");
    }
    if (tocToggle) {
      tocToggle.style.display = "";
      tocToggle.classList.add("xl:hidden");
    }
    if (tocOpenDesktop) tocOpenDesktop.style.display = "none";

    // Clear existing content to avoid duplicate render
    const nav = document.getElementById("toc-nav");
    if (nav) nav.innerHTML = "";

    // Render TOC
    renderToc(tocItems);

    // Setup scroll observer
    setupScrollObserver();

    // Setup mobile interactions (avoid duplicate binding)
    setupMobileInteractions();

    // Setup desktop expand/collapse
    setupDesktopToggle();
  }

  function renderToc(
    items: TocItem[],
    containerId: string = "toc-nav",
    level: number = 0
  ) {
    const container = document.getElementById(containerId);
    if (!container) return;

    // Remove loading placeholder
    const loading = container.querySelector("#toc-loading");
    if (loading) loading.remove();

    const ul = document.createElement("ul");
    ul.className = level === 0 ? "space-y-1.5" : "ml-4 space-y-1 mt-1";
    ul.setAttribute("role", "list");

    items.forEach((item: TocItem) => {
      const li = document.createElement("li");

      const link = document.createElement("a");
      link.href = `#${item.id}`;
      link.textContent = item.title;
      link.className = `block py-2 px-3 text-sm leading-relaxed text-muted hover:text-accent hover:bg-muted/40 rounded-md transition-all duration-200 border-l-2 border-transparent hover:border-accent/30 ${
        level > 0 ? "text-xs py-1.5 ml-2" : "font-medium"
      }`;
      // Avoid invalid ARIA: <a> should not be listitem; <li> provides list semantics

      // Smooth scroll with offset to avoid flicker
      link.addEventListener("click", (e: MouseEvent) => {
        e.preventDefault();
        const target = document.getElementById(item.id);
        if (target) {
          // Compute offset to prevent heading overlap (extra buffer)
          const yOffset = -120; // Negative to offset upward, give more space
          const y =
            target.getBoundingClientRect().top + window.pageYOffset + yOffset;

          // Update active state immediately to avoid IO delay flicker
          document
            .querySelectorAll("#toc-nav a.active, #toc-nav-mobile a.active")
            .forEach(el => {
              el.classList.remove(
                "active",
                "text-accent",
                "bg-muted/40",
                "border-accent",
                "font-semibold"
              );
              el.classList.add("text-muted", "border-transparent");
            });
          link.classList.add(
            "active",
            "text-accent",
            "bg-muted/40",
            "border-accent",
            "font-semibold"
          );
          link.classList.remove("text-muted", "border-transparent");
          link.setAttribute("aria-current", "true");

          // Then smooth scroll
          window.scrollTo({ top: y, behavior: "smooth" });
        }
      });

      li.appendChild(link);

      // If children exist, create a nested ul then recurse; avoid invalid container id
      if (item.children && item.children.length > 0) {
        const childUlWrapper = document.createElement("div");
        const childContainerId = `toc-child-${item.id}`;
        childUlWrapper.id = childContainerId;
        childUlWrapper.className = "mt-2";
        li.appendChild(childUlWrapper);
        renderToc(item.children, childContainerId, level + 1);
      }

      ul.appendChild(li);
    });

    container.appendChild(ul);
  }

  function setupScrollObserver(): void {
    const headings = document.querySelectorAll(
      "#article h2, #article h3, #article h4, #article h5, #article h6"
    );

    if (headings.length === 0) return;

    const observer = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          const id = entry.target.id;
          const link = document.querySelector(`#toc-nav a[href="#${id}"]`);
          const mobileLink = document.querySelector(
            `#toc-nav-mobile a[href="#${id}"]`
          );

          if (entry.isIntersecting) {
            // Remove all active states
            document
              .querySelectorAll("#toc-nav a.active, #toc-nav-mobile a.active")
              .forEach(el => {
                el.classList.remove(
                  "active",
                  "text-accent",
                  "bg-muted/40",
                  "border-accent",
                  "font-semibold"
                );
                el.classList.add("text-muted", "border-transparent");
                el.removeAttribute("aria-current");
              });

            // Add current active state
            if (link instanceof HTMLAnchorElement) {
              link.classList.add(
                "active",
                "text-accent",
                "bg-muted/40",
                "border-accent",
                "font-semibold"
              );
              link.classList.remove("text-muted", "border-transparent");
              link.setAttribute("aria-current", "true");
            }
            if (mobileLink instanceof HTMLAnchorElement) {
              mobileLink.classList.add(
                "active",
                "text-accent",
                "bg-muted/40",
                "border-accent",
                "font-semibold"
              );
              mobileLink.classList.remove("text-muted", "border-transparent");
              mobileLink.setAttribute("aria-current", "true");
            }
          }
        });
      },
      {
        rootMargin: "-120px 0px -60% 0px", // Adjust top margin to match scroll offset; add buffer
        threshold: [0, 0.1, 0.5],
      }
    );

    headings.forEach(heading => observer.observe(heading));
  }

  function setupMobileInteractions(): void {
    const toggle = document.getElementById("toc-toggle");
    const overlay = document.getElementById("toc-overlay");
    const close = document.getElementById("toc-close");
    const mobileNav = document.getElementById("toc-nav-mobile");

    if (!toggle || !overlay || !close || !mobileNav) return;

    // Copy desktop TOC to mobile
    const desktopNav = document.getElementById("toc-nav");
    if (desktopNav) {
      mobileNav.innerHTML = desktopNav.innerHTML;
      // Bind smooth scroll for mobile links
      mobileNav.querySelectorAll('a[href^="#"]').forEach(a => {
        (a as HTMLAnchorElement).addEventListener("click", e => {
          e.preventDefault();
          const current = e.currentTarget;
          const href =
            current instanceof HTMLAnchorElement
              ? current.getAttribute("href")
              : null;
          if (!href) return;
          const target = document.querySelector(href);
          if (target instanceof HTMLElement) {
            // Compute offset; keep consistent with desktop
            const yOffset = -120;
            const y =
              target.getBoundingClientRect().top + window.pageYOffset + yOffset;

            // Update active state first
            document
              .querySelectorAll("#toc-nav a.active, #toc-nav-mobile a.active")
              .forEach(el => {
                el.classList.remove(
                  "active",
                  "text-accent",
                  "bg-muted/40",
                  "border-accent",
                  "font-semibold"
                );
                el.classList.add("text-muted", "border-transparent");
                el.removeAttribute("aria-current");
              });
            const clickedLink =
              current instanceof HTMLAnchorElement ? current : null;
            if (clickedLink) {
              clickedLink.classList.add(
                "active",
                "text-accent",
                "bg-muted/40",
                "border-accent",
                "font-semibold"
              );
              clickedLink.classList.remove("text-muted", "border-transparent");
              clickedLink.setAttribute("aria-current", "true");
            }

            // Then smooth scroll
            window.scrollTo({ top: y, behavior: "smooth" });
          }
          // Close drawer
          const evt = new Event("click");
          close.dispatchEvent(evt);
        });
      });
    }

    // Toggle visibility
    toggle.addEventListener("click", () => {
      overlay.classList.remove("opacity-0", "pointer-events-none");
      overlay.classList.add("opacity-100", "pointer-events-auto");
      const slidePanel = overlay.querySelector(".transform");
      if (slidePanel) {
        slidePanel.classList.remove("translate-x-full");
        slidePanel.classList.add("translate-x-0");
      }
      toggle.setAttribute("aria-expanded", "true");
    });

    // Close
    const closeOverlay = () => {
      overlay.classList.add("opacity-0", "pointer-events-none");
      overlay.classList.remove("opacity-100", "pointer-events-auto");
      const slidePanel = overlay.querySelector(".transform");
      if (slidePanel) {
        slidePanel.classList.add("translate-x-full");
        slidePanel.classList.remove("translate-x-0");
      }
      toggle.setAttribute("aria-expanded", "false");
    };

    close.addEventListener("click", closeOverlay);
    overlay.addEventListener("click", e => {
      if (e.target === overlay) {
        closeOverlay();
      }
    });

    // Close on ESC key
    document.addEventListener("keydown", e => {
      if (e.key === "Escape" && !overlay.classList.contains("opacity-0")) {
        closeOverlay();
      }
    });

    // Avoid overlapping with the bottom-right "Back To Top" button
    const avoidOverlap = () => {
      if (!toggle) return;
      const backTop = document.querySelector('[data-button="back-to-top"]');
      const btnContainer = document.querySelector("#btt-btn-container");

      // Default bottom spacing: 1.5rem (24px)
      let bottom = 24;

      // Fixed safe bottom spacing on mobile to avoid jitter while scrolling
      const isMobile = window.innerWidth < 640;
      if (isMobile) {
        bottom = 112; // 7rem, reliably avoids Back To Top
        toggle.style.bottom = `${bottom}px`;
        return;
      }

      // Check if Back To Top exists and is visible
      if (backTop && btnContainer) {
        const toggleRect = toggle.getBoundingClientRect();
        const backTopRect = btnContainer.getBoundingClientRect();

        // Check Back To Top visibility (opaque and correctly positioned)
        const isBackTopVisible =
          !btnContainer.classList.contains("opacity-0") &&
          !btnContainer.classList.contains("translate-y-14");

        if (isBackTopVisible) {
          // Calculate overlap
          const overlap = !(
            toggleRect.right < backTopRect.left ||
            toggleRect.left > backTopRect.right ||
            toggleRect.bottom < backTopRect.top ||
            toggleRect.top > backTopRect.bottom
          );

          if (overlap) {
            // If overlapping, adjust spacing based on screen size
            bottom = 96; // Desktop: 6rem
          }
        }
      }

      toggle.style.bottom = `${bottom}px`;
    };

    // Initial invocation
    avoidOverlap();

    // Listen for window resize
    window.addEventListener("resize", avoidOverlap);

    // Listen for scroll; Back To Top visibility depends on it
    let ticking = false;
    const scrollHandler = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          avoidOverlap();
          ticking = false;
        });
        ticking = true;
      }
    };
    window.addEventListener("scroll", scrollHandler, { passive: true });

    // Observe Back To Top container class changes to react to visibility toggles
    if (window.MutationObserver) {
      const btnContainer = document.querySelector("#btt-btn-container");
      if (btnContainer) {
        const observer = new MutationObserver(() => {
          avoidOverlap();
        });

        observer.observe(btnContainer, {
          attributes: true,
          attributeFilter: ["class"],
          childList: false,
          subtree: false,
        });
      }
    }
  }

  function setupDesktopToggle() {
    const aside = document.getElementById("toc-sidebar");
    const collapseBtn = document.getElementById("toc-collapse");
    const openBtn = document.getElementById("toc-open-desktop");
    if (!aside || !collapseBtn || !openBtn) return;

    // On mobile, hide the desktop open button to avoid a second floating button
    const isDesktop = window.matchMedia("(min-width: 1280px)").matches;
    if (!isDesktop) {
      openBtn.style.display = "none";
      return;
    }

    // Initial state: TOC visible, open button hidden
    openBtn.style.display = "none";
    aside.style.display = "";
    aside.classList.add("xl:block");
    aside.setAttribute("aria-hidden", "false");

    const transitionDuration = 260;
    const transitionEasing = "cubic-bezier(0.4, 0, 0.2, 1)";
    const prefersReducedMotion =
      typeof window !== "undefined" &&
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const effectiveDuration = prefersReducedMotion ? 0 : transitionDuration;

    const clearAnimationState = () => {
      aside.style.transition = "";
      aside.style.willChange = "";
      aside.style.transform = "";
      aside.style.opacity = "";
      aside.style.pointerEvents = "";
      aside.removeAttribute("data-animating");
    };

    const hideAside = () => {
      if (aside.dataset.animating === "true") return;
      aside.dataset.animating = "true";

      collapseBtn.setAttribute("aria-expanded", "false");
      openBtn.setAttribute("aria-expanded", "false");
      aside.setAttribute("aria-hidden", "true");
      aside.setAttribute("inert", "");

      if (effectiveDuration > 0) {
        aside.style.willChange = "opacity, transform";
        aside.style.transition = `opacity ${effectiveDuration}ms ${transitionEasing}, transform ${effectiveDuration}ms ${transitionEasing}`;
      }

      // Trigger the animation on the next frame for smoothness
      if (effectiveDuration > 0) {
        requestAnimationFrame(() => {
          aside.style.opacity = "0";
          aside.style.transform = "translateX(-0.75rem)";
          aside.style.pointerEvents = "none";
        });
      }

      let finalized = false;

      const finalize = () => {
        if (finalized) return;
        finalized = true;
        aside.style.display = "none";
        openBtn.style.display = "inline-flex";
        clearAnimationState();
        aside.removeEventListener("transitionend", onTransitionEnd);
        window.clearTimeout(fallbackId);
      };

      const onTransitionEnd = (event: TransitionEvent) => {
        if (
          event.target === aside &&
          (event.propertyName === "opacity" ||
            event.propertyName === "transform")
        ) {
          finalize();
        }
      };

      const fallbackId = window.setTimeout(
        () => finalize(),
        effectiveDuration + 120
      );
      if (effectiveDuration > 0) {
        aside.addEventListener("transitionend", onTransitionEnd);
      } else {
        finalize();
      }
    };

    const showAside = () => {
      if (aside.dataset.animating === "true") return;
      aside.dataset.animating = "true";

      openBtn.style.display = "none";
      aside.style.display = "";
      aside.setAttribute("aria-hidden", "false");
      collapseBtn.setAttribute("aria-expanded", "true");
      openBtn.setAttribute("aria-expanded", "true");

      if (effectiveDuration > 0) {
        aside.style.opacity = "0";
        aside.style.transform = "translateX(-0.75rem)";
        aside.style.pointerEvents = "none";
        aside.style.willChange = "opacity, transform";
      }

      if (effectiveDuration > 0) {
        requestAnimationFrame(() => {
          aside.style.transition = `opacity ${effectiveDuration}ms ${transitionEasing}, transform ${effectiveDuration}ms ${transitionEasing}`;
          requestAnimationFrame(() => {
            aside.style.opacity = "1";
            aside.style.transform = "translateX(0)";
          });
        });
      }

      let finalized = false;

      const finalize = () => {
        if (finalized) return;
        finalized = true;
        aside.removeAttribute("inert");
        clearAnimationState();
        aside.removeEventListener("transitionend", onTransitionEnd);
        window.clearTimeout(fallbackId);
      };

      const onTransitionEnd = (event: TransitionEvent) => {
        if (
          event.target === aside &&
          (event.propertyName === "opacity" ||
            event.propertyName === "transform")
        ) {
          finalize();
        }
      };

      const fallbackId = window.setTimeout(
        () => finalize(),
        effectiveDuration + 120
      );
      if (effectiveDuration > 0) {
        aside.addEventListener("transitionend", onTransitionEnd);
      } else {
        finalize();
      }
    };

    collapseBtn.addEventListener("click", hideAside);
    openBtn.addEventListener("click", showAside);
  }
</script>
