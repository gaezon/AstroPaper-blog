---
// Client-side component for TOC scroll detection and mobile interactions
---

<script>
  import { extractTocFromDOM } from "@/utils/extractToc";
  import { createTocClickHandler } from "@/utils/scroll";

  // TOC item type definition
  type TocItem = {
    id: string;
    title: string;
    children?: TocItem[];
  };

  // Define transition fallback slack in milliseconds
  const TRANSITION_FALLBACK_SLACK_MS = 120;

  // Ensure init across events: initial load / DOM ready / Astro route changes
  const tryInit = () => initializeTocWithRetry();
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    setTimeout(tryInit, 0);
  } else {
    document.addEventListener("DOMContentLoaded", tryInit, { once: true });
  }
  document.addEventListener("astro:page-load", tryInit);
  document.addEventListener("astro:after-swap", tryInit);

  async function initializeTocWithRetry(maxRetries = 20, intervalMs = 100) {
    // Clean up previous bindings before re-initializing
    cleanupToc();

    // Wait for #article and at least one heading
    let attempt = 0;
    while (attempt < maxRetries) {
      const article = document.getElementById("article");
      const hasHeadings = !!document.querySelector(
        "#article h2, #article h3, #article h4, #article h5, #article h6"
      );
      if (article && hasHeadings) break;
      attempt += 1;
      await new Promise(r => setTimeout(r, intervalMs));
    }

    const tocItems = extractTocFromDOM();

    const tocContainer = document.getElementById("toc-sidebar");
    const tocToggle = document.getElementById("toc-toggle");
    const tocOpenDesktop = document.getElementById("toc-open-desktop");

    if (tocItems.length === 0) {
      // Hide buttons and container when no TOC
      if (tocContainer) tocContainer.style.display = "none";
      if (tocToggle) tocToggle.style.display = "none";
      if (tocOpenDesktop) tocOpenDesktop.style.display = "none";
      return;
    }

    // Show immediately when TOC exists to avoid flicker
    if (tocContainer) {
      tocContainer.style.display = "";
      // Add xl:block to show on large screens
      tocContainer.classList.add("xl:block");
    }
    if (tocToggle) {
      tocToggle.style.display = "";
      tocToggle.classList.add("xl:hidden");
    }
    if (tocOpenDesktop) tocOpenDesktop.style.display = "none";

    // Clear existing content to avoid duplicate render
    const nav = document.getElementById("toc-nav");
    if (nav) nav.innerHTML = "";

    // Render TOC
    renderToc(tocItems);

    // Setup scroll observer
    setupScrollObserver();

    // Setup mobile interactions (avoid duplicate binding)
    setupMobileInteractions();

    // Setup desktop expand/collapse
    setupDesktopToggle();
  }

  function renderToc(
    items: TocItem[],
    containerId: string = "toc-nav",
    level: number = 0
  ) {
    const container = document.getElementById(containerId);
    if (!container) return;

    // Remove loading placeholder
    const loading = container.querySelector("#toc-loading");
    if (loading) loading.remove();

    const ul = document.createElement("ul");
    ul.className = level === 0 ? "space-y-1.5" : "ml-4 space-y-1 mt-1";
    ul.setAttribute("role", "list");

    items.forEach((item: TocItem) => {
      const li = document.createElement("li");

      const link = document.createElement("a");
      link.href = `#${item.id}`;
      link.textContent = item.title;
      link.className = `block py-2 px-3 text-sm leading-relaxed text-muted hover:text-accent hover:bg-muted/40 rounded-md transition-all duration-200 border-l-2 border-transparent hover:border-accent/30 ${
        level > 0 ? "text-xs py-1.5 ml-2" : "font-medium"
      }`;
      // Avoid invalid ARIA: <a> should not be listitem; <li> provides list semantics

      // Smooth scroll with offset to avoid flicker
      link.addEventListener("click", (e: MouseEvent) => {
        const handler = createTocClickHandler({
          desktopNavId: "toc-nav",
          mobileNavId: "toc-nav-mobile",
          offset: -120,
          scrollingFlag: scrollingState,
          timeoutRef: scrollTimeoutRef,
        });
        handler(e, link);
      });

      li.appendChild(link);

      // If children exist, create a nested ul then recurse; avoid invalid container id
      if (item.children && item.children.length > 0) {
        const childUlWrapper = document.createElement("div");
        const childContainerId = `toc-child-${item.id}`;
        childUlWrapper.id = childContainerId;
        childUlWrapper.className = "mt-2";
        li.appendChild(childUlWrapper);
        renderToc(item.children, childContainerId, level + 1);
      }

      ul.appendChild(li);
    });

    container.appendChild(ul);
  }

  let tocObserver: IntersectionObserver | null = null;
  const scrollingState = { value: false };
  const scrollTimeoutRef = { value: null as number | null };

  // Store cleanup functions to prevent duplicate bindings
  let scrollCleanup: (() => void) | null = null;
  let resizeCleanup: (() => void) | null = null;
  let keydownCleanup: (() => void) | null = null;
  let mutationObserver: MutationObserver | null = null;
  let desktopToggleCleanup: (() => void) | null = null;
  let toggleCleanup: (() => void) | null = null;
  let closeCleanup: (() => void) | null = null;
  let overlayClickCleanup: (() => void) | null = null;

  function cleanupToc(): void {
    // Disconnect IntersectionObserver
    if (tocObserver) {
      tocObserver.disconnect();
      tocObserver = null;
    }

    // Clean up scroll listener
    if (scrollCleanup) {
      scrollCleanup();
      scrollCleanup = null;
    }

    // Clean up resize listener
    if (resizeCleanup) {
      resizeCleanup();
      resizeCleanup = null;
    }

    // Clean up keydown listener
    if (keydownCleanup) {
      keydownCleanup();
      keydownCleanup = null;
    }

    // Clean up MutationObserver
    if (mutationObserver) {
      mutationObserver.disconnect();
      mutationObserver = null;
    }

    // Clean up desktop toggle listeners
    if (desktopToggleCleanup) {
      desktopToggleCleanup();
      desktopToggleCleanup = null;
    }

    // Clean up mobile overlay listeners
    if (toggleCleanup) {
      toggleCleanup();
      toggleCleanup = null;
    }

    // Clean up close button listener
    if (closeCleanup) {
      closeCleanup();
      closeCleanup = null;
    }

    // Clean up overlay click listener
    if (overlayClickCleanup) {
      overlayClickCleanup();
      overlayClickCleanup = null;
    }
  }

  function setupScrollObserver(): void {
    const headings = document.querySelectorAll(
      "#article h2, #article h3, #article h4, #article h5, #article h6"
    );

    if (headings.length === 0) return;

    const observer = new IntersectionObserver(
      entries => {
        // Skip if currently scrolling programmatically
        if (scrollingState.value) return;

        entries.forEach(entry => {
          const id = entry.target.id;
          const link = document.querySelector(`#toc-nav a[href="#${id}"]`);
          const mobileLink = document.querySelector(
            `#toc-nav-mobile a[href="#${id}"]`
          );

          if (entry.isIntersecting) {
            // Remove all active states
            document
              .querySelectorAll("#toc-nav a.active, #toc-nav-mobile a.active")
              .forEach(el => {
                el.classList.remove(
                  "active",
                  "text-accent",
                  "bg-muted/40",
                  "border-accent",
                  "font-semibold"
                );
                el.classList.add("text-muted", "border-transparent");
                el.removeAttribute("aria-current");
              });

            // Add current active state
            if (link instanceof HTMLAnchorElement) {
              link.classList.add(
                "active",
                "text-accent",
                "bg-muted/40",
                "border-accent",
                "font-semibold"
              );
              link.classList.remove("text-muted", "border-transparent");
              link.setAttribute("aria-current", "true");
            }
            if (mobileLink instanceof HTMLAnchorElement) {
              mobileLink.classList.add(
                "active",
                "text-accent",
                "bg-muted/40",
                "border-accent",
                "font-semibold"
              );
              mobileLink.classList.remove("text-muted", "border-transparent");
              mobileLink.setAttribute("aria-current", "true");
            }
          }
        });
      },
      {
        rootMargin: "-120px 0px -60% 0px", // Adjust top margin to match scroll offset; add buffer
        threshold: [0, 0.1, 0.5],
      }
    );

    tocObserver = observer;
    headings.forEach(heading => observer.observe(heading));
  }

  function pauseScrollObserver(): void {
    if (tocObserver) {
      // Disconnect the observer to prevent interference during animation
      tocObserver.disconnect();
    }
  }

  function resumeScrollObserver(): void {
    if (tocObserver) {
      // Re-observe all headings
      const headings = document.querySelectorAll(
        "#article h2, #article h3, #article h4, #article h5, #article h6"
      );
      const observer = tocObserver;
      if (observer) {
        headings.forEach(heading => observer.observe(heading));
      }
    }
  }

  function setupMobileInteractions(): void {
    const toggle = document.getElementById("toc-toggle");
    const overlay = document.getElementById("toc-overlay");
    const close = document.getElementById("toc-close");
    const mobileNav = document.getElementById("toc-nav-mobile");

    if (!toggle || !overlay || !close || !mobileNav) return;

    // Copy desktop TOC to mobile
    const desktopNav = document.getElementById("toc-nav");
    if (desktopNav) {
      mobileNav.innerHTML = desktopNav.innerHTML;
      // Bind smooth scroll for mobile links
      mobileNav.querySelectorAll('a[href^="#"]').forEach(a => {
        (a as HTMLAnchorElement).addEventListener("click", e => {
          const handler = createTocClickHandler({
            desktopNavId: "toc-nav",
            mobileNavId: "toc-nav-mobile",
            offset: -120,
            scrollingFlag: scrollingState,
            timeoutRef: scrollTimeoutRef,
            onClick: () => {
              // Close drawer
              const evt = new Event("click");
              close.dispatchEvent(evt);
            },
          });
          handler(e, a as HTMLAnchorElement);
        });
      });
    }

    // Toggle visibility
    const handleToggleClick = () => {
      overlay.classList.remove("opacity-0", "pointer-events-none");
      overlay.classList.add("opacity-100", "pointer-events-auto");
      const slidePanel = overlay.querySelector(".transform");
      if (slidePanel) {
        slidePanel.classList.remove("translate-x-full");
        slidePanel.classList.add("translate-x-0");
      }
      toggle.setAttribute("aria-expanded", "true");
    };
    toggle.addEventListener("click", handleToggleClick);
    toggleCleanup = () => {
      toggle.removeEventListener("click", handleToggleClick);
    };

    // Close
    const closeOverlay = () => {
      overlay.classList.add("opacity-0", "pointer-events-none");
      overlay.classList.remove("opacity-100", "pointer-events-auto");
      const slidePanel = overlay.querySelector(".transform");
      if (slidePanel) {
        slidePanel.classList.add("translate-x-full");
        slidePanel.classList.remove("translate-x-0");
      }
      toggle.setAttribute("aria-expanded", "false");
    };

    close.addEventListener("click", closeOverlay);
    closeCleanup = () => {
      close.removeEventListener("click", closeOverlay);
    };

    const handleOverlayClick = (e: MouseEvent) => {
      if (e.target === overlay) {
        closeOverlay();
      }
    };
    overlay.addEventListener("click", handleOverlayClick);
    overlayClickCleanup = () => {
      overlay.removeEventListener("click", handleOverlayClick);
    };

    // Close on ESC key
    const handleKeydown = (e: KeyboardEvent) => {
      if (e.key === "Escape" && !overlay.classList.contains("opacity-0")) {
        closeOverlay();
      }
    };
    document.addEventListener("keydown", handleKeydown);
    keydownCleanup = () => {
      document.removeEventListener("keydown", handleKeydown);
    };

    // Avoid overlapping with the bottom-right "Back To Top" button
    // FastDOM pattern: separate read and write phases to avoid forced reflow
    //
    // Throttling state
    let rafId: number | null = null;
    let needsUpdate = false;

    const avoidOverlap = () => {
      if (!toggle) return;

      // Schedule update if not already scheduled
      if (rafId === null) {
        rafId = requestAnimationFrame(() => {
          // Phase 1: READ all layout information in current frame
          const backTop = document.querySelector('[data-button="back-to-top"]');
          const btnContainer = document.querySelector("#btt-btn-container");

          // Default bottom spacing: 1.5rem (24px)
          let bottom = 24;

          // Fixed safe bottom spacing on mobile to avoid jitter while scrolling
          const isMobile = window.innerWidth < 640;
          if (isMobile) {
            bottom = 112; // 7rem, reliably avoids Back To Top
            // Phase 2: WRITE all style changes
            toggle.style.bottom = `${bottom}px`;
            rafId = null;

            // Check if another update was requested during this frame
            if (needsUpdate) {
              needsUpdate = false;
              avoidOverlap();
            }
            return;
          }

          // Check if Back To Top exists and is visible
          if (backTop && btnContainer) {
            const toggleRect = toggle.getBoundingClientRect();
            const backTopRect = btnContainer.getBoundingClientRect();

            // Check Back To Top visibility (opaque and correctly positioned)
            const isBackTopVisible =
              !btnContainer.classList.contains("opacity-0") &&
              !btnContainer.classList.contains("translate-y-14");

            if (isBackTopVisible) {
              // Calculate overlap
              const overlap = !(
                toggleRect.right < backTopRect.left ||
                toggleRect.left > backTopRect.right ||
                toggleRect.bottom < backTopRect.top ||
                toggleRect.top > backTopRect.bottom
              );

              if (overlap) {
                // If overlapping, adjust spacing based on screen size
                bottom = 96; // Desktop: 6rem
              }
            }
          }

          // Phase 2: WRITE all style changes
          toggle.style.bottom = `${bottom}px`;
          rafId = null;

          // Check if another update was requested during this frame
          if (needsUpdate) {
            needsUpdate = false;
            avoidOverlap();
          }
        });
      } else {
        // Mark that update is needed after current frame completes
        needsUpdate = true;
      }
    };

    // Initial invocation
    avoidOverlap();

    // Listen for window resize
    window.addEventListener("resize", avoidOverlap);
    resizeCleanup = () => {
      window.removeEventListener("resize", avoidOverlap);
    };

    // Listen for scroll; Back To Top visibility depends on it (use RAF throttling)
    window.addEventListener("scroll", avoidOverlap, { passive: true });
    scrollCleanup = () => {
      window.removeEventListener("scroll", avoidOverlap);
    };

    // Observe Back To Top container class changes to react to visibility toggles
    if (window.MutationObserver) {
      const btnContainer = document.querySelector("#btt-btn-container");
      if (btnContainer) {
        mutationObserver = new MutationObserver(() => {
          avoidOverlap();
        });

        mutationObserver.observe(btnContainer, {
          attributes: true,
          attributeFilter: ["class"],
          childList: false,
          subtree: false,
        });
      }
    }
  }

  function setupDesktopToggle() {
    const aside = document.getElementById("toc-sidebar");
    const collapseBtn = document.getElementById("toc-collapse");
    const openBtn = document.getElementById("toc-open-desktop");
    if (!aside || !collapseBtn || !openBtn) return;

    // On mobile, hide the desktop open button to avoid a second floating button
    const isDesktop = window.matchMedia("(min-width: 1280px)").matches;
    if (!isDesktop) {
      openBtn.style.display = "none";
      return;
    }

    // Initial state: TOC visible, open button hidden
    openBtn.style.display = "none";
    aside.style.display = "";
    aside.classList.add("xl:block");
    aside.setAttribute("aria-hidden", "false");

    // Helper to parse CSS time strings (e.g., "260ms", "0.3s") to ms
    function parseCSSTime(timeStr: string): number {
      if (timeStr.endsWith("ms")) {
        return parseFloat(timeStr);
      } else if (timeStr.endsWith("s")) {
        return parseFloat(timeStr) * 1000;
      }
      return 0;
    }

    // Compute transition duration and delay from CSS
    function getTransitionDurationMs(element: HTMLElement): number {
      const styles = getComputedStyle(element);
      const durations = styles.transitionDuration
        .split(",")
        .map(s => s.trim())
        .map(parseCSSTime);
      const delays = styles.transitionDelay
        .split(",")
        .map(s => s.trim())
        .map(parseCSSTime);
      // Use the max total duration+delay for all transitions
      const totals = durations.map((d, i) => d + (delays[i] || 0));
      return Math.max(...totals, 0);
    }

    const prefersReducedMotion =
      typeof window !== "undefined" &&
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Get transition duration from CSS (0 if reduced motion preferred)
    const transitionDuration = prefersReducedMotion
      ? 0
      : getTransitionDurationMs(aside);
    const effectiveDuration = transitionDuration;

    const clearAnimationState = () => {
      aside.style.transition = "";
      aside.style.willChange = "";
      aside.style.transform = "";
      aside.style.opacity = "";
      aside.style.pointerEvents = "";
      aside.removeAttribute("data-animating");
    };

    const setTransitionState = (
      state: "entering" | "entered" | "exiting" | "exited"
    ) => {
      // Remove all state classes first
      aside.classList.remove(
        "toc-entering",
        "toc-entered",
        "toc-exiting",
        "toc-exited"
      );

      // Add the new state class
      aside.classList.add(`toc-${state}`);

      // Update data-state attribute for CSS targeting
      aside.setAttribute("data-toc-state", state);
    };

    /**
     * Generic animation wrapper with transitionend listener and fallback
     * @param finalize Callback to run after transition completes
     */
    const runTransition = (finalize: () => void) => {
      // If reduced motion is preferred, skip animation entirely
      if (prefersReducedMotion) {
        finalize();
        return;
      }

      let finalized = false;

      const doFinalize = () => {
        if (finalized) return;
        finalized = true;
        aside.removeEventListener("transitionend", onTransitionEnd);
        window.clearTimeout(fallbackId);
        finalize();
      };

      const onTransitionEnd = (event: TransitionEvent) => {
        if (
          event.target === aside &&
          (event.propertyName === "opacity" ||
            event.propertyName === "transform")
        ) {
          doFinalize();
        }
      };

      const fallbackId = window.setTimeout(
        () => doFinalize(),
        effectiveDuration + TRANSITION_FALLBACK_SLACK_MS
      );

      if (effectiveDuration > 0) {
        aside.addEventListener("transitionend", onTransitionEnd);
      } else {
        doFinalize();
      }
    };

    const hideAside = () => {
      if (aside.dataset.animating === "true") return;
      const activeElement = document.activeElement;
      const hadFocusInside =
        activeElement instanceof Element && aside.contains(activeElement);
      aside.dataset.animating = "true";

      // Pause observer to prevent interference during animation
      pauseScrollObserver();

      // Set ARIA states immediately for assistive technologies
      collapseBtn.setAttribute("aria-expanded", "false");
      openBtn.setAttribute("aria-expanded", "false");
      aside.setAttribute("aria-hidden", "true");
      aside.setAttribute("inert", "");

      // Disable pointer events immediately to prevent interaction during animation
      aside.style.pointerEvents = "none";

      // Set transition state to exiting to trigger CSS animation
      setTransitionState("exiting");

      // Define finalization logic
      const finalize = () => {
        aside.style.display = "none";
        openBtn.style.display = "inline-flex";
        setTransitionState("exited");

        // Move focus to open button if it was inside the collapsed aside
        if (hadFocusInside) {
          openBtn.focus({ preventScroll: true });
        }

        clearAnimationState();
        resumeScrollObserver();
      };

      runTransition(finalize);
    };

    const showAside = () => {
      if (aside.dataset.animating === "true") return;
      aside.dataset.animating = "true";

      // Pause observer to prevent interference during animation
      pauseScrollObserver();

      // Prepare element for animation
      aside.style.display = "";
      aside.setAttribute("inert", ""); // Keep inert during animation
      collapseBtn.setAttribute("aria-expanded", "true");
      openBtn.setAttribute("aria-expanded", "true");

      // Trigger CSS animation
      setTransitionState("entering");

      // Define finalization logic
      const finalize = () => {
        aside.removeAttribute("inert");
        aside.setAttribute("aria-hidden", "false");
        openBtn.style.display = "none";
        // Move focus to collapse button for keyboard users
        collapseBtn.focus({ preventScroll: true });
        clearAnimationState();
        resumeScrollObserver();
      };

      // Defer to next frame to ensure CSS transition triggers
      requestAnimationFrame(() => {
        runTransition(finalize);
        setTransitionState("entered");
      });
    };

    collapseBtn.addEventListener("click", hideAside);
    openBtn.addEventListener("click", showAside);

    // Store cleanup function
    desktopToggleCleanup = () => {
      collapseBtn.removeEventListener("click", hideAside);
      openBtn.removeEventListener("click", showAside);
    };
  }
</script>
