---
import type { TocItem } from "@/utils/toc/types";

export interface Props {
  items: TocItem[];
}

const { items } = Astro.props as Props;
---

<ol>
  {items.map(item => (
    <li>
      <a href={`#${item.slug}`}>{item.text}</a>
      {item.children.length > 0 && <Astro.self items={item.children} />}
    </li>
  ))}
</ol>
