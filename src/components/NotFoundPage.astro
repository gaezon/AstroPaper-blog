---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import LinkButton from "@/components/LinkButton.astro";
import Layout from "@/layouts/Layout.astro";
import { t } from "@/i18n/utils";
import { getLocalizedPath, getLocalizedSiteTitle } from "@/utils/i18n-pages";
import type { BlogLocale } from "@/utils/blog-locale";

interface Props {
  locale: BlogLocale;
}

const { locale } = Astro.props as Props;
const tr = (key: string, params?: Record<string, string | number>) =>
  t(Astro, key, params);
const homePath = getLocalizedPath(locale);
const siteTitle = getLocalizedSiteTitle(locale);
---

<Layout
  title={`404 ${tr("error.notFound.title")} | ${siteTitle}`}
  description={tr("error.notFound.description")}
  disableHreflangAlternates={true}
  disablePageUrlMeta={true}
  disableStructuredData={true}
  robots="noindex,follow"
>
  <Header />

  <main
    id="main-content"
    class="mx-auto flex max-w-app flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <h1 class="text-9xl font-bold text-accent">404</h1>
      <span aria-hidden="true">¯\_(ツ)_/¯</span>
      <p class="mt-4 text-2xl sm:text-3xl">{tr("error.notFound.title")}</p>
      <LinkButton
        href={homePath}
        class="my-6 text-lg underline decoration-dashed underline-offset-8"
      >
        {tr("error.notFound.backHome")}
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
