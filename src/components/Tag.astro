---
import IconHash from "@/assets/icons/IconHash.svg";
import { getCurrentLocale } from "@/i18n/utils";
import { DEFAULT_LOCALE } from "@/i18n/config";
import { toTransitionName } from "@/utils/toTransitionName";

export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
}

const { tag, tagName, size = "sm" } = Astro.props;
const locale = getCurrentLocale(Astro);
const hrefPrefix = locale === DEFAULT_LOCALE ? "" : `/${locale}`;
const localizedHref = `${hrefPrefix}/tags/${tag}/`;
---

<li class:list={["inline-block", size === "sm" ? "my-1" : "mx-1 my-3"]}>
  <a
    href={localizedHref}
    transition:name={toTransitionName(tag)}
    class:list={[
      "inline-flex items-center gap-0.5 border-b-2 border-dashed border-foreground",
      "hover:-mt-0.5 hover:border-accent hover:text-accent",
      "focus-visible:border-none focus-visible:text-accent",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-4": size === "sm" },
        { "size-5": size === "lg" },
      ]}
    />
    {tagName}
  </a>
</li>
