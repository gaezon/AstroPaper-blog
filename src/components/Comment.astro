---
import { getCurrentLocale, getLangTag } from "@/i18n/utils";

const currentLocale = getCurrentLocale(Astro);
const langTag = getLangTag(Astro);
---

<div id="tcomment"></div>

<script define:vars={{ langTag }}>
  document.addEventListener("astro:page-load", () => {
    function loadTwikoo() {
      const commentsContainer = document.getElementById("tcomment");
      if (commentsContainer) {
        const script = document.createElement("script");
        script.src =
          "https://cdn.staticfile.org/twikoo/1.6.39/twikoo.all.min.js";
        script.async = true;
        script.onload = () => {
          const initScript = document.createElement("script");
          initScript.innerHTML = `
            twikoo.init({
                envId: 'https://comment.gaazeon.com/',
                el: '#tcomment',
                lang: '${langTag}',
            });
        `;
          document.body.appendChild(initScript);
        };
        document.body.appendChild(script);
      }
    }
    loadTwikoo();
  });
</script>
