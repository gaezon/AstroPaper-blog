---
import { getLangTag } from "@/i18n/utils";
import type { CollectionEntry } from "astro:content";
import { getChineseSlug } from "@/config/slugMapping";

interface Props {
  post?: CollectionEntry<"blog" | "blog-en">;
}

const { post } = Astro.props;
const langTag = getLangTag(Astro);

// 生成统一的评论 ID：优先使用 originalTitle，其次是 title
const getCommentId = () => {
  if (!post) return null;

  // 如果有 originalTitle，使用它作为统一标识符（中英文文章都有相同的 originalTitle）
  if (post.data.originalTitle) {
    return post.data.originalTitle;
  }

  // 回退到使用 title（中文文章）或从 id 提取 slug
  return post.data.title || post.id;
};

const commentId = getCommentId();
---

<div id="tcomment"></div>

<script define:vars={{ langTag, commentId, post }}>
  document.addEventListener("astro:page-load", () => {
    function loadTwikoo() {
      const commentsContainer = document.getElementById("tcomment");
      if (commentsContainer) {
        const script = document.createElement("script");
        script.src =
          "https://cdn.staticfile.org/twikoo/1.6.39/twikoo.all.min.js";
        script.async = true;
        script.onload = () => {
          // 构建 Twikoo 配置
          const twikooConfig = {
            envId: "https://comment.gaazeon.com/",
            el: "#tcomment",
            lang: langTag,
          };

          // 如果有统一的评论 ID，则使用它
          if (commentId) {
            twikooConfig.id = commentId;

            // 向后兼容旧评论：优先使用原始路径，确保既有的评论能够正常显示
            // For posts with originalTitle, use the original Chinese post's path as the main path
            if (post && post.data.originalTitle) {
              // For English posts, map to the corresponding Chinese slug
              // For Chinese posts, use their own slug
              let chineseSlug;
              if (
                typeof post.data.locale === "string" &&
                post.data.locale === "en"
              ) {
                // English posts: Convert English slug to Chinese slug format
                // Use centralized slug mapping configuration for better maintainability
                chineseSlug =
                  getChineseSlug(post.data.slug) || post.data.slug || post.id;
              } else {
                // Chinese posts: use their own slug directly
                chineseSlug = post.data.slug || post.id;
              }
              if (chineseSlug) {
                twikooConfig.path = `/posts/${chineseSlug}/`;
              }
            } else {
              // Fallback to a unified comment path for new posts without originalTitle
              twikooConfig.path = `/comments/${commentId}/`;
            }
          }

          const initScript = document.createElement("script");
          initScript.innerHTML =
            "twikoo.init(" + JSON.stringify(twikooConfig) + ");";
          document.body.appendChild(initScript);
        };
        document.body.appendChild(script);
      }
    }
    loadTwikoo();
  });
</script>
