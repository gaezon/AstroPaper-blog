---
import { getLangTag } from "@/i18n/utils";
import { TWIKOO_CDN_URL } from "@/config/twikoo";
import { TWIKOO_SRI } from "@/utils/generated/twikooSRI";
import type { CollectionEntry } from "astro:content";

// Try to import dynamically generated mapping (Phase II)
let unifiedPaths: Record<
  string,
  {
    zhPath: string;
    enPath: string;
    unifiedCommentPath: string;
    confidence: number;
    matchType: string;
  }
> | null = null;

try {
  const mappingModule = await import("@/utils/generated/bilingualMapping.ts");
  unifiedPaths = mappingModule.unifiedCommentPaths;
} catch {
  // If dynamic mapping doesn't exist, fall back to originalTitle method (Phase I)
  // Silent fallback for CI environments
}

interface Props {
  post?: CollectionEntry<"blog" | "blog-en">;
}

const { post } = Astro.props;
const langTag = getLangTag(Astro);

// Generate a unified comment ID with fallback hierarchy
const getCommentId = () => {
  if (!post) return null;

  // Phase II: Prefer unified path from the dynamic mapping
  if (unifiedPaths && post.data.originalTitle) {
    const unifiedPath = unifiedPaths[post.data.originalTitle];
    if (unifiedPath) {
      return post.data.originalTitle;
    }
  }

  // Phase I: Use originalTitle as the unified identifier
  if (post.data.originalTitle) {
    return post.data.originalTitle;
  }

  // Fallback: Use title or file ID
  return post.data.title || post.id;
};

const commentId = getCommentId();

// Generate a comment path with automatic mapping
// Prefer historical canonical paths (zh/en) for backward compatibility
const getCommentPath = () => {
  if (!post) return null;

  // Phase II: Use dynamically generated mapping; prefer historical page paths (compatible with old comments)
  if (unifiedPaths && post.data.originalTitle) {
    const unifiedInfo = unifiedPaths[post.data.originalTitle];
    if (unifiedInfo) {
      // Compatibility strategy: prefer Chinese path (most existing comments), otherwise English path
      if (unifiedInfo.zhPath) return unifiedInfo.zhPath;
      if (unifiedInfo.enPath) return unifiedInfo.enPath;
      if (unifiedInfo.unifiedCommentPath) return unifiedInfo.unifiedCommentPath;
    }
  }

  // Phase I: Generate a unified path based on originalTitle (when no dynamic mapping)
  if (post.data.originalTitle) {
    // Create a URL-friendly slug from originalTitle
    const unifiedSlug = post.data.originalTitle
      .toLowerCase()
      .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, "-")
      .replace(/^-+|-+$/g, "");
    return `/comments/${unifiedSlug}/`;
  }

  // Fallback: Generate a default path
  const fallbackId = post.data.title || post.id;
  const fallbackSlug = fallbackId
    .toLowerCase()
    .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, "-")
    .replace(/^-+|-+$/g, "");
  return `/comments/${fallbackSlug}/`;
};

const commentPath = getCommentPath();
---

<div
  id="tcomment"
  data-twikoo-cdn={TWIKOO_CDN_URL}
  data-twikoo-sri={TWIKOO_SRI}
>
</div>

<script
  is:inline
  define:vars={{
    langTag,
    commentId,
    commentPath,
  }}
>
  document.addEventListener("astro:page-load", () => {
    function loadTwikoo() {
      const commentsContainer = document.getElementById("tcomment");
      if (commentsContainer) {
        const twikooCdnUrl = commentsContainer.dataset.twikooCdn;
        const twikooSri = commentsContainer.dataset.twikooSri;
        const loadErrorMessage =
          langTag === "zh-CN"
            ? "评论系统加载失败，请稍后重试。"
            : "Failed to load the comment system. Please try again later.";

        const showCommentLoadError = () => {
          commentsContainer.setAttribute("role", "status");
          commentsContainer.textContent = loadErrorMessage;
        };

        if (!twikooCdnUrl) {
          showCommentLoadError();
          return;
        }

        const script = document.createElement("script");
        script.src = twikooCdnUrl;
        script.async = true;
        script.crossOrigin = "anonymous";
        if (twikooSri) {
          script.integrity = twikooSri;
        }
        script.onload = () => {
          // Build Twikoo configuration
          const twikooConfig = {
            envId: "https://comment.gaazeon.com/",
            el: "#tcomment",
            lang: langTag,
          };

          // If there is a unified comment ID, use it
          if (commentId && commentPath) {
            twikooConfig.id = commentId;
            // Use the unified comment path for both language versions
            twikooConfig.path = commentPath;
          }

          if (window.twikoo && typeof window.twikoo.init === "function") {
            window.twikoo.init(twikooConfig);
          } else {
            showCommentLoadError();
          }
        };
        script.onerror = () => {
          showCommentLoadError();
        };
        document.body.appendChild(script);
      }
    }
    loadTwikoo();
  });
</script>
