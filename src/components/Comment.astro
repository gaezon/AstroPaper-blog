---
import { getLangTag } from "@/i18n/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  post?: CollectionEntry<"blog" | "blog-en">;
}

const { post } = Astro.props;
const langTag = getLangTag(Astro);

// 生成统一的评论 ID：优先使用 originalTitle，其次是 title
const getCommentId = () => {
  if (!post) return null;

  // 如果有 originalTitle，使用它作为统一标识符（中英文文章都有相同的 originalTitle）
  if (post.data.originalTitle) {
    return post.data.originalTitle;
  }

  // 回退到使用 title（中文文章）或从 id 提取 slug
  return post.data.title || post.id;
};

const commentId = getCommentId();
---

<div id="tcomment"></div>

<script define:vars={{ langTag, commentId, post }}>
  document.addEventListener("astro:page-load", () => {
    function loadTwikoo() {
      const commentsContainer = document.getElementById("tcomment");
      if (commentsContainer) {
        const script = document.createElement("script");
        script.src =
          "https://cdn.staticfile.org/twikoo/1.6.39/twikoo.all.min.js";
        script.async = true;
        script.onload = () => {
          // 构建 Twikoo 配置
          const twikooConfig = {
            envId: "https://comment.gaazeon.com/",
            el: "#tcomment",
            lang: langTag,
          };

          // 如果有统一的评论 ID，则使用它
          if (commentId) {
            twikooConfig.id = commentId;

            // 兼容过往评论：优先使用原始路径，确保既有的评论能够正常显示
            // 对于有 originalTitle 的文章，使用中文页面的原始路径作为主路径
            if (post && post.data.originalTitle) {
              // 对于英文文章，需要使用对应的中文文章的 slug
              // 对于中文文章，直接使用自己的 slug
              let chineseSlug;
              if (
                typeof post.data.locale === "string" &&
                post.data.locale === "en"
              ) {
                // 英文文章：从中文 slug 映射（需要根据实际情况调整）
                // 这里我们使用已知的中文 slug
                const slugMapping = {
                  "why-i-started-blogging": "Why-did-I-start-blogging",
                  // 可以添加更多映射
                };
                chineseSlug = slugMapping[post.data.slug] || post.data.slug;
              } else {
                // 中文文章：直接使用自己的 slug
                chineseSlug = post.data.slug || post.id;
              }
              twikooConfig.path = `/posts/${chineseSlug}/`;
            } else {
              // 回退到使用统一的评论路径
              twikooConfig.path = `/comments/${commentId}/`;
            }
          }

          const initScript = document.createElement("script");
          initScript.innerHTML =
            "twikoo.init(" + JSON.stringify(twikooConfig) + ");";
          document.body.appendChild(initScript);
        };
        document.body.appendChild(script);
      }
    }
    loadTwikoo();
  });
</script>
