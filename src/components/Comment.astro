---
import { getLangTag } from "@/i18n/utils";
import type { CollectionEntry } from "astro:content";
import { getBestChineseSlugForPath } from "@/config/slugMapping";

interface Props {
  post?: CollectionEntry<"blog" | "blog-en">;
}

const { post } = Astro.props;
const langTag = getLangTag(Astro);

// Generate a unified comment ID: prefer originalTitle, then title
const getCommentId = () => {
  if (!post) return null;

  // If originalTitle exists, use it as unified identifier (both Chinese and English articles share same originalTitle)
  if (post.data.originalTitle) {
    return post.data.originalTitle;
  }

  // Fallback to using title (for Chinese posts) or extract slug from id
  return post.data.title || post.id;
};

const commentId = getCommentId();

// Precompute Chinese slug for client use
const getChineseSlugForPath = () => {
  if (!post) return null;

  if (typeof post.data.locale === "string" && post.data.locale === "en") {
    // English posts: Resolve the best Chinese slug for comment path
    return post.data.slug
      ? getBestChineseSlugForPath(post.data.slug, post.id)
      : post.id;
  } else {
    // Chinese posts: use their own slug directly
    return post.data.slug || post.id;
  }
};

const chineseSlugForPath = getChineseSlugForPath();
---

<div id="tcomment"></div>

<script define:vars={{ langTag, commentId, post, chineseSlugForPath }}>
  document.addEventListener("astro:page-load", () => {
    function loadTwikoo() {
      const commentsContainer = document.getElementById("tcomment");
      if (commentsContainer) {
        const script = document.createElement("script");
        script.src =
          "https://cdn.staticfile.org/twikoo/1.6.39/twikoo.all.min.js";
        script.async = true;
        script.onload = () => {
          // Build Twikoo configuration
          const twikooConfig = {
            envId: "https://comment.gaazeon.com/",
            el: "#tcomment",
            lang: langTag,
          };

          // If there is a unified comment ID, use it
          if (commentId) {
            twikooConfig.id = commentId;

            // Backward compatibility for old comments: Prefer the original path to ensure existing comments are displayed correctly
            // For posts with originalTitle, use the original Chinese post's path as the main path
            if (post && post.data.originalTitle && chineseSlugForPath) {
              twikooConfig.path = `/posts/${chineseSlugForPath}/`;
            } else {
              // Fallback to a unified comment path for new posts without originalTitle
              twikooConfig.path = `/comments/${commentId}/`;
            }
          }

          const initScript = document.createElement("script");
          initScript.innerHTML =
            "twikoo.init(" + JSON.stringify(twikooConfig) + ");";
          document.body.appendChild(initScript);
        };
        document.body.appendChild(script);
      }
    }
    loadTwikoo();
  });
</script>
