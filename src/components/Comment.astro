---
import { getLangTag } from "@/i18n/utils";
import { TWIKOO_CDN_URL, TWIKOO_CSS_URL } from "@/config/twikoo";
import { TWIKOO_SRI } from "@/utils/generated/twikooSRI";
import type { CollectionEntry } from "astro:content";

// Try to import dynamically generated mapping (Phase II)
let unifiedPaths: Record<
  string,
  {
    zhPath: string;
    enPath: string;
    unifiedCommentPath: string;
    confidence: number;
    matchType: string;
  }
> | null = null;

try {
  const mappingModule = await import("@/utils/generated/bilingualMapping.ts");
  unifiedPaths = mappingModule.unifiedCommentPaths;
} catch {
  // If dynamic mapping doesn't exist, fall back to originalTitle method (Phase I)
  // Silent fallback for CI environments
}

interface Props {
  post?: CollectionEntry<"blog" | "blog-en">;
}

const { post } = Astro.props;
const langTag = getLangTag(Astro);

// Generate a unified comment ID with fallback hierarchy
const getCommentId = () => {
  if (!post) return null;

  // Phase II: Prefer unified path from the dynamic mapping
  if (unifiedPaths && post.data.originalTitle) {
    const unifiedPath = unifiedPaths[post.data.originalTitle];
    if (unifiedPath) {
      return post.data.originalTitle;
    }
  }

  // Phase I: Use originalTitle as the unified identifier
  if (post.data.originalTitle) {
    return post.data.originalTitle;
  }

  // Fallback: Use title or file ID
  return post.data.title || post.id;
};

const commentId = getCommentId();

// Generate a comment path with automatic mapping
// Prefer historical canonical paths (zh/en) for backward compatibility
const getCommentPath = () => {
  if (!post) return null;

  // Phase II: Use dynamically generated mapping; prefer historical page paths (compatible with old comments)
  if (unifiedPaths && post.data.originalTitle) {
    const unifiedInfo = unifiedPaths[post.data.originalTitle];
    if (unifiedInfo) {
      // Compatibility strategy: prefer Chinese path (most existing comments), otherwise English path
      if (unifiedInfo.zhPath) return unifiedInfo.zhPath;
      if (unifiedInfo.enPath) return unifiedInfo.enPath;
      if (unifiedInfo.unifiedCommentPath) return unifiedInfo.unifiedCommentPath;
    }
  }

  // Phase I: Generate a unified path based on originalTitle (when no dynamic mapping)
  if (post.data.originalTitle) {
    // Create a URL-friendly slug from originalTitle
    const unifiedSlug = post.data.originalTitle
      .toLowerCase()
      .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, "-")
      .replace(/^-+|-+$/g, "");
    return `/comments/${unifiedSlug}/`;
  }

  // Fallback: Generate a default path
  const fallbackId = post.data.title || post.id;
  const fallbackSlug = fallbackId
    .toLowerCase()
    .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, "-")
    .replace(/^-+|-+$/g, "");
  return `/comments/${fallbackSlug}/`;
};

const commentPath = getCommentPath();
const commentLoadTriggerLabel =
  langTag === "zh-CN" ? "点击加载评论" : "Load comments";
const commentAutoLoadHint =
  langTag === "zh-CN"
    ? "或滚动到评论区附近自动加载"
    : "Or scroll near this section to load automatically";
const commentLoadingMessage =
  langTag === "zh-CN" ? "正在加载评论..." : "Loading comments...";
const twikooObserverOffset = 400;
---

<div
  id="tcomment"
  data-comment-root="true"
  data-twikoo-cdn={TWIKOO_CDN_URL}
  data-twikoo-css={TWIKOO_CSS_URL}
  data-twikoo-sri={TWIKOO_SRI}
  data-lang-tag={langTag}
  data-comment-id={commentId ?? ""}
  data-comment-path={commentPath ?? ""}
  data-comment-loading={commentLoadingMessage}
  data-twikoo-observer-offset={String(twikooObserverOffset)}
  class="min-h-[140px]"
>
  <div
    data-comment-trigger-ui
    class="my-4 flex flex-col items-center gap-2 text-center text-sm text-muted"
  >
    <button
      type="button"
      data-comment-load-trigger
      class="rounded-md border border-border bg-muted/50 px-4 py-2 text-foreground transition-colors hover:bg-muted"
      aria-label={commentLoadTriggerLabel}
    >
      {commentLoadTriggerLabel}
    </button>
    <p>{commentAutoLoadHint}</p>
  </div>
</div>

<script is:inline>
  const COMMENT_ROOT_SELECTOR = "[data-comment-root='true']";

  const ensureTwikooLoaderBootstrap = () => {
    if (window.__twikooLazyLoaderBootstrapped) {
      return;
    }

    window.__twikooLazyLoaderBootstrapped = true;
    window.__twikooActiveCommentLoaders = new Set();

    document.addEventListener("astro:before-swap", () => {
      if (!(window.__twikooActiveCommentLoaders instanceof Set)) {
        return;
      }

      for (const disposeLoader of Array.from(
        window.__twikooActiveCommentLoaders
      )) {
        if (typeof disposeLoader === "function") {
          disposeLoader();
        }
      }

      window.__twikooActiveCommentLoaders.clear();
    });

    document.addEventListener("astro:page-load", () => {
      initCommentLoaders();
    });

    document.addEventListener("astro:after-swap", () => {
      initCommentLoaders();
    });
  };

  const setupCommentLoader = commentsContainer => {
    if (!(commentsContainer instanceof HTMLElement)) {
      return;
    }

    if (commentsContainer.dataset.commentLoaderBound === "true") {
      return;
    }

    commentsContainer.dataset.commentLoaderBound = "true";

    if (!commentsContainer.id) {
      commentsContainer.id = "tcomment";
    }

    if (
      commentsContainer.id === "tcomment" &&
      document.querySelectorAll("#tcomment").length > 1
    ) {
      const uniqueSuffix = Math.random().toString(36).slice(2, 8);
      commentsContainer.id = `tcomment-${Date.now().toString(36)}-${uniqueSuffix}`;
    }

    const twikooElementSelector = `#${commentsContainer.id}`;

    const langTag = commentsContainer.dataset.langTag || "zh-CN";
    const commentId = commentsContainer.dataset.commentId;
    const commentPath = commentsContainer.dataset.commentPath;
    const twikooCdnUrl = commentsContainer.dataset.twikooCdn;
    const twikooCssUrl = commentsContainer.dataset.twikooCss;
    const twikooSri = commentsContainer.dataset.twikooSri;
    const loadingMessage =
      commentsContainer.dataset.commentLoading || "Loading comments...";
    const observerOffset = Number(
      commentsContainer.dataset.twikooObserverOffset || 400
    );
    const prefetchDistance = Math.min(500, Math.max(300, observerOffset));

    const loadErrorMessage =
      langTag === "zh-CN"
        ? "评论系统加载失败，请稍后重试。"
        : "Failed to load the comment system. Please try again later.";

    const triggerUi = commentsContainer.querySelector(
      "[data-comment-trigger-ui]"
    );
    const loadButton = commentsContainer.querySelector(
      "[data-comment-load-trigger]"
    );

    let hasStarted = false;
    let isDisposed = false;
    let observer = null;
    let cleanupFallbackListener = null;

    const showCommentLoadError = () => {
      commentsContainer.removeAttribute("aria-busy");
      commentsContainer.setAttribute("role", "status");
      commentsContainer.textContent = loadErrorMessage;
    };

    const showLoadingState = () => {
      commentsContainer.setAttribute("aria-busy", "true");
      if (triggerUi) {
        triggerUi.setAttribute("role", "status");
        triggerUi.textContent = loadingMessage;
      } else {
        commentsContainer.setAttribute("role", "status");
        commentsContainer.textContent = loadingMessage;
      }
    };

    const ensureTwikooScript = () => {
      if (!twikooCdnUrl) {
        return Promise.reject(new Error("Missing Twikoo CDN URL"));
      }

      if (window.twikoo && typeof window.twikoo.init === "function") {
        return Promise.resolve(window.twikoo);
      }

      if (window.__twikooScriptPromise) {
        return window.__twikooScriptPromise;
      }

      window.__twikooScriptPromise = new Promise((resolve, reject) => {
        const existingScript = document.querySelector(
          'script[data-twikoo-script="true"]'
        );

        if (existingScript) {
          existingScript.remove();
        }

        const script = document.createElement("script");
        script.src = twikooCdnUrl;
        script.async = true;
        script.crossOrigin = "anonymous";
        script.dataset.twikooScript = "true";
        script.dataset.twikooState = "loading";

        if (twikooSri) {
          script.integrity = twikooSri;
        }

        script.onload = () => {
          script.dataset.twikooState = "loaded";

          if (window.twikoo && typeof window.twikoo.init === "function") {
            resolve(window.twikoo);
          } else {
            script.dataset.twikooState = "error";
            script.remove();
            window.__twikooScriptPromise = null;
            reject(new Error("Twikoo loaded but init is unavailable"));
          }
        };

        script.onerror = () => {
          script.dataset.twikooState = "error";
          script.remove();
          window.__twikooScriptPromise = null;
          reject(new Error("Failed to load Twikoo script"));
        };

        document.body.appendChild(script);
      });

      return window.__twikooScriptPromise;
    };

    const ensureTwikooStyles = () => {
      if (!twikooCssUrl) {
        return Promise.resolve();
      }

      const existingStyleLink = document.querySelector(
        'link[data-twikoo-style="true"]'
      );
      if (existingStyleLink) {
        return Promise.resolve();
      }

      const matchedLink = document.querySelector(
        `link[rel="stylesheet"][href="${twikooCssUrl}"]`
      );
      if (matchedLink instanceof HTMLLinkElement) {
        matchedLink.dataset.twikooStyle = "true";
        return Promise.resolve();
      }

      return new Promise(resolve => {
        const styleLink = document.createElement("link");
        styleLink.rel = "stylesheet";
        styleLink.href = twikooCssUrl;
        styleLink.crossOrigin = "anonymous";
        styleLink.dataset.twikooStyle = "true";

        const cleanup = () => {
          styleLink.removeEventListener("load", handleLoad);
          styleLink.removeEventListener("error", handleError);
        };

        const handleLoad = () => {
          cleanup();
          resolve();
        };

        const handleError = () => {
          cleanup();
          resolve();
        };

        styleLink.addEventListener("load", handleLoad, { once: true });
        styleLink.addEventListener("error", handleError, { once: true });

        const styleMountTarget = document.body || document.documentElement;
        styleMountTarget.appendChild(styleLink);
      });
    };

    const cleanupTriggers = () => {
      if (observer) {
        observer.disconnect();
        observer = null;
      }

      if (cleanupFallbackListener) {
        cleanupFallbackListener();
        cleanupFallbackListener = null;
      }
    };

    const startLoadingTwikoo = () => {
      if (hasStarted) {
        return;
      }

      hasStarted = true;
      cleanupTriggers();

      if (loadButton instanceof HTMLButtonElement) {
        loadButton.disabled = true;
      }

      showLoadingState();

      Promise.all([ensureTwikooStyles(), ensureTwikooScript()])
        .then(() => {
          if (isDisposed || !commentsContainer.isConnected) {
            return;
          }

          if (triggerUi) {
            triggerUi.remove();
          }

          const twikooConfig = {
            envId: "https://comment.gaazeon.com/",
            el: twikooElementSelector,
            lang: langTag,
          };

          if (commentId && commentPath) {
            twikooConfig.id = commentId;
            twikooConfig.path = commentPath;
          }

          if (window.twikoo && typeof window.twikoo.init === "function") {
            commentsContainer.removeAttribute("role");
            commentsContainer.removeAttribute("aria-busy");
            window.twikoo.init(twikooConfig);
          } else {
            showCommentLoadError();
          }
        })
        .catch(() => {
          if (isDisposed || !commentsContainer.isConnected) {
            return;
          }

          showCommentLoadError();
        });
    };

    const setupScrollFallbackTrigger = () => {
      let scrollRafId = null;

      const maybeLoadByScroll = () => {
        const distanceToViewport =
          commentsContainer.getBoundingClientRect().top - window.innerHeight;

        if (distanceToViewport <= prefetchDistance) {
          startLoadingTwikoo();
        }
      };

      const scheduleMaybeLoadByScroll = () => {
        if (scrollRafId !== null) {
          return;
        }

        scrollRafId = window.requestAnimationFrame(() => {
          scrollRafId = null;
          maybeLoadByScroll();
        });
      };

      const onScroll = () => {
        scheduleMaybeLoadByScroll();
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      scheduleMaybeLoadByScroll();

      cleanupFallbackListener = () => {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);

        if (scrollRafId !== null) {
          window.cancelAnimationFrame(scrollRafId);
          scrollRafId = null;
        }
      };
    };

    const clickTriggerHandler = () => {
      startLoadingTwikoo();
    };

    const disposeCommentLoader = () => {
      if (isDisposed) {
        return;
      }

      isDisposed = true;
      cleanupTriggers();

      if (loadButton instanceof HTMLButtonElement) {
        loadButton.removeEventListener("click", clickTriggerHandler);
      }

      delete commentsContainer.dataset.commentLoaderBound;

      if (window.__twikooActiveCommentLoaders instanceof Set) {
        window.__twikooActiveCommentLoaders.delete(disposeCommentLoader);
      }
    };

    if (window.__twikooActiveCommentLoaders instanceof Set) {
      window.__twikooActiveCommentLoaders.add(disposeCommentLoader);
    }

    if (loadButton instanceof HTMLButtonElement) {
      loadButton.addEventListener("click", clickTriggerHandler, { once: true });
    }

    if ("IntersectionObserver" in window) {
      observer = new IntersectionObserver(
        entries => {
          if (entries.some(entry => entry.isIntersecting)) {
            startLoadingTwikoo();
          }
        },
        {
          rootMargin: `0px 0px ${prefetchDistance}px 0px`,
          threshold: 0,
        }
      );

      observer.observe(commentsContainer);
    }

    setupScrollFallbackTrigger();
  };

  const initCommentLoaders = () => {
    const commentRoots = document.querySelectorAll(COMMENT_ROOT_SELECTOR);
    for (const commentRoot of commentRoots) {
      setupCommentLoader(commentRoot);
    }
  };

  ensureTwikooLoaderBootstrap();
  initCommentLoaders();
</script>
