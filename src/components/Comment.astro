---
import { getLangTag } from "@/i18n/utils";
import { TWIKOO_CDN_URL, TWIKOO_CSS_URL } from "@/config/twikoo";
import { TWIKOO_SRI } from "@/utils/generated/twikooSRI";
import type { CollectionEntry } from "astro:content";

// Try to import dynamically generated mapping (Phase II)
let unifiedPaths: Record<
  string,
  {
    zhPath: string;
    enPath: string;
    unifiedCommentPath: string;
    confidence: number;
    matchType: string;
  }
> | null = null;

try {
  const mappingModule = await import("@/utils/generated/bilingualMapping.ts");
  unifiedPaths = mappingModule.unifiedCommentPaths;
} catch {
  // If dynamic mapping doesn't exist, fall back to originalTitle method (Phase I)
  // Silent fallback for CI environments
}

interface Props {
  post?: CollectionEntry<"blog" | "blog-en">;
}

const { post } = Astro.props;
const langTag = getLangTag(Astro);

// Generate a unified comment ID with fallback hierarchy
const getCommentId = () => {
  if (!post) return null;

  // Phase II: Prefer unified path from the dynamic mapping
  const lookupKey = post.data.originalTitle || post.data.title;
  if (unifiedPaths && lookupKey) {
    const unifiedInfo = unifiedPaths[lookupKey];
    if (unifiedInfo) {
      return lookupKey;
    }
  }

  // Phase I: Use originalTitle as the unified identifier
  if (post.data.originalTitle) {
    return post.data.originalTitle;
  }

  // Fallback: Use title or file ID
  return post.data.title || post.id;
};

const commentId = getCommentId();

// Generate a comment path with automatic mapping
// Prefer historical canonical paths (zh/en) for backward compatibility
const getCommentPath = () => {
  if (!post) return null;

  // Phase II: Use dynamically generated mapping; prefer historical page paths (compatible with old comments)
  const lookupKey = post.data.originalTitle || post.data.title;
  if (unifiedPaths && lookupKey) {
    const unifiedInfo = unifiedPaths[lookupKey];
    if (unifiedInfo) {
      // Compatibility strategy: prefer Chinese path (most existing comments), otherwise English path
      if (unifiedInfo.zhPath) return unifiedInfo.zhPath;
      if (unifiedInfo.enPath) return unifiedInfo.enPath;
      if (unifiedInfo.unifiedCommentPath) return unifiedInfo.unifiedCommentPath;
    }
  }

  // Phase I: Generate a unified path based on originalTitle (when no dynamic mapping)
  if (post.data.originalTitle) {
    // Create a URL-friendly slug from originalTitle
    const unifiedSlug = post.data.originalTitle
      .toLowerCase()
      .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, "-")
      .replace(/^-+|-+$/g, "");
    return `/comments/${unifiedSlug}/`;
  }

  // Fallback: Generate a default path
  const fallbackId = post.data.title || post.id;
  const fallbackSlug = fallbackId
    .toLowerCase()
    .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, "-")
    .replace(/^-+|-+$/g, "");
  return `/comments/${fallbackSlug}/`;
};

const commentPath = getCommentPath();
const commentLoadTriggerLabel =
  langTag === "zh-CN" ? "点击加载评论" : "Load comments";
const commentAutoLoadHint =
  langTag === "zh-CN"
    ? "或滚动到评论区附近自动加载"
    : "Or scroll near this section to load automatically";
const commentLoadingMessage =
  langTag === "zh-CN" ? "正在加载评论..." : "Loading comments...";
const twikooObserverOffset = 400;
---

<!-- Twikoo assets/API are lazy-loaded from these origins; warm DNS ahead of the
scroll-triggered load. dns-prefetch (not preconnect): comments sit at the bottom
of the page, and browsers drop unused preconnect sockets after ~10s. -->
<link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
<link rel="dns-prefetch" href="https://comment.gaazeon.com" />

<div
  id="tcomment"
  data-comment-root="true"
  data-twikoo-cdn={TWIKOO_CDN_URL}
  data-twikoo-css={TWIKOO_CSS_URL}
  data-twikoo-sri={TWIKOO_SRI}
  data-lang-tag={langTag}
  data-comment-id={commentId ?? ""}
  data-comment-path={commentPath ?? ""}
  data-comment-loading={commentLoadingMessage}
  data-twikoo-observer-offset={String(twikooObserverOffset)}
  class="min-h-[140px]"
>
  <div
    data-comment-trigger-ui
    class="my-4 flex flex-col items-center gap-2 text-center text-sm text-muted"
  >
    <button
      type="button"
      data-comment-load-trigger
      class="rounded-md border border-border bg-muted/50 px-4 py-2 text-foreground transition-colors hover:bg-muted"
      aria-label={commentLoadTriggerLabel}
    >
      {commentLoadTriggerLabel}
    </button>
    <p>{commentAutoLoadHint}</p>
  </div>
</div>

<script src="@/scripts/comment-loader.ts"></script>
