---
// Mermaid client-side component - Event-driven theme switching
---

<script is:inline>
  let mermaidInstance = null;
  const mermaidDiagrams = new Map();

  // Load Mermaid library and render diagrams for the first time
  async function setupMermaid() {
    if (mermaidInstance) return; // Already initialized

    try {
      if (typeof window.mermaid !== 'undefined') {
        mermaidInstance = window.mermaid;
      } else {
        await loadMermaidScript();
        mermaidInstance = window.mermaid;
      }
      
      // Get initial theme and render diagrams
      const initialTheme = getInitialTheme();
      await renderAllDiagrams(initialTheme);
      
      // Listen for theme changes after mermaid is loaded
      document.addEventListener('theme-changed', (e) => handleThemeChange(e.detail.theme));
      
      console.log('Mermaid setup completed with theme:', initialTheme);
    } catch (error) {
      console.error('Failed to load local Mermaid library:', error);
      showMermaidError('load');
    }
  }

  function getInitialTheme() {
    // Check localStorage first
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    // Check if dark class is present
    if (document.documentElement.classList.contains('dark')) {
      return 'dark';
    }
    // Check media query
    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
      return 'dark';
    }
    return 'light';
  }

  function loadMermaidScript() {
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = '/mermaid.min.js';
      script.onload = resolve;
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  function getMermaidConfig(theme) {
    const isDark = theme === 'dark';
    const darkThemeConfig = {
      background: '#0f172a',
      primaryColor: '#1e293b',
      secondaryColor: '#334155',
      primaryTextColor: '#ffffff',
      secondaryTextColor: '#f1f5f9',
      primaryBorderColor: '#60a5fa',
      lineColor: '#60a5fa',
      clusterBkg: '#334155',
      titleColor: '#ffffff',
    };
    const lightThemeConfig = {
      background: '#ffffff',
      primaryColor: '#f5fafc',
      secondaryColor: '#ffffff',
      primaryTextColor: '#282728',
      secondaryTextColor: '#475569',
      primaryBorderColor: '#7aa4c7',
      lineColor: '#7aa4c7',
    };
    
    return {
      startOnLoad: false,
      theme: isDark ? 'dark' : 'base',
      themeVariables: {
        darkMode: isDark,
        fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif',
        ...(isDark ? darkThemeConfig : lightThemeConfig)
      }
    };
  }

  async function renderAllDiagrams(theme) {
    if (!mermaidInstance) return;

    console.log(`Rendering all diagrams with theme: ${theme}`);
    mermaidInstance.initialize(getMermaidConfig(theme));
    
    for (const [element, code] of mermaidDiagrams.entries()) {
      try {
        const id = `mermaid-${Math.random().toString(36).substring(2, 9)}`;
        const { svg } = await mermaidInstance.render(id, code);
        element.innerHTML = svg;
        console.log('Successfully rendered diagram with theme:', theme);
      } catch (err) {
        console.error('Mermaid render error:', err);
        showMermaidError('render', element, err);
      }
    }
  }

  function handleThemeChange(theme) {
    console.log('Theme change event received:', theme);
    if (!mermaidInstance) {
      console.log('Mermaid not ready, skipping theme change handling.');
      return;
    }
    renderAllDiagrams(theme);
  }

  function collectDiagrams() {
    const codeBlocks = document.querySelectorAll('pre > code.language-mermaid, code.language-mermaid');
    console.log('Found mermaid blocks:', codeBlocks.length);
    
    codeBlocks.forEach((codeElement, i) => {
      const code = codeElement.textContent;
      if (code && code.trim()) {
        const wrapper = document.createElement('div');
        wrapper.className = 'mermaid-diagram my-6 flex justify-center overflow-x-auto';
        wrapper.setAttribute('data-mermaid-id', i);
        
        const preElement = codeElement.parentElement;
        if (preElement?.parentNode) {
          preElement.parentNode.replaceChild(wrapper, preElement);
        } else if (codeElement.parentNode) {
          codeElement.parentNode.replaceChild(wrapper, codeElement);
        }
        
        mermaidDiagrams.set(wrapper, code.trim());
        console.log('Collected diagram', i, ':', code.trim().substring(0, 50) + '...');
      }
    });
  }
  
  function showMermaidError(type, element, error) {
    const isDark = document.documentElement.classList.contains('dark');
    const [bgColor, borderColor, textColor, detailsColor] = isDark
      ? ['bg-red-900/20', 'border-red-800', 'text-red-200', 'text-red-300']
      : ['bg-red-50', 'border-red-200', 'text-red-800', 'text-red-600'];

    const message = type === 'load' ? 'Mermaid 库加载失败' : 'Mermaid 图表渲染失败';
    const details = type === 'load' 
      ? '无法加载本地图表渲染库，请联系管理员。'
      : `<details class="mt-2"><summary class="${detailsColor} cursor-pointer">查看错误详情</summary><pre class="text-sm mt-2 whitespace-pre-wrap">${String(error)}</pre></details>`;
      
    const errorHTML = `<div class="${bgColor} border ${borderColor} rounded-lg p-4 my-4"><p class="${textColor} font-medium">${message}</p>${details}</div>`;

    if (element) {
      element.innerHTML = errorHTML;
    } else {
      // If it's a load error, replace all diagram holders
      for (const [el] of mermaidDiagrams.entries()) {
        el.innerHTML = errorHTML;
      }
    }
  }

  // Initial setup
  document.addEventListener('DOMContentLoaded', () => {
    collectDiagrams();
    if (mermaidDiagrams.size > 0) {
      setupMermaid();
    }
  });
</script> 