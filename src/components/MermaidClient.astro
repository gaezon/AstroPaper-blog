---
// Mermaid client-side component - Event-driven theme switching
---

<script is:inline>
  // 单例与状态
  let mermaidInstance = null;
  const mermaidDiagrams = new Map(); // Map<HTMLElement, string>
  const renderedElements = new Set(); // Set<HTMLElement>
  let intersectionObserver = null;
  let themeDebounceTimer = null;

  function isAlreadyInitialized() {
    try {
      return Boolean(window.__MERMAID_CLIENT_INITIALIZED__);
    } catch {
      return false;
    }
  }

  function markInitialized() {
    try {
      window.__MERMAID_CLIENT_INITIALIZED__ = true;
    } catch {
      /* no-op */
    }
  }

  // 加载 Mermaid 并启用懒加载渲染
  async function setupMermaid() {
    if (mermaidInstance) return;

    try {
      if (typeof window.mermaid !== "undefined") {
        mermaidInstance = window.mermaid;
      } else {
        await loadMermaidScript();
        mermaidInstance = window.mermaid;
      }

      const initialTheme = getInitialTheme();
      initializeMermaid(initialTheme);
      setupIntersectionObserver();

      // 监听站内主题切换事件
      document.addEventListener("theme-changed", e => {
        const nextTheme =
          e && e.detail && e.detail.theme ? e.detail.theme : getInitialTheme();
        handleThemeChange(nextTheme);
      });

      // 监听系统主题变化（补充处理）
      if (window.matchMedia) {
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        if (media && typeof media.addEventListener === "function") {
          media.addEventListener("change", evt =>
            handleThemeChange(evt.matches ? "dark" : "light")
          );
        }
      }
    } catch {
      showMermaidError("load");
    }
  }

  function getInitialTheme() {
    if (typeof localStorage !== "undefined") {
      const stored = localStorage.getItem("theme");
      if (stored) return stored;
    }
    if (document.documentElement.classList.contains("dark")) return "dark";
    if (
      window.matchMedia &&
      window.matchMedia("(prefers-color-scheme: dark)").matches
    )
      return "dark";
    return "light";
  }

  function loadMermaidScript() {
    return new Promise((resolve, reject) => {
      const existing = document.querySelector('script[src="/mermaid.min.js"]');
      if (existing) {
        if (typeof window.mermaid !== "undefined") resolve();
        existing.addEventListener("load", resolve, { once: true });
        existing.addEventListener("error", reject, { once: true });
        return;
      }
      const script = document.createElement("script");
      script.src = "/mermaid.min.js";
      script.async = true;
      script.onload = resolve;
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  function getMermaidConfig(theme) {
    const isDark = theme === "dark";
    const darkThemeConfig = {
      background: "#0f172a",
      primaryColor: "#1e293b",
      secondaryColor: "#334155",
      primaryTextColor: "#ffffff",
      secondaryTextColor: "#f1f5f9",
      primaryBorderColor: "#60a5fa",
      lineColor: "#60a5fa",
      clusterBkg: "#334155",
      titleColor: "#ffffff",
    };
    const lightThemeConfig = {
      background: "#ffffff",
      primaryColor: "#f5fafc",
      secondaryColor: "#ffffff",
      primaryTextColor: "#282728",
      secondaryTextColor: "#475569",
      primaryBorderColor: "#7aa4c7",
      lineColor: "#7aa4c7",
    };

    return {
      startOnLoad: false,
      securityLevel: "strict",
      htmlLabels: false,
      theme: isDark ? "dark" : "base",
      themeVariables: {
        darkMode: isDark,
        fontFamily:
          'Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif',
        ...(isDark ? darkThemeConfig : lightThemeConfig),
      },
    };
  }

  function initializeMermaid(theme) {
    if (!mermaidInstance) return;
    mermaidInstance.initialize(getMermaidConfig(theme));
  }

  async function renderDiagram(element, code) {
    if (!mermaidInstance) return;
    try {
      const id = `mermaid-${Math.random().toString(36).slice(2, 10)}`;
      const normalized = code
        .replace(/&lt;br\s*\/?&gt;/gi, "\n")
        .replace(/<br\s*\/?>(\s*)/gi, "\n$1");
      const result = await mermaidInstance.render(id, normalized);
      element.innerHTML = result.svg;
      element.setAttribute("role", "img");
      if (!element.getAttribute("aria-label"))
        element.setAttribute("aria-label", "Mermaid 图表");
      renderedElements.add(element);
    } catch (err) {
      showMermaidError("render", element, err);
    }
  }

  function setupIntersectionObserver() {
    const options = { root: null, rootMargin: "200px", threshold: 0.01 };
    if (!intersectionObserver) {
      intersectionObserver = new IntersectionObserver(entries => {
        const currentTheme = getInitialTheme();
        initializeMermaid(currentTheme);
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const element = entry.target;
          const code = mermaidDiagrams.get(element);
          if (code) {
            renderDiagram(element, code);
          }
          if (intersectionObserver) intersectionObserver.unobserve(element);
        });
      }, options);
    }

    // 开始观测（包含后来新增的图表容器）
    for (const [element] of mermaidDiagrams.entries()) {
      intersectionObserver.observe(element);
    }
  }

  function handleThemeChange(theme) {
    // 去抖：避免短时间多次重绘
    if (themeDebounceTimer) window.clearTimeout(themeDebounceTimer);
    themeDebounceTimer = window.setTimeout(() => {
      initializeMermaid(theme);
      // 只重绘已渲染过的图表，其余保持懒加载策略
      for (const element of renderedElements.values()) {
        const code = mermaidDiagrams.get(element);
        if (code) renderDiagram(element, code);
      }
    }, 120);
  }

  function collectDiagrams() {
    const codeBlocks = document.querySelectorAll(
      "pre > code.language-mermaid, code.language-mermaid"
    );
    let idx = 0;
    codeBlocks.forEach(codeElement => {
      const code = codeElement.textContent;
      if (code && code.trim()) {
        const wrapper = document.createElement("div");
        wrapper.className =
          "mermaid-diagram my-6 flex justify-center overflow-x-auto";
        wrapper.setAttribute("data-mermaid-id", String(idx++));

        const preElement = codeElement.parentElement;
        if (preElement?.parentNode) {
          preElement.parentNode.replaceChild(wrapper, preElement);
        } else if (codeElement.parentNode) {
          codeElement.parentNode.replaceChild(wrapper, codeElement);
        }

        mermaidDiagrams.set(wrapper, code.trim());
      }
    });
  }

  function showMermaidError(type, element, error) {
    const isDark = document.documentElement.classList.contains("dark");
    const container = document.createElement("div");
    container.className = `${isDark ? "bg-red-900/20 border-red-800 text-red-200" : "bg-red-50 border-red-200 text-red-800"} border rounded-lg p-4 my-4`;

    const title = document.createElement("p");
    title.className = "font-medium";
    title.textContent =
      type === "load" ? "Mermaid 库加载失败" : "Mermaid 图表渲染失败";
    container.appendChild(title);

    if (type !== "load" && error) {
      const details = document.createElement("details");
      details.className = "mt-2";
      const summary = document.createElement("summary");
      summary.className = isDark
        ? "text-red-300 cursor-pointer"
        : "text-red-600 cursor-pointer";
      summary.textContent = "查看错误详情";
      const pre = document.createElement("pre");
      pre.className = "text-sm mt-2 whitespace-pre-wrap";
      pre.textContent = String(error);
      details.appendChild(summary);
      details.appendChild(pre);
      container.appendChild(details);
    } else if (type === "load") {
      const info = document.createElement("p");
      info.className = isDark ? "text-red-300" : "text-red-600";
      info.textContent = "无法加载本地图表渲染库，请联系管理员。";
      container.appendChild(info);
    }

    if (element) {
      element.innerHTML = "";
      element.appendChild(container);
    } else {
      for (const [el] of mermaidDiagrams.entries()) {
        el.innerHTML = "";
        el.appendChild(container.cloneNode(true));
      }
    }
  }

  // 初始化
  document.addEventListener("DOMContentLoaded", () => {
    if (isAlreadyInitialized()) return;
    collectDiagrams();
    if (mermaidDiagrams.size > 0) {
      setupMermaid();
      markInitialized();
    }
  });

  // 处理客户端路由与局部页面替换
  function handleAstroPageLoad() {
    collectDiagrams();
    if (mermaidDiagrams.size > 0) {
      setupMermaid(); // 幂等：不会重复初始化，但会观测新加入的图表
    }
  }
  document.addEventListener("astro:page-load", handleAstroPageLoad);
  document.addEventListener("astro:after-swap", handleAstroPageLoad);
  if (document.readyState !== "loading") {
    // 若脚本注入时文档已解析完成，立即执行一次以避免错过 DOMContentLoaded
    handleAstroPageLoad();
  }
</script>
