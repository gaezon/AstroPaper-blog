---
// Mermaid client-side component - using local mermaid.min.js with theme switching
---

<script is:inline>
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      // Check if mermaid is already loaded globally
      if (typeof window.mermaid === 'undefined') {
        // Load mermaid from local public directory
        const script = document.createElement('script');
        script.src = '/mermaid.min.js';
        script.onload = initializeMermaid;
        script.onerror = () => {
          console.error('Failed to load local Mermaid library');
          showMermaidError();
        };
        document.head.appendChild(script);
      } else {
        initializeMermaid();
      }
    } catch (error) {
      console.error('Error setting up Mermaid:', error);
      showMermaidError();
    }
  });

  function getCurrentTheme() {
    // Check if we're in dark mode
    return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
  }

  function getMermaidConfig(theme) {
    if (theme === 'dark') {
      return {
        startOnLoad: false,
        theme: 'dark',
        themeVariables: {
          darkMode: true,
          primaryColor: '#4f46e5',
          primaryTextColor: '#e5e7eb',
          primaryBorderColor: '#6366f1',
          lineColor: '#6366f1',
          secondaryColor: '#1f2937',
          secondaryBorderColor: '#374151',
          secondaryTextColor: '#d1d5db',
          tertiaryColor: '#111827',
          background: '#111827',
          mainBkg: '#1f2937',
          secondBkg: '#374151',
          fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif'
        }
      };
    } else {
      return {
        startOnLoad: false,
        theme: 'base',
        themeVariables: {
          darkMode: false,
          primaryColor: '#f5fafc',
          primaryTextColor: '#282728',
          primaryBorderColor: '#7aa4c7',
          lineColor: '#7aa4c7',
          secondaryBorderColor: '#cdd6dd',
          secondaryColor: '#ffffff',
          tertiaryColor: '#eef3f6',
          background: '#ffffff',
          mainBkg: '#ffffff',
          secondBkg: '#f9fafb',
          fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif'
        }
      };
    }
  }

  function initializeMermaid() {
    try {
      const mermaid = window.mermaid;
      const currentTheme = getCurrentTheme();
      const config = getMermaidConfig(currentTheme);
      
      mermaid.initialize(config);

      // Find all mermaid code blocks
      const codeBlocks = document.querySelectorAll('pre > code.language-mermaid, code.language-mermaid');
      
      console.log('Found mermaid blocks:', codeBlocks.length);
      console.log('Current theme:', currentTheme);
      
      codeBlocks.forEach(async (codeElement, i) => {
        const preElement = codeElement.parentElement;
        const code = codeElement.textContent;
        
        console.log('Processing mermaid code:', code);
        
        if (code && code.trim()) {
          try {
            const id = 'mermaid-diagram-' + i;
            const result = await mermaid.render(id, code.trim());
            
            // Create wrapper div with Tailwind classes
            const wrapper = document.createElement('div');
            wrapper.className = 'mermaid-diagram my-6 flex justify-center overflow-x-auto';
            wrapper.innerHTML = result.svg;
            
            // Replace the pre element with the rendered SVG
            if (preElement && preElement.parentNode) {
              preElement.parentNode.replaceChild(wrapper, preElement);
            } else if (codeElement.parentNode) {
              codeElement.parentNode.replaceChild(wrapper, codeElement);
            }
            
            console.log('Successfully rendered mermaid diagram');
          } catch (err) {
            console.error('Mermaid render error:', err);
            showRenderError(preElement || codeElement, err);
          }
        }
      });

      // Listen for theme changes and re-render diagrams
      setupThemeListener(mermaid);
    } catch (initError) {
      console.error('Failed to initialize Mermaid:', initError);
      showMermaidError();
    }
  }

  function setupThemeListener(mermaid) {
    // Watch for theme changes using MutationObserver
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
          const currentTheme = getCurrentTheme();
          console.log('Theme changed to:', currentTheme);
          
          // Re-render all mermaid diagrams with new theme
          setTimeout(() => {
            reRenderDiagrams(mermaid, currentTheme);
          }, 100);
        }
      });
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class']
    });
  }

  function reRenderDiagrams(mermaid, theme) {
    try {
      // Update mermaid configuration for new theme
      const config = getMermaidConfig(theme);
      mermaid.initialize(config);

      // Find all existing mermaid diagrams
      const diagrams = document.querySelectorAll('.mermaid-diagram');
      
      diagrams.forEach(async (diagram, i) => {
        // We need the original code, but since it's already rendered, 
        // we'll skip re-rendering for now to avoid complexity
        // In a future version, we could store the original code in data attributes
        console.log('Theme changed - diagram', i, 'would need re-rendering');
      });
    } catch (error) {
      console.error('Error re-rendering diagrams:', error);
    }
  }

  function showRenderError(element, err) {
    const errorDiv = document.createElement('div');
    errorDiv.className = 'bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg p-4 my-4';
    errorDiv.innerHTML = 
      '<p class="text-red-800 dark:text-red-200 font-medium">Mermaid 图表渲染失败</p>' +
      '<details class="mt-2">' +
      '<summary class="text-red-600 dark:text-red-300 cursor-pointer">查看错误详情</summary>' +
      '<pre class="text-red-600 dark:text-red-300 text-sm mt-2 whitespace-pre-wrap">' + String(err) + '</pre>' +
      '</details>';
    
    if (element.parentNode) {
      element.parentNode.replaceChild(errorDiv, element);
    }
  }

  function showMermaidError() {
    // Show global error for library loading failure
    const codeBlocks = document.querySelectorAll('pre > code.language-mermaid, code.language-mermaid');
    codeBlocks.forEach(codeElement => {
      const errorDiv = document.createElement('div');
      errorDiv.className = 'bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4 my-4';
      errorDiv.innerHTML = 
        '<p class="text-yellow-800 dark:text-yellow-200 font-medium">⚠️ Mermaid 库加载失败</p>' +
        '<p class="text-yellow-700 dark:text-yellow-300 text-sm mt-2">无法加载本地图表渲染库，请联系管理员。</p>';
      
      const preElement = codeElement.parentElement;
      if (preElement && preElement.parentNode) {
        preElement.parentNode.replaceChild(errorDiv, preElement);
      } else if (codeElement.parentNode) {
        codeElement.parentNode.replaceChild(errorDiv, codeElement);
      }
    });
  }
</script> 