---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import { getCurrentLocale, t } from "@/i18n/utils";
import { normalizePathWithLocale } from "@/utils/url";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;

// I18n variables
const currentLocale = getCurrentLocale(Astro);
const localePrefix = currentLocale === "zh-CN" ? "" : `/${currentLocale}`;
const localeUrl = (path: string) => normalizePathWithLocale(path, localePrefix);
const tr = (key: string, params?: Record<string, string | number>) =>
  t(Astro, key, params);
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div class="flex flex-col items-center py-6 sm:py-4">
    <Socials centered />
    <div class="copyright-wrapper mt-4 text-center">
      <span
        >{
          tr("footer.copyright", { year: currentYear, author: "Gaazeon" })
        }</span
      >
      <span class="separator">&nbsp;|&nbsp;</span>
      <a
        class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
        href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
        target="_blank"
        rel="noopener noreferrer"
      >
        CC BY-NC-SA 4.0
      </a>
    </div>
    <div
      class="legal-links mt-2 flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm"
    >
      <a
        class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
        href={localeUrl("/privacy-policy")}
      >
        {tr("ui.privacyPolicy")}
      </a>
      <a
        class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
        href={localeUrl("/cookie-policy")}
      >
        {tr("ui.cookiePolicy")}
      </a>
      <a
        class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
        href="#cookie-settings"
        data-cookie-settings-trigger
      >
        {tr("ui.cookie.settings")}
      </a>
      <a
        class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
        href={localeUrl("/terms-of-service")}
      >
        {tr("ui.termsOfService")}
      </a>
      <a
        class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
        href={localeUrl("/contact")}
      >
        {tr("ui.contact")}
      </a>
    </div>
  </div>
</footer>
