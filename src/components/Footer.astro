---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div class="flex flex-col items-center py-6 sm:py-4">
    <Socials centered />
    <div class="copyright-wrapper mt-4 text-center">
      <span> Copyright &#169; {currentYear}</span>
      <span class="separator">&nbsp;|&nbsp;</span>
      <a
        class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
        href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
        target="_blank"
        rel="noopener noreferrer"
      >
        CC BY-NC-SA 4.0
      </a>
    </div>
    <div
      class="legal-links mt-2 flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm"
    >
      <a
        class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
        href="/privacy-policy"
      >
        隐私政策
      </a>
      <a
        class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
        href="/cookie-policy"
      >
        Cookie 政策
      </a>
      <a
        class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
        href="/terms-of-service"
      >
        服务条款
      </a>
      <a
        class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
        href="/contact"
      >
        联系我们
      </a>
    </div>
  </div>
</footer>
