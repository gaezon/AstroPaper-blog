---
import Socials from "./Socials.astro";
import { GITHUB_REPOSITORY_URL } from "@/config";
import { getCurrentLocale, t } from "@/i18n/utils";
import { normalizePathWithLocale } from "@/utils/url";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;

// I18n variables
const currentLocale = getCurrentLocale(Astro);
const localePrefix = currentLocale === "zh-CN" ? "" : `/${currentLocale}`;
const localeUrl = (path: string) => normalizePathWithLocale(path, localePrefix);
const tr = (key: string, params?: Record<string, string | number>) =>
  t(Astro, key, params);
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <div class="mx-auto max-w-app border-t border-border"></div>
  <div
    class="flex flex-col items-center gap-5 py-8 text-center text-sm text-foreground/75 sm:py-6"
  >
    <div class="flex flex-col items-center gap-4">
      <p class="max-w-2xl leading-relaxed">
        <span>
          {tr("footer.builtWithPrefix")}
          <a
            class="hover:text-skin-accent font-medium text-foreground underline decoration-dashed underline-offset-4"
            href="https://astro.build/"
            target="_blank"
            rel="noopener noreferrer">Astro</a
          >
          {tr("footer.builtWithSuffix")}
        </span>
        <span class="mx-2 text-foreground/40" aria-hidden="true">|</span>
        <span>
          {tr("footer.themeCreditPrefix")}
          <a
            class="hover:text-skin-accent font-medium text-foreground underline decoration-dashed underline-offset-4"
            href="https://github.com/satnaing/astro-paper"
            target="_blank"
            rel="noopener noreferrer">AstroPaper</a
          >
          {tr("footer.themeCreditSuffix")}
        </span>
        <span class="mx-2 text-foreground/40" aria-hidden="true">|</span>
        <span>{tr("footer.openSourceThanks")}</span>
      </p>
      <Socials centered />
    </div>
    <div class="grid justify-items-center gap-2 text-xs">
      <span>
        {tr("footer.copyright", { year: currentYear, author: "Gaazeon" })}
      </span>
      <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2">
        <a
          class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
          target="_blank"
          rel="noopener noreferrer"
        >
          CC BY-NC-SA 4.0
        </a>
        <span class="text-foreground/35" aria-hidden="true">|</span>
        <a
          class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
          href={localeUrl("/contact")}
        >
          {tr("ui.contact")}
        </a>
        <span class="text-foreground/35" aria-hidden="true">|</span>
        <a
          class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
          href={localeUrl("/privacy")}
        >
          {tr("ui.privacyPolicy")}
        </a>
        <span class="text-foreground/35" aria-hidden="true">|</span>
        <a
          class="hover:text-skin-accent underline decoration-dashed underline-offset-4"
          href={GITHUB_REPOSITORY_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          {tr("ui.sourceCode")}
        </a>
      </div>
    </div>
  </div>
</footer>
