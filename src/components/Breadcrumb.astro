---
import { getCurrentLocale, t } from "@/i18n/utils";

// Remove current url path and remove trailing slash if exists
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
let breadcrumbList = currentUrlPath.split("/").slice(1);

// Remove language code from breadcrumb (e.g., "en")
const currentLocale = getCurrentLocale(Astro);
const supportedLocales = ["zh-CN", "en"];
if (breadcrumbList[0] && supportedLocales.includes(breadcrumbList[0])) {
  breadcrumbList.shift();
}

const tr = (key: string, params?: Record<string, string | number>) => t(Astro, key, params);

// Translation map for common breadcrumb terms
const translateBreadcrumbTerm = (term: string) => {
  const translations: Record<string, string> = {
    posts: tr("nav.blog"),
    tags: tr("nav.tags"),
    about: tr("nav.about"),
    contact: tr("ui.contact"),
    archives: tr("nav.archives"),
    search: tr("nav.search"),
    privacy: tr("ui.privacyPolicy"),
    cookie: tr("ui.cookiePolicy"),
    terms: tr("ui.termsOfService"),
  };
  return translations[term] || term;
};

// if breadcrumb is Home > Posts > 1 <etc>
// replace Posts with Posts (page number)
if (breadcrumbList[0] === "posts") {
  const pageNum = breadcrumbList[1] ? parseInt(breadcrumbList[1]) : 1;
  if (isNaN(pageNum)) {
    breadcrumbList.splice(0, 1, translateBreadcrumbTerm("posts"));
  } else {
    breadcrumbList.splice(0, 2, `${translateBreadcrumbTerm("posts")} ${tr("pagination.pageOnly", { page: pageNum })}`);
  }
}

// if breadcrumb is Home > Tags > [tag] > [page] <etc>
// replace [tag] > [page] with [tag] (page number)
if (breadcrumbList[0] === "tags" && !isNaN(Number(breadcrumbList[2]))) {
  const pageNum = parseInt(breadcrumbList[2]);
  const tagPageText = pageNum === 1 ? breadcrumbList[1] : `${breadcrumbList[1]} ${tr("pagination.page", { page: pageNum })}`;
  breadcrumbList.splice(1, 3, tagPageText);
}

// Translate breadcrumb terms
breadcrumbList = breadcrumbList.map(term => translateBreadcrumbTerm(term));
---

<nav class="mx-auto mt-8 mb-1 w-full max-w-app px-4" aria-label="breadcrumb">
  <ul
    class="font-light [&>li]:inline [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li>
      <a href={currentLocale === "zh-CN" ? "/" : "/en/"} class="opacity-80">{tr("nav.home")}</a>
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) =>
        index + 1 === breadcrumbList.length ? (
          <li>
            <span
              class:list={["capitalize opacity-75", { lowercase: index > 0 }]}
              aria-current="page"
            >
              {/* make the last part lowercase in Home > Tags > some-tag */}
              {decodeURIComponent(breadcrumb)}
            </span>
          </li>
        ) : (
          <li>
            <a
              href={
                currentLocale === "zh-CN"
                  ? `/${breadcrumb}/`
                  : `/en/${breadcrumb}/`
              }
              class="capitalize opacity-70"
            >
              {breadcrumb}
            </a>
            <span aria-hidden="true">&raquo;</span>
          </li>
        )
      )
    }
  </ul>
</nav>
