---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import type { BlogPaginatedPage } from "@/types/pagination";
import LinkButton from "./LinkButton.astro";
import { t } from "@/i18n/utils";

export interface Props {
  page: BlogPaginatedPage;
}

const { page } = Astro.props;
const tr = (key: string, params?: Record<string, string | number>) =>
  t(Astro, key, params);
const prevUrl = page.url.prev;
const nextUrl = page.url.next;
---

{
  page.lastPage > 1 && (
    <nav class="mt-auto mb-8 flex justify-center" aria-label="Pagination">
      <LinkButton
        disabled={!prevUrl}
        href={prevUrl}
        class:list={["me-4 select-none", { "opacity-50": !prevUrl }]}
        aria-label={tr("pagination.previous")}
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        {tr("pagination.prev")}
      </LinkButton>
      {tr("pagination.page", {
        current: page.currentPage,
        total: page.lastPage,
      })}
      <LinkButton
        disabled={!nextUrl}
        href={nextUrl}
        class:list={["ms-4 select-none", { "opacity-50": !nextUrl }]}
        aria-label={tr("pagination.next")}
      >
        {tr("pagination.next")}
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
