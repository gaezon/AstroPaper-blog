---
import { getCurrentLocale, getLocaleSwitchUrl, getAvailableLocales, t } from "@/i18n/utils";

interface Props {
  class?: string;
  variant?: "dropdown" | "toggle" | "compact";
  override?: Record<string, string | undefined>;
}

const { class: className = "", variant = "dropdown", override } = Astro.props;

const currentLocale = getCurrentLocale(Astro);
const availableLocales = getAvailableLocales();
const currentLocaleInfo = availableLocales.find(l => l.code === currentLocale);
const tr = (key: string, params?: Record<string, string | number>) => t(Astro, key, params);

// 获取语言代码的简短显示
const getShortLabel = (code: string) => {
  return code === "zh-CN" ? "中" : "EN";
};
---

{variant === "dropdown" ? (
  <div class={`language-switcher-dropdown ${className}`}>
    <button
      type="button"
      class="lang-dropdown-btn focus-outline"
      aria-label={tr("language.selectLanguage")}
      aria-expanded="false"
      data-dropdown-toggle
    >
      <svg
        class="globe-icon"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width={2}
          d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
        />
      </svg>
      <span class="current-lang">{currentLocaleInfo?.profile.label || currentLocaleInfo?.name}</span>
      <svg
        class="chevron-icon"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width={2}
          d="M19 9l-7 7-7-7"
        />
      </svg>
    </button>

    <div class="lang-dropdown-menu" role="menu">
      {availableLocales.map(locale => (
        <a
          href={override?.[locale.code] ?? getLocaleSwitchUrl(Astro, locale.code)}
          class={`lang-dropdown-item ${locale.code === currentLocale ? "active" : ""}`}
          lang={locale.profile.langTag}
          hreflang={locale.code}
          role="menuitem"
          data-astro-reload
        >
          <span class="lang-name">{locale.name}</span>
          {locale.code === currentLocale && (
            <svg
              class="check-icon"
              fill="currentColor"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"
              />
            </svg>
          )}
        </a>
      ))}
    </div>
  </div>
) : variant === "compact" ? (
  <div class={`language-switcher-compact ${className}`}>
    <div class="lang-compact-wrapper">
      <svg
        class="globe-icon-compact"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width={2}
          d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
        />
      </svg>
      {availableLocales.map((locale, index) => (
        <>
          <a
            href={override?.[locale.code] ?? getLocaleSwitchUrl(Astro, locale.code)}
            class={`lang-compact-btn ${locale.code === currentLocale ? "active" : ""}`}
            lang={locale.profile.langTag}
            hreflang={locale.code}
            aria-label={locale.name}
            title={locale.name}
            data-astro-reload
          >
            {getShortLabel(locale.code)}
          </a>
          {index < availableLocales.length - 1 && <span class="lang-separator">/</span>}
        </>
      ))}
    </div>
  </div>
) : (
  <div class={`language-switcher-toggle ${className}`}>
    {availableLocales.map(locale => (
      <a
        href={override?.[locale.code] ?? getLocaleSwitchUrl(Astro, locale.code)}
        class={`lang-toggle-btn ${locale.code === currentLocale ? "active" : ""}`}
        lang={locale.profile.langTag}
        hreflang={locale.code}
        aria-label={locale.name}
        title={locale.name}
        data-astro-reload
      >
        {locale.profile.label || locale.name}
      </a>
    ))}
  </div>
)}

<style>
  /* ========== 下拉菜单样式 - Liquid Glass 设计 ========== */
  .language-switcher-dropdown {
    position: relative;
    display: inline-block;
  }

  .lang-dropdown-btn {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.875rem;
    
    /* Liquid Glass 样式 */
    background: hsl(var(--background) / 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid hsl(var(--border) / 0.5);
    border-radius: 0.625rem;
    
    font-size: 0.875rem;
    font-weight: 500;
    color: hsl(var(--foreground) / 0.85);
    cursor: pointer;
    
    box-shadow: 
      0 1px 2px hsl(var(--foreground) / 0.04),
      0 2px 8px hsl(var(--foreground) / 0.06),
      inset 0 1px 0 hsl(var(--background) / 0.5);
    
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    min-width: 120px;
  }

  .lang-dropdown-btn:hover {
    background: hsl(var(--background) / 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-color: hsl(var(--accent) / 0.6);
    box-shadow: 
      0 2px 4px hsl(var(--foreground) / 0.06),
      0 8px 16px hsl(var(--foreground) / 0.1),
      inset 0 1px 0 hsl(var(--background) / 0.7);
    transform: translateY(-1px);
  }

  .globe-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    color: hsl(var(--accent));
    opacity: 0.75;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    filter: drop-shadow(0 0 4px hsl(var(--accent) / 0.2));
  }

  .lang-dropdown-btn:hover .globe-icon {
    opacity: 0.95;
    transform: rotate(20deg) scale(1.05);
    filter: drop-shadow(0 0 8px hsl(var(--accent) / 0.3));
  }

  .current-lang {
    white-space: nowrap;
    flex: 1;
  }

  .chevron-icon {
    width: 1rem;
    height: 1rem;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
    opacity: 0.6;
  }

  .language-switcher-dropdown[data-open="true"] .chevron-icon {
    transform: rotate(180deg);
    opacity: 0.9;
  }

  .lang-dropdown-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 50;
    min-width: 100%;
    padding: 0.5rem;
    
    /* Liquid Glass 菜单 */
    background: hsl(var(--background) / 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid hsl(var(--border) / 0.6);
    border-radius: 0.75rem;
    
    box-shadow: 
      0 4px 12px hsl(var(--foreground) / 0.08),
      0 12px 32px hsl(var(--foreground) / 0.12),
      0 0 0 1px hsl(var(--background) / 0.1),
      inset 0 1px 0 hsl(var(--background) / 0.8);
    
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.5rem) scale(0.95);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .language-switcher-dropdown[data-open="true"] .lang-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .lang-dropdown-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    color: hsl(var(--foreground) / 0.85);
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(2px);
    position: relative;
    overflow: hidden;
  }

  .lang-dropdown-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background: linear-gradient(90deg, 
      hsl(var(--accent) / 0.15) 0%, 
      hsl(var(--accent) / 0.05) 100%);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .lang-dropdown-item:hover::before {
    width: 100%;
  }

  .lang-dropdown-item:hover {
    background: hsl(var(--muted) / 0.5);
    backdrop-filter: blur(8px);
    color: hsl(var(--foreground));
    transform: translateX(3px);
  }

  .lang-dropdown-item.active {
    background: hsl(var(--accent) / 0.9);
    backdrop-filter: blur(12px);
    color: hsl(var(--accent-foreground));
    font-weight: 600;
    box-shadow: 
      0 2px 8px hsl(var(--accent) / 0.25),
      0 0 16px hsl(var(--accent) / 0.15),
      inset 0 1px 0 hsl(var(--accent-foreground) / 0.15);
  }

  .lang-dropdown-item.active::before {
    display: none;
  }

  .lang-dropdown-item.active:hover {
    background: hsl(var(--accent));
    transform: translateX(4px);
  }

  .lang-name {
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .check-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    filter: drop-shadow(0 0 4px hsl(var(--accent-foreground) / 0.3));
    position: relative;
    z-index: 1;
  }

  /* ========== 紧凑样式 - Liquid Glass 设计 ========== */
  .language-switcher-compact {
    display: inline-flex;
    width: 100%;
  }

  .lang-compact-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.625rem 1rem;
    
    /* Liquid Glass 核心样式 */
    background: hsl(var(--background) / 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid hsl(var(--border) / 0.5);
    border-radius: 0.75rem;
    
    /* 多层阴影营造深度感 */
    box-shadow: 
      0 1px 2px hsl(var(--foreground) / 0.04),
      0 4px 12px hsl(var(--foreground) / 0.06),
      inset 0 1px 0 hsl(var(--background) / 0.8);
    
    font-size: 0.875rem;
    width: 100%;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .lang-compact-wrapper:hover {
    background: hsl(var(--background) / 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-color: hsl(var(--border) / 0.7);
    
    /* 悬停时增强阴影 */
    box-shadow: 
      0 2px 4px hsl(var(--foreground) / 0.06),
      0 8px 24px hsl(var(--foreground) / 0.1),
      inset 0 1px 0 hsl(var(--background) / 0.9);
    
    transform: translateY(-2px);
  }

  .globe-icon-compact {
    width: 1.125rem;
    height: 1.125rem;
    color: hsl(var(--accent));
    opacity: 0.75;
    flex-shrink: 0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    filter: drop-shadow(0 0 4px hsl(var(--accent) / 0.2));
  }

  .lang-compact-wrapper:hover .globe-icon-compact {
    opacity: 0.95;
    transform: rotate(20deg) scale(1.05);
    filter: drop-shadow(0 0 8px hsl(var(--accent) / 0.3));
  }

  .lang-compact-btn {
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    font-weight: 500;
    color: hsl(var(--foreground) / 0.65);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: nowrap;
    min-width: 2.5rem;
    text-align: center;
    position: relative;
    backdrop-filter: blur(2px);
  }

  .lang-compact-btn:hover {
    color: hsl(var(--foreground) / 0.9);
    background: hsl(var(--muted) / 0.5);
    backdrop-filter: blur(4px);
    transform: scale(1.05);
    text-shadow: 0 0 8px hsl(var(--foreground) / 0.1);
  }

  .lang-compact-btn.active {
    color: hsl(var(--accent-foreground));
    font-weight: 600;
    background: hsl(var(--accent) / 0.9);
    backdrop-filter: blur(8px);
    
    /* 激活状态的发光效果 */
    box-shadow: 
      0 2px 8px hsl(var(--accent) / 0.3),
      0 0 20px hsl(var(--accent) / 0.15),
      inset 0 1px 0 hsl(var(--accent-foreground) / 0.2);
    
    text-shadow: 0 0 12px hsl(var(--accent-foreground) / 0.2);
  }

  .lang-compact-btn.active::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 0.625rem;
    border: 1.5px solid hsl(var(--accent) / 0.3);
    background: linear-gradient(135deg, 
      hsl(var(--accent) / 0.1) 0%, 
      transparent 50%, 
      hsl(var(--accent) / 0.05) 100%);
    pointer-events: none;
    animation: pulse-glow 2s ease-in-out infinite;
  }

  .lang-separator {
    color: hsl(var(--foreground) / 0.3);
    font-weight: 300;
    user-select: none;
    font-size: 0.75rem;
    opacity: 0.5;
  }

  /* ========== 切换按钮样式 - Liquid Glass 设计 ========== */
  .language-switcher-toggle {
    display: inline-flex;
    gap: 0.375rem;
    padding: 0.375rem;
    background: hsl(var(--background) / 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid hsl(var(--border) / 0.5);
    border-radius: 0.625rem;
    box-shadow: 
      0 1px 2px hsl(var(--foreground) / 0.04),
      0 2px 8px hsl(var(--foreground) / 0.06);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .language-switcher-toggle:hover {
    background: hsl(var(--background) / 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-color: hsl(var(--border) / 0.7);
    box-shadow: 
      0 2px 4px hsl(var(--foreground) / 0.06),
      0 4px 12px hsl(var(--foreground) / 0.08);
  }

  .lang-toggle-btn {
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: hsl(var(--foreground) / 0.65);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(2px);
  }

  .lang-toggle-btn:hover {
    color: hsl(var(--foreground) / 0.9);
    background: hsl(var(--muted) / 0.5);
    backdrop-filter: blur(4px);
    transform: translateY(-1px);
  }

  .lang-toggle-btn.active {
    background: hsl(var(--accent) / 0.9);
    backdrop-filter: blur(8px);
    color: hsl(var(--accent-foreground));
    font-weight: 600;
    box-shadow: 
      0 2px 8px hsl(var(--accent) / 0.3),
      0 0 16px hsl(var(--accent) / 0.15),
      inset 0 1px 0 hsl(var(--accent-foreground) / 0.2);
  }

  /* ========== 响应式设计 ========== */
  @media (max-width: 640px) {
    /* 移动端下拉菜单优化 */
    .lang-dropdown-btn {
      min-width: 100%;
      padding: 0.875rem 1.25rem;
    }

    .lang-dropdown-menu {
      left: 0;
      right: 0;
      min-width: 100%;
    }

    .lang-dropdown-btn .current-lang {
      display: inline; /* 移动端显示完整语言名 */
    }

    .globe-icon {
      width: 1.25rem;
      height: 1.25rem;
    }

    /* 移动端紧凑模式 - 保留用于其他场景 */
    .language-switcher-compact {
      width: 100%;
      max-width: 100%;
    }

    .lang-compact-wrapper {
      font-size: 0.9375rem;
      padding: 0.875rem 1.25rem;
      width: 100%;
      max-width: 100%;
      gap: 0.75rem;
      border-radius: 1rem;
      
      /* 增强移动端 Liquid Glass 效果 */
      background: linear-gradient(
        135deg, 
        hsl(var(--background) / 0.75) 0%, 
        hsl(var(--background) / 0.65) 100%
      );
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1.5px solid hsl(var(--border) / 0.4);
      
      box-shadow: 
        0 2px 4px hsl(var(--foreground) / 0.06),
        0 8px 24px hsl(var(--foreground) / 0.08),
        inset 0 1px 0 hsl(var(--background) / 0.9),
        inset 0 -1px 0 hsl(var(--foreground) / 0.02);
    }

    .lang-compact-wrapper:hover {
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-color: hsl(var(--border) / 0.6);
      
      box-shadow: 
        0 4px 8px hsl(var(--foreground) / 0.08),
        0 12px 32px hsl(var(--foreground) / 0.12),
        inset 0 1px 0 hsl(var(--background)),
        inset 0 -1px 0 hsl(var(--foreground) / 0.03);
      
      transform: translateY(-3px);
    }

    .lang-compact-btn {
      padding: 0.5rem 1rem;
      font-size: 0.9375rem;
      min-width: 3rem;
      font-weight: 600;
      border-radius: 0.625rem;
    }

    .lang-compact-btn.active {
      box-shadow: 
        0 3px 12px hsl(var(--accent) / 0.35),
        0 0 24px hsl(var(--accent) / 0.2),
        inset 0 1px 0 hsl(var(--accent-foreground) / 0.25);
    }

    .globe-icon-compact {
      width: 1.25rem;
      height: 1.25rem;
      filter: drop-shadow(0 0 6px hsl(var(--accent) / 0.25));
    }

    .lang-compact-wrapper:hover .globe-icon-compact {
      filter: drop-shadow(0 0 10px hsl(var(--accent) / 0.35));
    }
  }

  /* 超小屏幕优化 */
  @media (max-width: 375px) {
    .lang-dropdown-btn {
      padding: 0.75rem 1rem;
      font-size: 0.875rem;
    }

    .lang-compact-wrapper {
      gap: 0.5rem;
      padding: 0.75rem 1rem;
      font-size: 0.875rem;
    }

    .lang-compact-btn {
      padding: 0.375rem 0.75rem;
      font-size: 0.875rem;
      min-width: 2.5rem;
    }

    .globe-icon-compact {
      width: 1rem;
      height: 1rem;
    }
  }

  /* ========== 动画效果 ========== */
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes pulse-glow {
    0%, 100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.02);
    }
  }

  .language-switcher-dropdown[data-open="true"] .lang-dropdown-menu {
    animation: slideDown 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>

<script>
  function initLanguageSwitcher() {
    // 处理下拉菜单
    const dropdowns = document.querySelectorAll('.language-switcher-dropdown');
    
    dropdowns.forEach(dropdown => {
      const button = dropdown.querySelector('[data-dropdown-toggle]');
      if (!button) return;

      button.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = dropdown.getAttribute('data-open') === 'true';
        
        // 关闭所有其他下拉菜单
        dropdowns.forEach(d => d.setAttribute('data-open', 'false'));
        
        // 切换当前下拉菜单
        dropdown.setAttribute('data-open', (!isOpen).toString());
        button.setAttribute('aria-expanded', (!isOpen).toString());
      });
    });

    // 点击外部关闭下拉菜单
    document.addEventListener('click', () => {
      dropdowns.forEach(dropdown => {
        dropdown.setAttribute('data-open', 'false');
        const button = dropdown.querySelector('[data-dropdown-toggle]');
        if (button) {
          button.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // 键盘导航支持
    dropdowns.forEach(dropdown => {
      const button = dropdown.querySelector('[data-dropdown-toggle]') as HTMLElement;
      const menu = dropdown.querySelector('.lang-dropdown-menu');
      
      if (!button || !menu) return;

      button.addEventListener('keydown', (e) => {
        const event = e as KeyboardEvent;
        if (event.key === 'Escape') {
          dropdown.setAttribute('data-open', 'false');
          button.setAttribute('aria-expanded', 'false');
          button.focus();
        }
      });
    });
  }

  // 初始化
  initLanguageSwitcher();

  // View Transitions API 支持
  document.addEventListener('astro:after-swap', initLanguageSwitcher);
</script>
