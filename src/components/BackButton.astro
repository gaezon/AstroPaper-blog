---
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
import { t } from "@/i18n/utils";

const tr = (key: string, params?: Record<string, string | number>) =>
  t(Astro, key, params);
---

{
  SITE.showBackButton && (
    <div class="mx-auto flex w-full max-w-app items-center justify-start px-2">
      <LinkButton
        id="back-button"
        href="/"
        class="focus-outline mt-8 mb-2 flex hover:text-foreground/75"
      >
        <IconChevronLeft class="inline-block size-6 rtl:rotate-180" />
        <span>{tr("ui.back")}</span>
      </LinkButton>
    </div>
  )
}

<script>
  import { sanitizePath } from "@/utils/url";

  function getBackUrl(backButton: HTMLAnchorElement | null) {
    const storedBackUrl = sessionStorage.getItem("backUrl");

    if (storedBackUrl) {
      return sanitizePath(storedBackUrl);
    }

    return backButton?.getAttribute("href") ?? "/";
  }

  /* Update back button URL from session storage */
  function updateGoBackUrl() {
    const backButton: HTMLAnchorElement | null =
      document.querySelector("#back-button");

    if (backButton) {
      backButton.href = getBackUrl(backButton);
    }
  }

  function handleBackButtonClick(event: MouseEvent) {
    if (
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    ) {
      return;
    }

    const backButton = event.currentTarget;

    if (!(backButton instanceof HTMLAnchorElement)) {
      return;
    }

    const targetUrl = getBackUrl(backButton);

    if (backButton.href.endsWith(targetUrl)) {
      return;
    }

    event.preventDefault();
    window.location.assign(targetUrl);
  }

  function bindBackButtonClick() {
    const backButton: HTMLAnchorElement | null =
      document.querySelector("#back-button");

    if (!backButton || backButton.dataset.backButtonBound === "true") {
      return;
    }

    backButton.dataset.backButtonBound = "true";
    backButton.addEventListener("click", handleBackButtonClick);
  }

  document.addEventListener("astro:page-load", () => {
    bindBackButtonClick();
    updateGoBackUrl();
  });

  bindBackButtonClick();
  updateGoBackUrl();
</script>
