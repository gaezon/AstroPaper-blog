---
import type { HTMLAttributes } from "astro/types";

type Props = { disabled?: boolean } & HTMLAttributes<"a">;

const { disabled = false, class: className = "", href, ...attrs } = Astro.props;

const Button = disabled ? "span" : "a";
const buttonAttrs = disabled ? attrs : { href, ...attrs };
---

<Button
  aria-disabled={disabled ? "true" : "false"}
  class:list={[
    "group inline-flex items-center gap-1",
    { "hover:text-accent": !disabled },
    className,
  ]}
  {...buttonAttrs}
>
  <slot />
</Button>
