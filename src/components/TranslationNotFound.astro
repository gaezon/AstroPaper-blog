---
export interface Props {
  targetLocale: string;
  currentPostTitle: string;
  currentPath: string;
}

const { targetLocale, currentPostTitle, currentPath } = Astro.props;

// Determine which language is missing based on targetLocale
const isMissingEnglish = targetLocale === "en";
const isMissingChinese = targetLocale === "zh-CN";

// Dynamic content based on missing language
const missingLanguageName = isMissingEnglish ? "English" : "Chinese";
const availableLanguageName = isMissingEnglish ? "Chinese" : "English";
const browseAllLink = isMissingEnglish ? "/" : "/en/";
const browseAllText = isMissingEnglish
  ? "browse all Chinese posts"
  : "browse all English posts";
---

<div
  class="flex min-h-[80vh] flex-col items-center justify-center px-4 text-center"
>
  <div class="mb-8 rounded-full bg-accent/10 p-6">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="64"
      height="64"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-accent"
      aria-hidden="true"
    >
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
      ></path>
      <polyline points="14 2 14 8 20 8"></polyline>
      <line x1="9" y1="15" x2="15" y2="15"></line>
    </svg>
  </div>

  <h1
    class="mb-2 text-3xl font-bold tracking-tight text-foreground sm:text-4xl"
  >
    {missingLanguageName} Translation Not Available
  </h1>
  {
    isMissingEnglish && (
      <p class="mb-8 text-lg font-medium text-muted-foreground">暂无英文版本</p>
    )
  }
  {
    isMissingChinese && (
      <p class="mb-8 text-lg font-medium text-muted-foreground">暂无中文版本</p>
    )
  }

  <div class="mb-8 max-w-lg space-y-2 text-muted-foreground/80">
    {
      currentPostTitle && currentPostTitle !== "Article" && (
        <p>
          The article{" "}
          <span class="font-semibold text-foreground">
            "{currentPostTitle}"
          </span>{" "}
          is not yet available in {missingLanguageName}.
        </p>
      )
    }
    {
      isMissingEnglish && (
        <p class="text-sm">
          文章
          <span class="font-medium text-foreground">
            「{currentPostTitle || "本文"}」
          </span>
          暂无英文版本。
        </p>
      )
    }
    {
      isMissingChinese && (
        <p class="text-sm">
          文章
          <span class="font-medium text-foreground">
            「{currentPostTitle || "本文"}」
          </span>
          暂无中文版本。
        </p>
      )
    }
  </div>

  <div class="flex flex-col gap-3 sm:flex-row sm:gap-4">
    <!-- Primary: Go Back (most likely user intent) -->
    <button
      onclick="history.back()"
      aria-label="Go back to previous page"
      class="inline-flex items-center justify-center rounded-lg bg-accent px-6 py-3 text-base font-medium text-white transition-colors hover:bg-accent/90"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mr-2"
        aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg
      >
      Go Back
      <span class="ml-2 text-xs opacity-80">(返回)</span>
    </button>

    <!-- Secondary: Read in available language -->
    <a
      href={currentPath}
      aria-label={`Read article in ${availableLanguageName}`}
      class="inline-flex items-center justify-center rounded-lg border border-border bg-background px-6 py-3 text-base font-medium text-foreground transition-colors hover:bg-muted"
    >
      Read in {availableLanguageName}
      {
        isMissingEnglish && (
          <span class="ml-2 text-xs text-muted-foreground opacity-80">
            (中文版)
          </span>
        )
      }
      {
        isMissingChinese && (
          <span class="ml-2 text-xs text-muted-foreground opacity-80">
            (English)
          </span>
        )
      }
    </a>
  </div>

  <!-- Tertiary: Low-priority navigation option -->
  <p class="mt-10 text-sm text-muted-foreground">
    Or{" "}
    <a href={browseAllLink} class="font-medium text-accent hover:underline">
      {browseAllText}
    </a>
    {isMissingEnglish && <span class="opacity-70">/ 或浏览中文文章</span>}
    {isMissingChinese && <span class="opacity-70">/ 或浏览英文文章</span>}
  </p>
</div>
