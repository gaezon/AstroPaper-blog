---
import type { BlogTagPaginatedPageProps } from "@/types/pagination";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { getCurrentLocale, t } from "@/i18n/utils";
import { normalizeBlogLocale } from "@/utils/blog-locale";
import { getTagSwitchOverride } from "@/utils/getTagSwitchOverride";
import { getLocalizedSiteTitle } from "@/utils/i18n-pages";
import { buildBreadcrumbs } from "@/utils/breadcrumbs";
import { SITE } from "@/config";

interface Props extends BlogTagPaginatedPageProps {
  tag: string;
}

const { page, tag, tagName } = Astro.props;

const currentLocale = normalizeBlogLocale(getCurrentLocale(Astro));
const { switchOverride, alternateURLs, disableAutoAlternates } =
  await getTagSwitchOverride(Astro);
const pageTitle = `${t(Astro, "tags.title")}: ${tagName}`;
const pageDescription = `${t(Astro, "tags.postsWithTag")} ${tagName}`;
const layoutTitle = `${pageTitle} | ${getLocalizedSiteTitle(currentLocale)}`;
const pageEntries = page.data;
const crumbs = buildBreadcrumbs({
  locale: currentLocale as "zh-CN" | "en",
  pathname: Astro.url.pathname,
  pageTitle: tagName,
  tagName,
  siteOrigin: SITE.website,
});
---

<Layout
  title={layoutTitle}
  description={pageDescription}
  alternateURLs={alternateURLs}
  disableAutoAlternates={disableAutoAlternates}
  breadcrumbs={crumbs}
>
  <Header switchOverride={switchOverride} />
  <Main
    pageTitle={[`${t(Astro, "tags.title")}:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={pageDescription}
  >
    <ul>
      {pageEntries.map(entry => <Card {...entry} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
