---
import type { CollectionEntry } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { getCurrentLocale, t } from "@/i18n/utils";
import { getTagSwitchOverride } from "@/utils/getTagSwitchOverride";
import { getLocalizedSiteTitle, normalizeBlogLocale } from "@/utils/i18n-pages";

interface Props {
  page: unknown;
  tag: string;
  tagName: string;
}

const { page, tag, tagName } = Astro.props;

const currentLocale = normalizeBlogLocale(getCurrentLocale(Astro));
const switchOverride = await getTagSwitchOverride(Astro);
const pageTitle = `${t(Astro, "tags.title")}: ${tagName}`;
const pageDescription = `${t(Astro, "tags.postsWithTag")} ${tagName}`;
const layoutTitle = `${pageTitle} | ${getLocalizedSiteTitle(currentLocale)}`;
const paginatedPage = page as {
  data: CollectionEntry<"blog" | "blog-en">[];
  lastPage: number;
  [key: string]: unknown;
};
const pageEntries = paginatedPage.data;
---

<Layout title={layoutTitle} description={pageDescription}>
  <Header switchOverride={switchOverride} />
  <Main
    pageTitle={[`${t(Astro, "tags.title")}:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={pageDescription}
  >
    <ul>
      {pageEntries.map(entry => <Card {...entry} />)}
    </ul>
  </Main>

  <Pagination page={paginatedPage} />

  <Footer noMarginTop={paginatedPage.lastPage > 1} />
</Layout>
