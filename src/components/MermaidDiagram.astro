---
export interface Props {
  id?: string;
  class?: string;
}

const { id = 'mermaid-diagram', class: className = '' } = Astro.props;
---

<div 
  id={id}
  class={`mermaid-container ${className}`}
  data-mermaid
>
  <slot />
</div>

<style>
  .mermaid-container {
    @apply my-6 mx-auto max-w-full overflow-x-auto;
  }
  
  .mermaid-container :global(svg) {
    @apply max-w-full h-auto;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', async () => {
    try {
      const mermaidModule = await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs');
      const mermaid = mermaidModule.default;
      
      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        themeVariables: {
          primaryColor: '#f5fafc',
          primaryTextColor: '#282728',
          primaryBorderColor: '#7aa4c7',
          lineColor: '#7aa4c7',
          secondaryBorderColor: '#cdd6dd',
          secondaryColor: '#ffffff',
          tertiaryColor: '#eef3f6',
          fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif'
        }
      });

      const mermaidElements = document.querySelectorAll('pre.mermaid, .mermaid, [data-mermaid]');
      
      for (let i = 0; i < mermaidElements.length; i++) {
        const element = mermaidElements[i];
        const graphDefinition = element.textContent && element.textContent.trim();
        if (!graphDefinition) continue;
        
        try {
          const graphId = 'mermaid-' + i + '-' + Date.now();
          const result = await mermaid.render(graphId, graphDefinition);
          element.innerHTML = result.svg;
        } catch (err) {
          console.error('Mermaid rendering error:', err);
          element.innerHTML = '<pre style="background-color: #fee; padding: 1rem; border-radius: 0.5rem; color: #dc2626;">Mermaid 渲染错误: ' + err.message + '</pre>';
        }
      }
    } catch (importErr) {
      console.error('Failed to load Mermaid:', importErr);
    }
  });
</script> 