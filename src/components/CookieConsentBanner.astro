---
import { getCurrentLocale, t } from "@/i18n/utils";
import { normalizePathWithLocale } from "@/utils/url";

const currentLocale = getCurrentLocale(Astro);
const localePrefix = currentLocale === "zh-CN" ? "" : `/${currentLocale}`;
const localeUrl = (path: string) => normalizePathWithLocale(path, localePrefix);
const tr = (key: string, params?: Record<string, string | number>) =>
  t(Astro, key, params);
---

<div
  id="cookie-consent-banner"
  class="fixed right-4 bottom-4 z-50 hidden max-w-sm rounded-lg border border-border bg-background p-3 shadow-md backdrop-blur-sm"
  data-msg-accepted={tr("ui.cookie.status.accepted")}
  data-msg-rejected={tr("ui.cookie.status.rejected")}
  data-msg-saved={tr("ui.cookie.status.saved")}
>
  <div class="space-y-3">
    <p class="text-xs text-foreground">
      {tr("ui.cookie.consentText")}
      <a
        href={localeUrl("/cookie-policy")}
        class="hover:text-skin-accent underline decoration-dashed underline-offset-2"
      >
        {tr("ui.cookiePolicy")}
      </a>
    </p>
    <div class="flex gap-2">
      <button
        id="cookie-accept-btn"
        class="bg-skin-accent hover:bg-skin-accent/90 flex-1 rounded border border-transparent px-3 py-1.5 text-xs font-medium text-white"
      >
        {tr("ui.cookie.accept")}
      </button>
      <button
        id="cookie-reject-btn"
        class="flex-1 rounded border border-transparent bg-foreground px-3 py-1.5 text-xs font-medium text-background hover:bg-foreground/90"
      >
        {tr("ui.cookie.reject")}
      </button>
      <button
        id="cookie-settings-btn"
        class="hover:bg-surface-100 rounded border border-border px-2 py-1.5 text-xs font-medium text-foreground"
        aria-label={tr("ui.cookie.settings")}
        title={tr("ui.cookie.settings")}
        data-cookie-settings-trigger
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1.2em"
          height="1.2em"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="inline-block"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="3"></circle>
          <path
            d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<button
  id="cookie-settings-fab"
  type="button"
  class="hover:bg-surface-100 fixed bottom-4 left-4 z-40 flex hidden h-10 w-10 items-center justify-center rounded-full border border-border bg-background text-base shadow-md transition"
  aria-label={tr("ui.cookie.settings")}
  title={tr("ui.cookie.settings")}
  data-cookie-settings-trigger
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="1.2em"
    height="1.2em"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="inline-block"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="3"></circle>
    <path
      d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
    ></path>
  </svg>
</button>

<div id="cookie-status-announcer" class="sr-only" aria-live="polite"></div>

<!-- Cookie settings modal -->
<div
  id="cookie-settings-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-white/80 backdrop-blur-sm dark:bg-black/60"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookie-settings-title"
  tabindex="-1"
>
  <div class="mx-4 max-w-lg rounded-lg bg-background p-6 shadow-xl">
    <div class="mb-4">
      <h3
        id="cookie-settings-title"
        class="text-lg font-semibold text-foreground"
      >
        {tr("ui.cookie.title")}
      </h3>
      <p class="mt-2 text-sm text-foreground/80">
        {tr("ui.cookie.description")}
      </p>
    </div>

    <div class="space-y-4">
      <!-- Essential cookies -->
      <div class="flex items-start gap-3">
        <input
          type="checkbox"
          id="essential-cookies"
          checked
          disabled
          class="text-skin-accent focus:ring-skin-accent mt-1 h-4 w-4 rounded border-border"
        />
        <div>
          <label for="essential-cookies" class="font-medium text-foreground">
            {tr("ui.cookie.essential.title")}
          </label>
          <p class="text-sm text-foreground/80">
            {tr("ui.cookie.essential.description")}
          </p>
        </div>
      </div>

      <!-- Analytics cookies -->
      <div class="flex items-start gap-3">
        <input
          type="checkbox"
          id="analytics-cookies"
          class="text-skin-accent focus:ring-skin-accent mt-1 h-4 w-4 rounded border-border"
        />
        <div>
          <label for="analytics-cookies" class="font-medium text-foreground">
            {tr("ui.cookie.analytics.title")}
          </label>
          <p class="text-sm text-foreground/80">
            {tr("ui.cookie.analytics.description")}
          </p>
        </div>
      </div>
    </div>

    <div class="mt-6 flex gap-3">
      <button
        id="save-cookie-settings"
        class="bg-skin-accent hover:bg-skin-accent/90 focus:ring-skin-accent flex-1 rounded-lg px-4 py-2 text-sm font-medium text-white focus:ring-2 focus:ring-offset-2 focus:outline-none"
      >
        {tr("ui.cookie.saveSettings")}
      </button>
      <button
        id="close-cookie-settings"
        class="hover:bg-surface-100 rounded-lg border border-border bg-background px-4 py-2 text-sm font-medium text-foreground focus:ring-2 focus:ring-border focus:ring-offset-2 focus:outline-none"
      >
        {tr("ui.cookie.cancel")}
      </button>
    </div>
  </div>
</div>

<script>
  // ============================================================================
  // Type Definitions
  // ============================================================================

  interface CookieSettings {
    essential: boolean;
    analytics: boolean;
    advertising: boolean;
  }

  type ConsentStatus = "accepted" | "rejected" | "custom";

  // ============================================================================
  // Constants
  // ============================================================================

  const STORAGE_KEYS = {
    CONSENT: "cookie-consent",
    SETTINGS: "cookie-settings",
    TIMESTAMP: "cookie-consent-timestamp",
    VERSION: "cookie-consent-version",
  } as const;

  const CONSENT_VERSION = "v1";

  const ELEMENT_IDS = {
    BANNER: "cookie-consent-banner",
    MODAL: "cookie-settings-modal",
    ACCEPT_BTN: "cookie-accept-btn",
    REJECT_BTN: "cookie-reject-btn",
    SETTINGS_FAB: "cookie-settings-fab",
    SAVE_BTN: "save-cookie-settings",
    CLOSE_BTN: "close-cookie-settings",
    ANALYTICS_CHECKBOX: "analytics-cookies",
    ANNOUNCER: "cookie-status-announcer",
  } as const;

  const FOCUSABLE_SELECTOR = [
    "a[href]",
    "button:not([disabled])",
    "textarea:not([disabled])",
    "input:not([disabled])",
    "select:not([disabled])",
    "[tabindex]:not([tabindex='-1'])",
  ].join(", ");

  const globalState = window as Window & {
    __cookieConsentAfterSwapHandler?: () => void;
    __cookieConsentAbortController?: AbortController;
  };

  // ============================================================================
  // Cookie Consent Logic
  // ============================================================================

  function initCookieConsent() {
    if (globalState.__cookieConsentAbortController) {
      globalState.__cookieConsentAbortController.abort();
    }
    const initController = new AbortController();
    globalState.__cookieConsentAbortController = initController;
    const { signal } = initController;

    const banner = document.getElementById(ELEMENT_IDS.BANNER);
    const modal = document.getElementById(ELEMENT_IDS.MODAL);
    const acceptBtn = document.getElementById(ELEMENT_IDS.ACCEPT_BTN);
    const rejectBtn = document.getElementById(ELEMENT_IDS.REJECT_BTN);
    const settingsFab = document.getElementById(ELEMENT_IDS.SETTINGS_FAB);
    const saveBtn = document.getElementById(ELEMENT_IDS.SAVE_BTN);
    const closeBtn = document.getElementById(ELEMENT_IDS.CLOSE_BTN);
    const announcer = document.getElementById(ELEMENT_IDS.ANNOUNCER);

    const analyticsCheckbox = document.getElementById(
      ELEMENT_IDS.ANALYTICS_CHECKBOX
    ) as HTMLInputElement | null;

    if (
      !banner ||
      !modal ||
      !acceptBtn ||
      !rejectBtn ||
      !saveBtn ||
      !closeBtn ||
      !settingsFab
    ) {
      return;
    }

    const MESSAGES = {
      accepted: banner.getAttribute("data-msg-accepted") || "",
      rejected: banner.getAttribute("data-msg-rejected") || "",
      saved: banner.getAttribute("data-msg-saved") || "",
    };

    const parseCookieSettings = (
      value: string | null
    ): Partial<CookieSettings> => {
      if (!value) return {};
      try {
        const parsed = JSON.parse(value);
        if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
          return parsed as Partial<CookieSettings>;
        }
      } catch {
        localStorage.removeItem(STORAGE_KEYS.SETTINGS);
      }
      return {};
    };

    const parseConsentStatus = (value: string | null): ConsentStatus | null => {
      if (value === "accepted" || value === "rejected" || value === "custom") {
        return value;
      }
      return null;
    };

    let lastFocusedElement: HTMLElement | null = null;

    const getFocusableElements = (): HTMLElement[] => {
      const elements = Array.from(
        modal.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR)
      );
      return elements.filter(element => {
        if (element.hasAttribute("disabled")) return false;
        if (element.getAttribute("aria-hidden") === "true") return false;
        return element.getClientRects().length > 0;
      });
    };

    const backupAttribute = (
      element: Element,
      key: string,
      value: string | null
    ) => {
      if (element.hasAttribute(key)) return;
      if (value === null) {
        element.setAttribute(key, "__null");
        return;
      }
      element.setAttribute(key, value);
    };

    const restoreAttribute = (element: Element, key: string, attr: string) => {
      const storedValue = element.getAttribute(key);
      if (storedValue === null) return;
      if (storedValue === "__null") {
        element.removeAttribute(attr);
      } else {
        element.setAttribute(attr, storedValue);
      }
      element.removeAttribute(key);
    };

    const setBackgroundInert = (isInert: boolean) => {
      const backgroundElements = Array.from(document.body.children).filter(
        element => element !== modal && element !== announcer
      );
      backgroundElements.forEach(element => {
        if (isInert) {
          backupAttribute(
            element,
            "data-cookie-prev-aria-hidden",
            element.getAttribute("aria-hidden")
          );
          backupAttribute(
            element,
            "data-cookie-prev-inert",
            element.getAttribute("inert")
          );
          element.setAttribute("inert", "");
          element.setAttribute("aria-hidden", "true");
          return;
        }
        restoreAttribute(
          element,
          "data-cookie-prev-aria-hidden",
          "aria-hidden"
        );
        restoreAttribute(element, "data-cookie-prev-inert", "inert");
      });
    };

    const resetModalState = () => {
      if (modal.classList.contains("hidden")) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      setBackgroundInert(false);
      lastFocusedElement = null;
    };

    resetModalState();

    const trapFocus = (event: KeyboardEvent) => {
      if (event.key !== "Tab") return;
      const focusable = getFocusableElements();
      if (focusable.length === 0) {
        event.preventDefault();
        modal.focus();
        return;
      }
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const activeElement = document.activeElement;
      if (event.shiftKey) {
        if (activeElement === first || activeElement === modal) {
          event.preventDefault();
          last.focus();
        }
        return;
      }
      if (activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    const handleKeydown = (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        event.preventDefault();
        closeModal();
        return;
      }
      if (event.key === "Tab") {
        trapFocus(event);
      }
    };

    const announce = (message: string) => {
      if (!announcer) return;
      announcer.textContent = message;
    };

    const openModal = () => {
      if (!modal.classList.contains("hidden")) return;
      lastFocusedElement =
        document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      setBackgroundInert(true);
      document.addEventListener("keydown", handleKeydown, { signal });
      const focusable = getFocusableElements();
      if (focusable.length > 0) {
        focusable[0].focus();
        return;
      }
      modal.focus();
    };

    const closeModal = () => {
      if (modal.classList.contains("hidden")) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      setBackgroundInert(false);
      document.removeEventListener("keydown", handleKeydown);
      if (lastFocusedElement && document.contains(lastFocusedElement)) {
        lastFocusedElement.focus();
      }
    };

    const hideBanner = () => {
      banner.classList.add("hidden");
    };

    const showSettingsFab = () => {
      settingsFab.classList.remove("hidden");
    };

    const hideSettingsFab = () => {
      settingsFab.classList.add("hidden");
    };

    const persistConsent = (
      status: ConsentStatus,
      settings: CookieSettings
    ) => {
      localStorage.setItem(STORAGE_KEYS.CONSENT, status);
      localStorage.setItem(STORAGE_KEYS.SETTINGS, JSON.stringify(settings));
      localStorage.setItem(STORAGE_KEYS.TIMESTAMP, new Date().toISOString());
      localStorage.setItem(STORAGE_KEYS.VERSION, CONSENT_VERSION);
    };

    const clearConsent = () => {
      localStorage.removeItem(STORAGE_KEYS.CONSENT);
      localStorage.removeItem(STORAGE_KEYS.SETTINGS);
      localStorage.removeItem(STORAGE_KEYS.TIMESTAMP);
      localStorage.removeItem(STORAGE_KEYS.VERSION);
    };

    const loadOptionalCookies = (analytics: boolean): void => {
      if (analytics) {
        // Load other analytics tools that require consent here
        // Note: Umami Analytics is loaded in Layout.astro; cookie consent not required
      }
    };

    const saveSettings = (settings: CookieSettings) => {
      persistConsent("custom", settings);
      hideBanner();
      closeModal();
      loadOptionalCookies(settings.analytics);
      announce(MESSAGES.saved);
    };

    // Check if cookie preferences have been set
    const storedVersion = localStorage.getItem(STORAGE_KEYS.VERSION);
    let cookieConsent = parseConsentStatus(
      localStorage.getItem(STORAGE_KEYS.CONSENT)
    );
    if (storedVersion !== CONSENT_VERSION) {
      clearConsent();
      cookieConsent = null;
    }
    if (!cookieConsent) {
      if (banner.classList.contains("hidden")) {
        banner.classList.remove("hidden");
      }
      hideSettingsFab();
    } else {
      if (!banner.classList.contains("hidden")) {
        hideBanner();
      }
      showSettingsFab();
    }

    // Load saved settings
    const savedSettings = parseCookieSettings(
      localStorage.getItem(STORAGE_KEYS.SETTINGS)
    );
    const normalizedSettings: CookieSettings = {
      essential: true,
      analytics: savedSettings.analytics ?? false,
      advertising: false,
    };

    if (cookieConsent && savedSettings.advertising === true) {
      persistConsent(cookieConsent, normalizedSettings);
    }

    if (analyticsCheckbox) {
      analyticsCheckbox.checked = normalizedSettings.analytics;
    }

    // Accept all button
    acceptBtn.addEventListener(
      "click",
      () => {
        const settings: CookieSettings = {
          essential: true,
          analytics: true,
          advertising: false,
        };
        persistConsent("accepted", settings);
        hideBanner();
        showSettingsFab();
        loadOptionalCookies(true);
        announce(MESSAGES.accepted);
      },
      { signal }
    );

    // Essential-only button
    rejectBtn.addEventListener(
      "click",
      () => {
        const settings: CookieSettings = {
          essential: true,
          analytics: false,
          advertising: false,
        };
        persistConsent("rejected", settings);
        hideBanner();
        showSettingsFab();
        loadOptionalCookies(false);
        announce(MESSAGES.rejected);
      },
      { signal }
    );

    const settingsTriggers = document.querySelectorAll(
      "[data-cookie-settings-trigger]"
    );
    settingsTriggers.forEach(trigger => {
      trigger.addEventListener(
        "click",
        event => {
          if (trigger instanceof HTMLAnchorElement) {
            event.preventDefault();
          }
          openModal();
        },
        { signal }
      );
    });

    // Save settings button
    saveBtn.addEventListener(
      "click",
      () => {
        const settings: CookieSettings = {
          essential: true,
          analytics: analyticsCheckbox?.checked ?? false,
          advertising: false,
        };
        saveSettings(settings);
        showSettingsFab();
      },
      { signal }
    );

    // Close modal button
    closeBtn.addEventListener("click", closeModal, { signal });

    // Close when clicking outside the modal
    modal.addEventListener(
      "click",
      e => {
        if (e.target === modal) {
          closeModal();
        }
      },
      { signal }
    );

    // Check existing consent state and load corresponding scripts
    if (cookieConsent) {
      loadOptionalCookies(normalizedSettings.analytics);
    }
  }

  // Initialize
  initCookieConsent();

  // Re-initialize on page transitions without duplicating listeners
  const cookieConsentAfterSwapKey = "__cookieConsentAfterSwapHandler";
  if (!globalState[cookieConsentAfterSwapKey]) {
    const handler = () => initCookieConsent();
    globalState[cookieConsentAfterSwapKey] = handler;
    document.addEventListener("astro:after-swap", handler);
  }
</script>

<style>
  /* Ensure banner is styled correctly across themes */
  #cookie-consent-banner {
    background: rgb(var(--color-background));
    border-color: rgb(var(--color-border));
    color: rgb(var(--color-foreground));
  }

  #cookie-settings-modal > div {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    border: 1px solid rgb(var(--color-border));
  }
</style>
