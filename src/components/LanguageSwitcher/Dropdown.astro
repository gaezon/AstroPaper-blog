---
import {
  getCurrentLocale,
  getLocaleSwitchUrl,
  getAvailableLocales,
  t,
} from "@/i18n/utils";

interface Props {
  class?: string;
  override?: Record<string, string | undefined>;
}

const { class: className = "", override } = Astro.props;

const currentLocale = getCurrentLocale(Astro);
const availableLocales = getAvailableLocales();
const currentLocaleInfo = availableLocales.find(l => l.code === currentLocale);
const tr = (key: string, params?: Record<string, string | number>) =>
  t(Astro, key, params);
---

<div class={`language-switcher-dropdown ${className}`} data-open="false">
  <button
    type="button"
    class="lang-dropdown-btn focus-outline"
    aria-expanded="false"
    aria-haspopup="menu"
    data-dropdown-toggle
  >
    <svg
      class="globe-icon"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
      ></path>
    </svg>
    <span class="current-lang">
      {currentLocaleInfo?.profile.label || currentLocaleInfo?.name}
    </span>
    <span class="sr-only">{tr("language.selectLanguage")}</span>
    <svg
      class="chevron-icon"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  {/* Language switcher dropdown menu */}
  <div class="lang-dropdown-menu" role="menu">
    {
      /*
      Note: data-astro-reload is intentionally used to force full page reload.
      This ensures proper event binding on mobile devices and prevents issues
      with View Transitions not reinitializing JavaScript handlers after language switch.
      See README in src/components/LanguageSwitcher/ for rationale on data-astro-reload usage.
    */
    }
    {
      availableLocales.map(locale => {
        const targetHref =
          override?.[locale.code] ?? getLocaleSwitchUrl(Astro, locale.code);
        return (
          <a
            href={targetHref}
            data-base-href={targetHref}
            data-locale={locale.code}
            class={`lang-dropdown-item ${locale.code === currentLocale ? "active" : ""}`}
            lang={locale.profile.langTag}
            hreflang={locale.code}
            data-astro-reload
            aria-current={locale.code === currentLocale ? "page" : undefined}
            role="menuitem"
          >
            <span class="lang-name" title={locale.name}>
              {locale.name}
            </span>
            {locale.code === currentLocale && (
              <svg
                class="check-icon"
                fill="currentColor"
                viewBox="0 0 20 20"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
            )}
          </a>
        );
      })
    }
  </div>
</div>

<style>
  /* ========== Dropdown styles - Liquid Glass design ========== */
  .language-switcher-dropdown {
    position: relative;
    display: inline-block;
  }

  .lang-dropdown-btn {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.875rem;

    /* Liquid Glass style */
    background: hsl(var(--background) / 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid hsl(var(--border) / 0.5);
    border-radius: 0.625rem;

    font-size: 0.875rem;
    font-weight: 500;
    color: hsl(var(--foreground) / 0.85);
    cursor: pointer;

    box-shadow:
      0 1px 2px hsl(var(--foreground) / 0.04),
      0 2px 8px hsl(var(--foreground) / 0.06),
      inset 0 1px 0 hsl(var(--background) / 0.5);

    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    min-width: 120px;
  }

  .lang-dropdown-btn:hover {
    background: hsl(var(--background) / 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-color: hsl(var(--accent) / 0.6);
    box-shadow:
      0 2px 4px hsl(var(--foreground) / 0.06),
      0 8px 16px hsl(var(--foreground) / 0.1),
      inset 0 1px 0 hsl(var(--background) / 0.7);
    transform: translateY(-1px);
  }

  .globe-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    color: hsl(var(--accent));
    opacity: 0.75;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    filter: drop-shadow(0 0 4px hsl(var(--accent) / 0.2));
  }

  .lang-dropdown-btn:hover .globe-icon {
    opacity: 0.95;
    transform: rotate(20deg) scale(1.05);
    filter: drop-shadow(0 0 8px hsl(var(--accent) / 0.3));
  }

  .current-lang {
    white-space: nowrap;
    flex: 1;
  }

  .chevron-icon {
    width: 1rem;
    height: 1rem;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    flex-shrink: 0;
    opacity: 0.6;
  }

  .language-switcher-dropdown[data-open="true"] .chevron-icon {
    transform: rotate(180deg);
    opacity: 0.9;
  }

  .lang-dropdown-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 50;
    min-width: 100%;
    padding: 0.5rem;

    /* Liquid Glass menu */
    background: hsl(var(--background) / 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid hsl(var(--border) / 0.6);
    border-radius: 0.75rem;

    box-shadow:
      0 4px 12px hsl(var(--foreground) / 0.08),
      0 12px 32px hsl(var(--foreground) / 0.12),
      0 0 0 1px hsl(var(--background) / 0.1),
      inset 0 1px 0 hsl(var(--background) / 0.8);

    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.5rem) scale(0.95);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .language-switcher-dropdown[data-open="true"] .lang-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .lang-dropdown-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    color: hsl(var(--foreground) / 0.85);
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(2px);
    position: relative;
    overflow: hidden;
  }

  .lang-dropdown-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background: linear-gradient(
      90deg,
      hsl(var(--accent) / 0.15) 0%,
      hsl(var(--accent) / 0.05) 100%
    );
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .lang-dropdown-item:hover::before {
    width: 100%;
  }

  .lang-dropdown-item:hover {
    background: hsl(var(--muted) / 0.5);
    backdrop-filter: blur(8px);
    color: hsl(var(--foreground));
    transform: translateX(3px);
  }

  .lang-dropdown-item.active {
    background: hsl(var(--accent) / 0.9);
    backdrop-filter: blur(12px);
    color: hsl(var(--accent-foreground));
    font-weight: 600;
    box-shadow:
      0 2px 8px hsl(var(--accent) / 0.25),
      0 0 16px hsl(var(--accent) / 0.15),
      inset 0 1px 0 hsl(var(--accent-foreground) / 0.15);
  }

  .lang-dropdown-item.active::before {
    display: none;
  }

  .lang-dropdown-item.active:hover {
    background: hsl(var(--accent));
    transform: translateX(4px);
  }

  .lang-name {
    flex: 1;
    min-width: 0;
    position: relative;
    z-index: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .check-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    filter: drop-shadow(0 0 4px hsl(var(--accent-foreground) / 0.3));
    position: relative;
    z-index: 1;
  }

  @media (max-width: 639px) {
    /* Mobile dropdown optimizations */
    .lang-dropdown-btn {
      min-width: 100%;
      padding: 0.875rem 1.25rem;
    }

    .lang-dropdown-menu {
      left: 0;
      right: 0;
      min-width: 100%;
    }

    .lang-dropdown-btn .current-lang {
      display: inline; /* Show full language name on mobile */
    }

    .globe-icon {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  @media (max-width: 375px) {
    .lang-dropdown-btn {
      padding: 0.75rem 1rem;
      font-size: 0.875rem;
    }
  }
</style>
