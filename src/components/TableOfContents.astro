---
import TocClient from './TocClient.astro';

export interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<!-- 目录导航容器（桌面端粘性侧栏） -->
<nav
  id="toc-sidebar"
  class:list={[
    "fixed top-1/2 -translate-y-1/2 z-40 hidden xl:block",
    // 尽可能靠近视口左侧：xl 起 1rem 间距；超宽屏继续贴近左侧
    "xl:left-4 2xl:left-6",
    "w-72 max-h-[calc(100vh-8rem)] overflow-y-auto transition-all duration-200",
    "bg-background/80 backdrop-blur-lg border border-border/60 rounded-xl p-5 shadow-xl shadow-foreground/10",
    "hover:shadow-2xl hover:shadow-foreground/15 hover:bg-background/85",
    className
  ]}
  aria-label="On this page"
  role="navigation"
>
  <div class="mb-4 flex items-center justify-between border-b border-border/70 pb-3">
    <h3 class="text-base font-semibold text-foreground tracking-wide">目录</h3>
    <!-- 桌面端折叠按钮（仅 >=xl 显示） -->
    <button
      id="toc-collapse"
      class="hidden xl:inline-flex items-center gap-1.5 rounded-md border border-border/60 px-3 py-1.5 text-xs font-medium text-muted hover:text-foreground hover:bg-muted/50 hover:border-border transition-all duration-200"
      aria-label="收起目录"
      aria-expanded="true"
      type="button"
    >
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
      收起
    </button>
  </div>
  
  <!-- 目录列表容器，由客户端JavaScript填充 -->
  <div id="toc-nav" class="space-y-1.5" role="list">
    <!-- 加载占位符 -->
    <div id="toc-loading" class="space-y-3">
      <div class="h-4 bg-muted/40 rounded-md animate-pulse"></div>
      <div class="h-4 bg-muted/40 rounded-md animate-pulse w-4/5"></div>
      <div class="h-3.5 bg-muted/30 rounded-md animate-pulse w-3/5 ml-4"></div>
      <div class="h-3.5 bg-muted/30 rounded-md animate-pulse w-2/3 ml-4"></div>
    </div>
  </div>
  
</nav>

<!-- 移动端切换按钮（独立于桌面端容器） -->
<button
  id="toc-toggle"
  class="xl:hidden fixed right-5 bottom-24 sm:bottom-8 z-50 p-3.5 bg-accent/90 hover:bg-accent text-background rounded-full shadow-lg hover:shadow-xl transition-all duration-200 hover:scale-105 active:scale-95"
  aria-label="打开文章目录"
  aria-expanded="false"
  type="button"
>
  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
    <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
  </svg>
</button>

<!-- 桌面端展开按钮：当目录被收起时显示（仅 >=xl 显示） -->
<button
  id="toc-open-desktop"
  class:list={[
    "hidden xl:flex items-center justify-center fixed top-1/2 -translate-y-1/2 z-40 w-14 h-14 rounded-full xl:!flex",
    "bg-gradient-to-br from-accent/90 to-accent/70 backdrop-blur-lg border border-accent/40",
    "shadow-lg shadow-accent/25 hover:shadow-xl hover:shadow-accent/35 hover:scale-105",
    "transition-all duration-300 group",
    "xl:left-4 2xl:left-6"
  ]}
  aria-label="展开目录"
  aria-expanded="false"
  type="button"
>
  <!-- 抽象的目录展开图标：三条动态线条 -->
  <div class="relative w-6 h-6 flex flex-col justify-center items-center gap-1">
    <!-- 第一条线：短 -->
    <div class="w-3 h-0.5 bg-background rounded-full transition-all duration-300 group-hover:w-4 group-hover:translate-x-0.5"></div>
    <!-- 第二条线：中 -->
    <div class="w-4 h-0.5 bg-background rounded-full transition-all duration-300 group-hover:w-5"></div>
    <!-- 第三条线：长 -->
    <div class="w-5 h-0.5 bg-background rounded-full transition-all duration-300 group-hover:w-6 group-hover:-translate-x-0.5"></div>
    
    <!-- 微妙的光晕效果 -->
    <div class="absolute inset-0 bg-background/20 rounded-full blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
  </div>
</button>

<!-- 移动端覆盖层 -->
<div
  id="toc-overlay"
  class="xl:hidden fixed inset-0 z-30 bg-background/85 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-200"
  role="dialog"
  aria-labelledby="toc-title"
  aria-modal="true"
>
  <div class="fixed top-0 right-0 h-full w-80 max-w-[90vw] bg-background border-l border-border/70 shadow-2xl transform translate-x-full transition-transform duration-250">
    <div class="flex items-center justify-between p-5 border-b border-border/70">
      <h3 id="toc-title" class="text-lg font-semibold text-foreground tracking-wide">目录</h3>
      <button
        id="toc-close"
        class="p-2 text-muted hover:text-foreground hover:bg-muted/30 rounded-md transition-all duration-200"
        aria-label="关闭目录"
        type="button"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
        </svg>
      </button>
    </div>
    <nav id="toc-nav-mobile" class="p-5 overflow-y-auto h-[calc(100%-5rem)]" role="navigation" aria-label="On this page">
      <!-- 移动端目录内容，由客户端JavaScript填充 -->
    </nav>
  </div>
</div>

<!-- 引入客户端交互组件 -->
<TocClient />
