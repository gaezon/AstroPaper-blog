---
import Hr from "./Hr.astro";
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
import DummyLogo from "@/assets/dummy-logo.svg";
import { getCurrentLocale, t } from "@/i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface HeaderProps {
  switchOverride?: Record<string, string | undefined>;
}

const { pathname } = Astro.url;
const { switchOverride } = Astro.props as HeaderProps;

// 国际化相关变量
const currentLocale = getCurrentLocale(Astro);
const localePrefix = currentLocale === "zh-CN" ? "" : `/${currentLocale}`;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// 构建本地化的URL
const localeUrl = (path: string) => {
  const fullPath = `${localePrefix}${path}`;
  // 确保根路径返回 "/"，其他路径以 "/" 结尾
  return fullPath === "/" ? "/" : fullPath.endsWith("/") ? fullPath : `${fullPath}/`;
};

// 获取翻译函数
const tr = (key: string, params?: Record<string, string | number>) => t(Astro, key, params);
---

<header>
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    {tr("ui.skipToContent")}
  </a>
  <div
    id="nav-container"
    class="mx-auto flex max-w-app flex-col items-center justify-between sm:flex-row"
  >
    <div
      id="top-nav-wrap"
      class="relative flex w-full items-center justify-between bg-background p-4 sm:py-4"
    >
      <div class="flex items-center">
        <a href={localeUrl("/")} class="flex items-center" aria-label={tr("nav.home")}>
          <DummyLogo class="h-auto w-[45px] sm:w-[50px]" />
        </a>
      </div>
      <nav
        id="nav-menu"
        class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
      >
        <button
          id="menu-btn"
          class="focus-outline self-end p-2 sm:hidden"
          aria-label={tr("ui.menu")}
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenuDeep id="menu-icon" />
        </button>
        <ul
          id="menu-items"
          class:list={[
            "mt-4 grid w-44 grid-cols-2 place-content-center gap-2",
            "[&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium [&>li>a]:hover:text-accent sm:[&>li>a]:px-2 sm:[&>li>a]:py-1",
            "hidden",
            "sm:mt-0 sm:flex sm:w-auto sm:gap-x-5 sm:gap-y-0",
          ]}
        >
          <li class="col-span-2">
            <a href={localeUrl("/posts")} class:list={{ "active-nav": isActive("/posts") }}>
              {tr("nav.blog")}
            </a>
          </li>
          <li class="col-span-2">
            <a href={localeUrl("/tags")} class:list={{ "active-nav": isActive("/tags") }}>
              {tr("nav.tags")}
            </a>
          </li>
          <li class="col-span-2">
            <a href={localeUrl("/about")} class:list={{ "active-nav": isActive("/about") }}>
              {tr("nav.about")}
            </a>
          </li>
          <li class="col-span-2">
            <a
              href={localeUrl("/contact")}
              class:list={{ "active-nav": isActive("/contact") }}
            >
              {tr("ui.contact")}
            </a>
          </li>
          {
            SITE.showArchives && (
              <li class="col-span-2">
                <LinkButton
                  href={localeUrl("/archives")}
                  class:list={[
                    "focus-outline flex justify-center p-3 sm:p-1",
                    {
                      "active-nav [&>svg]:stroke-accent": isActive("/archives"),
                    },
                  ]}
                  ariaLabel={tr("nav.archives")}
                  title={tr("nav.archives")}
                >
                  <IconArchive
                    class="hidden sm:inline-block"
                    aria-hidden="true"
                  />
                  <span class="sm:sr-only">{tr("nav.archives")}</span>
                </LinkButton>
              </li>
            )
          }
          <li class="col-span-1 flex items-center justify-center">
            <LinkButton
              href={localeUrl("/search")}
              class:list={[
                "focus-outline flex p-3 sm:p-1",
                { "[&>svg]:stroke-accent": isActive("/search") },
              ]}
              ariaLabel={tr("nav.search")}
              title={tr("nav.search")}
            >
              <IconSearch aria-hidden="true" />
              <span class="sr-only">{tr("nav.search")}</span>
            </LinkButton>
          </li>
          <!-- 语言切换器 -->
          <li class="col-span-2 sm:col-span-1 flex items-center justify-center">
            <LanguageSwitcher variant="toggle" class="language-switcher-compact" override={switchOverride} />
          </li>
          {
            SITE.lightAndDarkMode && (
              <li class="col-span-1 flex items-center justify-center">
                <button
                  id="theme-btn"
                  class="focus-outline relative size-12 p-4 sm:size-8 hover:[&>svg]:stroke-accent"
                  title={tr("theme.toggle")}
                  aria-label={tr("theme.toggle")}
                  aria-live="polite"
                >
                  <IconMoon
                    class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"
                    aria-hidden="true"
                  />
                  <IconSunHigh
                    class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"
                    aria-hidden="true"
                  />
                  <span class="sr-only">{tr("theme.toggle")}</span>
                </button>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
  </div>
  <Hr />
</header>

<script define:vars={{ tr }}>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? tr("ui.menu") : tr("ui.close"));

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>

<style>
  .language-switcher-compact {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
  }

  .language-switcher-compact a {
    min-width: auto;
    padding: 0.25rem 0.5rem;
  }

  @media (max-width: 640px) {
    .language-switcher-compact {
      justify-content: center;
      width: 100%;
    }
  }
</style>
