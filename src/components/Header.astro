---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";
import DummyLogo from "@/assets/dummy-logo.svg";
import { getCurrentLocale, t } from "@/i18n/utils";
import { normalizePathWithLocale } from "@/utils/url";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface HeaderProps {
  switchOverride?: Record<string, string | undefined>;
  activeNav?: string;
}

const { pathname } = Astro.url;
const { switchOverride, activeNav } = Astro.props as HeaderProps;

// I18n variables
const currentLocale = getCurrentLocale(Astro);
const localePrefix = currentLocale === "zh-CN" ? "" : `/${currentLocale}`;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const normalizeSegments = (segments: string[]) => {
  if (!segments.length) return segments;
  return segments[0] === currentLocale ? segments.slice(1) : segments;
};

const normalizedCurrentPath = normalizeSegments(
  currentPath.split("/").filter(p => p.trim())
);

const forcedActiveSegment = activeNav
  ?.replace(/^\/+|\/+$/g, "")
  .split("/")
  .filter(Boolean)[0];

const isActive = (path: string) => {
  const targetSegments = normalizeSegments(
    path.split("/").filter(p => p.trim())
  );
  const currentFirst = normalizedCurrentPath[0];
  const targetFirst = targetSegments[0];

  if (forcedActiveSegment) {
    return targetFirst === forcedActiveSegment;
  }

  const normalizedCurrent = `/${normalizedCurrentPath.join("/")}` || "/";
  const normalizedTarget = `/${targetSegments.join("/")}` || "/";

  return (
    normalizedCurrent === normalizedTarget ||
    (!!currentFirst && currentFirst === targetFirst)
  );
};

// Build localized URL
const localeUrl = (path: string) => normalizePathWithLocale(path, localePrefix);

// Get translation function
const tr = (key: string, params?: Record<string, string | number>) =>
  t(Astro, key, params);
---

<header>
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    {tr("ui.skipToContent")}
  </a>
  <div
    id="nav-container"
    class="mx-auto flex max-w-app flex-col items-center justify-between sm:flex-row"
  >
    <div
      id="top-nav-wrap"
      class="relative flex w-full items-center justify-between bg-background p-4 sm:py-4"
    >
      <div class="flex w-full items-center justify-between sm:w-auto">
        <a
          href={localeUrl("/")}
          class="flex items-center"
          aria-label={tr("nav.home")}
        >
          <DummyLogo class="h-auto w-[45px] sm:w-[50px]" />
        </a>
        <button
          id="menu-btn"
          type="button"
          class="focus-outline rounded-md p-2 sm:hidden"
          aria-label={tr("ui.menu")}
          aria-expanded="false"
          aria-controls="nav-menu"
          data-menu-label={tr("ui.menu")}
          data-close-label={tr("ui.close")}
        >
          <IconMenuDeep id="menu-icon" />
        </button>
      </div>
      <nav
        id="nav-menu"
        class="sm:backdrop-blur-0 fixed inset-0 z-[70] hidden items-center justify-center bg-background/80 px-4 py-8 backdrop-blur-3xl sm:static sm:z-auto sm:ms-2 sm:flex sm:w-auto sm:justify-end sm:bg-transparent sm:p-0"
      >
        <div
          id="menu-panel"
          class="w-full max-w-xs rounded-lg border border-border/70 bg-background p-4 shadow-2xl shadow-foreground/20 sm:flex sm:w-auto sm:max-w-none sm:items-center sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none"
        >
          <div class="mb-4 flex items-center justify-between sm:hidden">
            <span
              id="menu-panel-title"
              class="text-sm font-semibold tracking-wide text-foreground/70"
            >
              {tr("ui.menu")}
            </span>
            <button
              id="menu-close"
              type="button"
              class="focus-outline rounded-md p-2 text-foreground/80 transition-colors hover:bg-muted/50 hover:text-foreground"
              aria-label={tr("ui.close")}
            >
              <IconX />
            </button>
          </div>
          <ul
            id="menu-items"
            class:list={[
              "grid w-full grid-cols-2 gap-2",
              "[&>li>a]:block [&>li>a]:rounded-md [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium [&>li>a]:hover:bg-muted/50 [&>li>a]:hover:text-accent sm:[&>li>a]:px-2 sm:[&>li>a]:py-1 sm:[&>li>a]:hover:bg-transparent",
              "sm:flex sm:w-auto sm:gap-x-5 sm:gap-y-0",
            ]}
          >
            <li class="col-span-2">
              <a
                href={localeUrl("/posts")}
                class:list={{ "active-nav": isActive("/posts") }}
              >
                {tr("nav.blog")}
              </a>
            </li>
            <li class="col-span-2">
              <a
                href={localeUrl("/tags")}
                class:list={{ "active-nav": isActive("/tags") }}
              >
                {tr("nav.tags")}
              </a>
            </li>
            <li class="col-span-2">
              <a
                href={localeUrl("/about")}
                class:list={{ "active-nav": isActive("/about") }}
              >
                {tr("nav.about")}
              </a>
            </li>
            <li class="col-span-2">
              <a
                href={localeUrl("/milestones")}
                class:list={{ "active-nav": isActive("/milestones") }}
              >
                {tr("nav.milestones")}
              </a>
            </li>
            {
              SITE.showArchives && (
                <li class="col-span-2">
                  <LinkButton
                    href={localeUrl("/archives")}
                    class:list={[
                      "focus-outline flex justify-center p-3 sm:p-1",
                      {
                        "active-nav [&>svg]:stroke-accent":
                          isActive("/archives"),
                      },
                    ]}
                    aria-label={tr("nav.archives")}
                    title={tr("nav.archives")}
                  >
                    <IconArchive
                      class="hidden sm:inline-block"
                      aria-hidden="true"
                    />
                    <span class="sm:sr-only">{tr("nav.archives")}</span>
                  </LinkButton>
                </li>
              )
            }
            <li class="col-span-1 flex items-center justify-center">
              <LinkButton
                href={localeUrl("/search")}
                class:list={[
                  "focus-outline flex p-3 sm:p-1",
                  { "[&>svg]:stroke-accent": isActive("/search") },
                ]}
                aria-label={tr("nav.search")}
                title={tr("nav.search")}
              >
                <IconSearch aria-hidden="true" />
                <span class="sr-only">{tr("nav.search")}</span>
              </LinkButton>
            </li>
            {
              SITE.lightAndDarkMode && (
                <li class="col-span-1 flex items-center justify-center">
                  <button
                    id="theme-btn"
                    class="focus-outline relative size-12 p-4 sm:size-8 hover:[&>svg]:stroke-accent"
                    title={tr("theme.toggle")}
                    aria-label={tr("theme.toggle")}
                    aria-live="polite"
                    data-label-light={tr("theme.switchToLight")}
                    data-label-dark={tr("theme.switchToDark")}
                  >
                    <IconMoon
                      class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90"
                      aria-hidden="true"
                    />
                    <IconSunHigh
                      class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0"
                      aria-hidden="true"
                    />
                    <span class="sr-only">{tr("theme.toggle")}</span>
                  </button>
                </li>
              )
            }
          </ul>
          <!-- Language switcher - desktop and mobile -->
          <div class="lang-switcher-container hidden sm:flex">
            <LanguageSwitcher override={switchOverride} />
          </div>
          <!-- Mobile language switcher (show full label) -->
          <div class="lang-switcher-mobile sm:hidden">
            <LanguageSwitcher
              override={switchOverride}
              class="mobile-dropdown"
            />
          </div>
        </div>
      </nav>
    </div>
  </div>
  <div class="mx-auto max-w-app px-4" aria-hidden="true">
    <div class="border-b border-border"></div>
  </div>
</header>

<script src="@/scripts/header-nav.ts"></script>

<style>
  /* Desktop language switcher */
  .lang-switcher-container {
    display: none;
  }

  @media (min-width: 640px) {
    .lang-switcher-container {
      display: flex;
      align-items: center;
      margin-left: 0.75rem;
    }
  }

  /* Mobile language switcher area */
  .lang-switcher-mobile {
    display: none;
  }

  @media (max-width: 639px) {
    .lang-switcher-mobile {
      display: block;
      margin-top: 1.25rem;
      padding-top: 1rem;
      border-top: 1px solid hsl(var(--border) / 0.2);
      width: 100%;
    }

    .lang-switcher-mobile.hidden {
      display: none;
    }

    /* Mobile dropdown optimization - show full language name */
    .lang-switcher-mobile :global(.lang-dropdown-btn .current-lang) {
      display: inline !important;
    }

    /* Mobile dropdown full-width */
    .lang-switcher-mobile :global(.language-switcher-dropdown) {
      width: 100%;
    }

    .lang-switcher-mobile :global(.lang-dropdown-btn) {
      width: 100%;
      justify-content: space-between;
      padding: 0.875rem 1.25rem;
    }

    .lang-switcher-mobile :global(.lang-dropdown-menu) {
      left: 0;
      right: 0;
      width: 100%;
    }

    #nav-menu {
      background: color-mix(in srgb, var(--background) 30%, transparent);
      backdrop-filter: blur(8px) saturate(1.06);
      -webkit-backdrop-filter: blur(8px) saturate(1.06);
    }

    #menu-panel {
      background: var(--background);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
