---
import { SOCIALS } from "@/constants";
import LinkButton from "./LinkButton.astro";
import { t } from "@/i18n/utils";

export interface Props {
  centered?: boolean;
}

const { centered = false } = Astro.props;
const tr = (key: string, params?: Record<string, string | number>) =>
  t(Astro, key, params);
---

<div class:list={["flex-wrap justify-center gap-1", { flex: centered }]}>
  {
    SOCIALS.map(social => {
      const label =
        social.name === "Mail"
          ? tr("ui.emailMe")
          : social.name === "GitHub"
            ? tr("ui.githubMe")
            : social.name;
      const isExternal = social.href.startsWith("http");

      return (
        <LinkButton
          href={social.href}
          class="p-2 hover:rotate-6 sm:p-1"
          title={label}
          aria-label={label}
          {...(isExternal && {
            target: "_blank",
            rel: "noopener noreferrer me",
          })}
        >
          <social.icon
            class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 group-hover:fill-transparent sm:scale-110"
            aria-hidden="true"
          />
          <span class="sr-only">{label}</span>
        </LinkButton>
      );
    })
  }
</div>
