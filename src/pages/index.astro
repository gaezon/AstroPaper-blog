---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { t } from "@/i18n/utils";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const tr = (key: string, params?: Record<string, string | number>) =>
  t(Astro, key, params);
---

<Layout title={SITE.title} description={tr("site.description")}>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-8 pb-6">
      <div class="flex items-center gap-2">
        <h1
          id="hero-heading"
          class="text-3xl font-bold sm:text-4xl md:text-5xl"
        >
          Gaazeon
        </h1>
        <a
          target="_blank"
          href="/rss.xml"
          class="inline-block"
          aria-label="rss feed"
          title={tr("ui.rss")}
        >
          <IconRss
            width={20}
            height={20}
            class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
            aria-hidden="true"
          />
          <span class="sr-only">{tr("ui.rss")}</span>
        </a>
      </div>

      <p class="mt-4">
        {tr("site.description")}
      </p>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex flex-col sm:flex-row sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {tr("ui.socialLinks")}
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <Hr noPadding={true} />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-6 pb-4">
            <h2
              id="featured-heading"
              class="text-2xl font-semibold tracking-wide"
            >
              {tr("index.featuredPosts")}
            </h2>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <Hr noPadding={true} />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-6 pb-4">
          <h2
            id="recent-posts-heading"
            class="text-2xl font-semibold tracking-wide"
          >
            {tr("index.recentPosts")}
          </h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/" aria-label={tr("index.viewAllPosts")}>
        {tr("index.viewAllPosts")}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      const currentPath = window.location.pathname;
      const backUrl = currentPath.endsWith("/")
        ? currentPath
        : `${currentPath}/`;
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
