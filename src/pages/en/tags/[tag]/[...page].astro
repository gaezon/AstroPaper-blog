---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";
import { t } from "@/i18n/utils";
import { getEnglishTag, resolveZhFromEnSlug } from "@/i18n/tagMap";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  // 使用中文集合生成 EN 路由，URL 用英文 slug，分页列表用中文标签筛选
  const posts = await getCollection("blog");
  const zhTags = getUniqueTags(posts);

  return zhTags.flatMap(({ tag: zhSlug, tagName: zhName }) => {
    const meta = getEnglishTag(zhName);
    const tagPosts = getPostsByTag(posts, zhSlug);

    return paginate(tagPosts, {
      params: { tag: meta.enSlug },
      props: { tagName: meta.enName, zhTag: zhName },
      pageSize: SITE.postPerPage,
    });
  });
}

const { tag: enSlug } = Astro.params;
// 分页属性来自 getStaticPaths 的 props
const { page, tagName, zhTag } = Astro.props as {
  page: any;
  tagName: string;
  zhTag: string;
};
const meta = getEnglishTag(zhTag);
const pageTitle = `${t(Astro, "tags.title")}: ${meta.enName}`;
const pageDescription = t(Astro, "tags.postsWithTag");
---

<Layout
  title={`${pageTitle} | ${SITE.title}`}
  description={`${t(Astro, "tags.postsWithTag")} ${tagName}.`}
>
  <Header />
  <Main
    pageTitle={[`${t(Astro, "tags.title")}:`, `${meta.enName}`]}
    titleTransition={enSlug}
    pageDesc={pageDescription}
  >
    <h1 slot="title" transition:name={enSlug}>{`${t(Astro, "tags.title")}:${meta.enName}`}</h1>
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
