---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Tag from "@/components/Tag.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import { SITE } from "@/config";
import { t } from "@/i18n/utils";
import { getEnglishTag } from "@/i18n/tagMap";

// 基于中文文章集合构建标签（确保与中文一致）
const posts = await getCollection("blog");

let tags = getUniqueTags(posts).map(({ tag, tagName }) => {
  const meta = getEnglishTag(tagName);
  return { tag: meta.enSlug, tagName: meta.enName };
});
const pageTitle = t(Astro, "tags.title");
const pageDescription = t(Astro, "tags.description");
---

<Layout
  title={`${pageTitle} | ${SITE.title}`}
  description={pageDescription}
>
  <Header />
  <Main pageTitle={pageTitle} pageDesc={t(Astro, "tags.allTags")}>
    <ul>
      {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} size="lg" />)}
    </ul>
  </Main>
  <Footer />
</Layout>
