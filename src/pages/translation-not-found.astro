---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import TranslationNotFoundComponent from "@/components/TranslationNotFound.astro";
import { t } from "@/i18n/utils";
import { getPath } from "@/utils/getPath";

const [zhPosts, enPosts] = await Promise.all([
  getCollection("blog"),
  getCollection("blog-en"),
]);

const postTitleByPath = Object.fromEntries(
  [...zhPosts, ...enPosts]
    .filter(post => !post.data.draft)
    .map(post => [
      getPath(post.id, post.filePath, true, post.data.slug),
      post.data.title,
    ])
);

const tr = (key: string, params?: Record<string, string | number>) =>
  t(Astro, key, params);
---

<Layout title={tr("language.translationNotFound")}>
  <Header activeNav="posts" />
  <main class="min-h-screen pt-16">
    <TranslationNotFoundComponent
      targetLocale="en"
      currentPostTitle=""
      currentPath="/"
      postTitleByPath={postTitleByPath}
    />
  </main>
  <Footer />
</Layout>
