---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import TranslationNotFoundComponent from "@/components/TranslationNotFound.astro";
import { getCurrentLocale, t } from "@/i18n/utils";
import { slugifyStr } from "@/utils/slugify";

const targetLocale = Astro.url.searchParams.get("target") || "en";
const currentPath = decodeURIComponent(
  Astro.url.searchParams.get("path") || ""
);

// Extract post slug from the current path
const pathSegments = currentPath.split("/").filter(Boolean);
const postSlug = pathSegments[pathSegments.length - 1];

// Determine which collection to search based on current locale
const currentLocale = getCurrentLocale(Astro);
const collectionName = currentLocale === "en" ? "blog-en" : "blog";

// Try to find the post and extract its title
let currentPostTitle = postSlug; // Fallback to slug if post not found

try {
  const posts = await getCollection(collectionName as "blog" | "blog-en");
  const post = posts.find(p => slugifyStr(p.data.title) === postSlug);
  
  if (post) {
    currentPostTitle = post.data.title;
  }
} catch {
  // Silently fallback to slug if post cannot be found
}

const tr = (key: string, params?: Record<string, string | number>) =>
  t(Astro, key, params);
---

<Layout title={tr("language.translationNotFound")}>
  <Header />
  <main class="min-h-screen pt-16">
    <TranslationNotFoundComponent
      targetLocale={targetLocale}
      currentPostTitle={currentPostTitle}
      currentPath={currentPath}
    />
  </main>
  <Footer />
</Layout>
