---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import TranslationNotFound from "@/components/TranslationNotFound.astro";
import { getCurrentLocale, t } from "@/i18n/utils";

const targetLocale = Astro.url.searchParams.get("target") || "en";
const currentPath = decodeURIComponent(
  Astro.url.searchParams.get("path") || ""
);
const currentPostTitle = decodeURIComponent(
  Astro.url.searchParams.get("title") || ""
);

const tr = (key: string, params?: Record<string, string | number>) =>
  t(Astro, key, params);
---

<Layout title={tr("language.translationNotFound")}>
  <Header />
  <main class="min-h-screen pt-16">
    <TranslationNotFound
      targetLocale={targetLocale}
      currentPostTitle={currentPostTitle}
      currentPath={currentPath}
    />
  </main>
  <Footer />
</Layout>
