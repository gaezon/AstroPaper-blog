---
import type { GetStaticPaths } from "astro";
import type { BlogPaginatedPageProps } from "@/types/pagination";
import PostListPage from "@/components/PostListPage.astro";
import { getPaginatedPostPaths } from "@/utils/i18n-pages";

type Props = BlogPaginatedPageProps;

export const getStaticPaths = (async ({ paginate }) => {
  return getPaginatedPostPaths("zh-CN", paginate);
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<PostListPage {page} />
