{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blog.gaazeon.com/schemas/post-detail.schema.json",
  "schemaVersion": "1.0.0",
  "title": "Post Detail",
  "description": "Shape of /api/posts/{locale}/{slug}.json: a single post document including body excerpt and bilingual translation links.",
  "type": "object",
  "required": [
    "slug",
    "title",
    "originalSlug",
    "url",
    "locale",
    "pubDatetime",
    "modDatetime",
    "tags",
    "description",
    "author",
    "featured",
    "draft",
    "body",
    "canonicalURL",
    "translations"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "originalSlug": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://.+/$"
    },
    "locale": {
      "type": "string",
      "enum": ["zh-CN", "en"]
    },
    "pubDatetime": {
      "type": "string",
      "format": "date-time"
    },
    "modDatetime": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "featured": {
      "type": "boolean"
    },
    "draft": {
      "type": "boolean",
      "const": false
    },
    "body": {
      "type": "string",
      "maxLength": 500
    },
    "canonicalURL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://.+"
    },
    "translations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["locale", "url"],
        "properties": {
          "locale": {
            "type": "string",
            "enum": ["zh-CN", "en"]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://.+"
          }
        }
      }
    }
  }
}
