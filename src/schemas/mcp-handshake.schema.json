{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blog.gaazeon.com/schemas/mcp-handshake.schema.json",
  "schemaVersion": "1.0.0",
  "title": "MCP Handshake Response",
  "description": "Shape returned by the /.well-known/mcp live endpoint on GET and inside the JSON-RPC `result` on POST initialize.",
  "type": "object",
  "required": [
    "schemaVersion",
    "protocolVersion",
    "serverInfo",
    "capabilities",
    "liveHandshake",
    "resources"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "protocolVersion": {
      "type": "string",
      "minLength": 1
    },
    "serverInfo": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["tools", "resources", "prompts", "streaming"],
      "properties": {
        "tools": {
          "type": "boolean"
        },
        "resources": {
          "type": "boolean"
        },
        "prompts": {
          "type": "boolean"
        },
        "streaming": {
          "type": "boolean"
        }
      }
    },
    "liveHandshake": {
      "type": "boolean"
    },
    "resources": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["uri", "name", "mimeType"],
        "properties": {
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mimeType": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "documentationUrl": {
      "type": "string",
      "format": "uri"
    }
  }
}
