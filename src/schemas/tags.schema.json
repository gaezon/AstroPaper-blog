{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blog.gaazeon.com/schemas/tags.schema.json",
  "schemaVersion": "1.0.0",
  "title": "Tags Index",
  "description": "Shape of /api/tags.json: an object keyed by tag name whose values carry bilingual post counts and canonical tag URLs.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["counts", "urls"],
    "properties": {
      "counts": {
        "type": "object",
        "required": ["zh-CN", "en"],
        "properties": {
          "zh-CN": {
            "type": "integer",
            "minimum": 0
          },
          "en": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "urls": {
        "type": "object",
        "required": ["zh-CN", "en"],
        "properties": {
          "zh-CN": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://.+"
          },
          "en": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://.+"
          }
        }
      }
    }
  }
}
