{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blog.gaazeon.com/schemas/post-summary.schema.json",
  "schemaVersion": "1.0.0",
  "title": "Post Summary Array",
  "description": "Shape of /api/posts.json: an array of post summary objects covering both zh-CN and en locales.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "slug",
      "title",
      "originalSlug",
      "url",
      "locale",
      "pubDatetime",
      "modDatetime",
      "tags",
      "description"
    ],
    "properties": {
      "slug": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "originalSlug": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://.+/$"
      },
      "locale": {
        "type": "string",
        "enum": ["zh-CN", "en"]
      },
      "pubDatetime": {
        "type": "string",
        "format": "date-time"
      },
      "modDatetime": {
        "oneOf": [
          {
            "type": "string",
            "format": "date-time"
          },
          {
            "type": "null"
          }
        ]
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": {
        "type": "string"
      }
    }
  }
}
