---
import { render, getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import Datetime from "@/components/Datetime.astro";
import EditPost from "@/components/EditPost.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import Comment from "@/components/Comment.astro";
import { slugifyStr } from "@/utils/slugify";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";
import { getPath } from "@/utils/getPath";
import { getCurrentLocale } from "@/i18n/utils";
import { t } from "@/i18n/utils";

type PostEntry = CollectionEntry<"blog" | "blog-en">;

export interface Props {
  post: PostEntry;
  posts: PostEntry[];
}

const { post, posts } = Astro.props;
const tr = (key: string, params?: Record<string, string | number>) =>
  t(Astro, key, params);

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
} = post.data;

const { Content, headings } = await render(post);

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  // getPath returns a trailing slash, so don't insert another slash
  ogImageUrl = `${getPath(post.id, post.filePath)}index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

/* ========== Prev/Next Posts ========== */

// Helper function to get adjacent posts with proper boundary checking
const getAdjacentPosts = (
  allPosts: Array<{ id: string; title: string; filePath: string | undefined }>,
  currentIndex: number
) => {
  const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
  const nextPost =
    currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
  return { prevPost, nextPost };
};

const allPosts = posts.map(({ data: { title }, id, filePath }) => ({
  id,
  title,
  filePath,
}));

const currentPostIndex = allPosts.findIndex(a => a.id === post.id);

const { prevPost, nextPost } = getAdjacentPosts(allPosts, currentPostIndex);

// ===== Language switch: cross-link overrides (precomputed before template) =====
const currentLocale = getCurrentLocale(Astro);
const switchOverride: Record<string, string | undefined> = {};
try {
  if (currentLocale === "zh-CN") {
    const enPosts = await getCollection("blog-en");
    const matched = enPosts.find(
      p => p.data.originalTitle === post.data.title && !p.data.draft
    );
    if (matched) {
      switchOverride["en"] = getPath(matched.id, matched.filePath);
    }
  } else {
    const zhPosts = await getCollection("blog");
    const originTitle = post.data.originalTitle as string | undefined;
    if (originTitle) {
      const matched = zhPosts.find(
        p => p.data.title === originTitle && !p.data.draft
      );
      if (matched) {
        switchOverride["zh-CN"] = getPath(matched.id, matched.filePath);
      }
    }
  }
} catch {}

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
  alternateURLs: switchOverride,
};
---

<Layout {...layoutProps}>
  <Header switchOverride={switchOverride} />
  <BackButton />
  <!-- TOC component outside <main>, as a standalone navigation aid -->
  <TableOfContents headings={headings} />

  <main
    id="main-content"
    class:list={[
      "relative w-full px-4 pb-12",
      { "mt-8": !SITE.showBackButton },
    ]}
    data-pagefind-body
  >
    <!-- Article content container: reserve space for left TOC on desktop; align with Go back (px-2) -->
    <div class="flex w-full justify-center">
      <div class="mx-auto w-full max-w-app px-2">
        <!-- Article title area: add top margin to avoid overlapping the Go back button -->
        <div class="mt-6 mb-4">
          <h1
            id="article-title"
            transition:name={slugifyStr(title)}
            class="text-2xl leading-tight font-bold text-accent sm:text-3xl"
          >
            {title}
          </h1>
        </div>
        <div class="my-2 flex items-center gap-2">
          <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
          <span
            aria-hidden="true"
            class:list={[
              "max-sm:hidden",
              { hidden: !SITE.editPost.enabled || hideEditPost },
            ]}
          >
            |
          </span>
          <EditPost {hideEditPost} {post} class="max-sm:hidden" />
        </div>
        <article
          id="article"
          class="app-prose mx-auto mt-8 max-w-full prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)"
          role="main"
          aria-labelledby="article-title"
        >
          <Content />
        </article>

        <hr class="my-8 border-dashed" />

        <EditPost class="sm:hidden" {hideEditPost} {post} />

        <ul class="mt-4 mb-8 sm:my-8">
          {
            tags.map((tag: string) => (
              <Tag tag={slugifyStr(tag)} tagName={tag} />
            ))
          }
        </ul>

        <Comment post={post} />
        <BackToTopButton />

        <ShareLinks />

        <hr class="my-6 border-dashed" />

        <!-- Previous/Next Post Buttons -->
        <div data-pagefind-ignore class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          {
            prevPost && (
              <a
                href={getPath(prevPost.id, prevPost.filePath)}
                class="flex w-full gap-1 hover:opacity-75"
              >
                <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
                <div>
                  <span>{tr("post.previousPost")}</span>
                  <div class="text-sm text-accent/85">{prevPost.title}</div>
                </div>
              </a>
            )
          }
          {
            nextPost && (
              <a
                href={getPath(nextPost.id, nextPost.filePath)}
                class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
              >
                <div>
                  <span>{tr("post.nextPost")}</span>
                  <div class="text-sm text-accent/85">{nextPost.title}</div>
                </div>
                <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
              </a>
            )
          }
        </div>
      </div><!-- Close article-container div -->
    </div><!-- Close flex container div -->
  </main>
  <Footer />
</Layout>

<script>
  import {
    createThrottledScrollListener,
    calculateScrollPercent,
  } from "@/utils/scroll";

  let scrollProgressCleanup: (() => void) | null = null;
  const progressContainerSelector = ".progress-container";

  function removeProgressBar() {
    const existing = document.querySelector(progressContainerSelector);
    if (existing) {
      existing.remove();
    }
  }

  /** Create a progress indicator
   *  at the top */
  function createProgressBar() {
    if (document.querySelector(progressContainerSelector)) return;

    // Create the main container div
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    // Create the progress bar div
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    // Append the progress bar to the progress container
    progressContainer.appendChild(progressBar);

    // Append the progress container to the document body or any other desired parent element
    document.body.appendChild(progressContainer);
  }

  /** Update the progress bar
   *  when user scrolls */
  function updateScrollProgress() {
    if (scrollProgressCleanup) {
      scrollProgressCleanup();
      scrollProgressCleanup = null;
    }

    const updateProgress = () => {
      const scrollPercent = calculateScrollPercent();
      const myBar = document.getElementById("myBar");
      if (myBar) {
        myBar.style.width = `${scrollPercent}%`;
      }
    };

    updateProgress();
    scrollProgressCleanup = createThrottledScrollListener(
      document,
      updateProgress
    );
  }

  function initProgressBar() {
    removeProgressBar();
    createProgressBar();
    updateScrollProgress();
  }

  initProgressBar();

  /* Go to page start after page swap */
  document.addEventListener("astro:after-swap", () => {
    initProgressBar();
    window.scrollTo({ left: 0, top: 0, behavior: "instant" });
  });
</script>

<script is:inline data-astro-rerun>
  /** Attaches links to headings in the document,
   *  allowing sharing of sections easily */
  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Attaches copy buttons to code blocks in the document,
   * allowing users to copy code easily. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      // Check if --file-name-offset custom property exists
      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      // Determine the top positioning class
      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      // wrap codebock with relative parent element
      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      // visual feedback that task is completed
      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();
</script>
