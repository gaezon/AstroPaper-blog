---
import { ClientRouter } from "astro:transitions";
import SpeedInsights from "@vercel/speed-insights/astro";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { SITE } from "@/config";
import "@/styles/global.css";
import {
  getCurrentLocale,
  getLangTag,
  getTextDirection,
  t,
} from "@/i18n/utils";
import { DEFAULT_LOCALE, SUPPORTED_LOCALES } from "@/i18n/config";
import { ensureTrailingSlash } from "@/utils/url";

// I18n variables
const currentLocale = getCurrentLocale(Astro);
const langTag = getLangTag(Astro);
const textDirection = getTextDirection(Astro);

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  alternateURLs?: Record<string, string | undefined>;
}

const {
  title = currentLocale === "en" ? SITE.titleEn || SITE.title : SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = currentLocale === "en" ? SITE.descEn || SITE.desc : SITE.desc,
  ogImage = SITE.ogImage,
  canonicalURL: canonicalURLProp = new URL(Astro.url.pathname, Astro.site).href,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  alternateURLs = {},
} = Astro.props;

const canonicalURL = ensureTrailingSlash(
  new URL(canonicalURLProp, Astro.site).href
);

const normalizedPathname = ensureTrailingSlash(Astro.url.pathname);
const isPostPage =
  normalizedPathname.includes("/posts/") &&
  !normalizedPathname.endsWith("/posts/");

const nonDefaultLocales = SUPPORTED_LOCALES.filter(
  locale => locale !== DEFAULT_LOCALE
);

function stripLocalePrefix(pathname: string): string {
  for (const locale of nonDefaultLocales) {
    if (pathname === `/${locale}` || pathname === `/${locale}/`) {
      return "/";
    }
    if (pathname.startsWith(`/${locale}/`)) {
      const stripped = pathname.slice(locale.length + 1);
      return stripped === "" ? "/" : stripped;
    }
  }
  return pathname;
}

const basePath = ensureTrailingSlash(stripLocalePrefix(normalizedPathname));

const alternateUrlByLocale = SUPPORTED_LOCALES.reduce<Record<string, string>>(
  (acc, locale) => {
    if (locale === currentLocale) {
      acc[locale] = canonicalURL;
      return acc;
    }

    const override = alternateURLs[locale];
    if (override) {
      acc[locale] = new URL(ensureTrailingSlash(override), Astro.site).href;
      return acc;
    }

    if (!isPostPage) {
      const localizedPath =
        locale === DEFAULT_LOCALE ? basePath : `/${locale}${basePath}`;
      acc[locale] = new URL(localizedPath, Astro.site).href;
    }

    return acc;
  },
  {}
);

const hreflangLinks = SUPPORTED_LOCALES.map(locale => ({
  locale,
  href: alternateUrlByLocale[locale],
})).filter(link => Boolean(link.href));

const xDefaultURL = alternateUrlByLocale[DEFAULT_LOCALE] ?? canonicalURL;

// Use the processed 'description' as finalDescription
const finalDescription = description;

const socialImageURL = new URL(ogImage ?? "/og.png", Astro.url.origin).href;

// Note: When keeping variable examples, avoid unused assignments to satisfy ESLint

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: `${title}`,
  image: `${socialImageURL}`,
  datePublished: `${pubDatetime?.toISOString()}`,
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: `${author}`,
      ...(profile && { url: profile }),
    },
  ],
};
// Restrict Umami tracking to specific domains (avoid local/preview)
const siteHostname = new URL(SITE.website).hostname;
---

<!doctype html>
<html
  dir={textDirection}
  lang={langTag}
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      (function () {
        if (typeof window === "undefined") return;

        const DEFAULT_LOCALE = "zh-CN";
        const FALLBACK_LOCALE = "en";
        const SUPPORTED_LOCALES = [DEFAULT_LOCALE, "en"];
        const STORAGE_KEY = "preferred-locale";

        const path = window.location.pathname || "/";

        const hasLocalePrefix = SUPPORTED_LOCALES.some(locale => {
          if (locale === DEFAULT_LOCALE) return false;
          return path === `/${locale}` || path.startsWith(`/${locale}/`);
        });

        if (hasLocalePrefix) return;

        if (path !== "/") return;

        const safeStorage = {
          get() {
            try {
              return window.localStorage.getItem(STORAGE_KEY);
            } catch {
              return null;
            }
          },
          set(value) {
            try {
              window.localStorage.setItem(STORAGE_KEY, value);
            } catch {
              /* noop */
            }
          },
        };

        function resolveLocale(candidate) {
          if (!candidate) return null;
          const normalized = candidate.toLowerCase();
          if (normalized.startsWith("zh")) return DEFAULT_LOCALE;
          if (normalized.startsWith("en")) return "en";
          return null;
        }

        function detectLocaleFromNavigator() {
          const languages = Array.isArray(navigator.languages)
            ? navigator.languages
            : [];
          const fallbacks =
            languages.length > 0 ? languages : [navigator.language];

          for (const lang of fallbacks) {
            const resolved = resolveLocale(lang);
            if (resolved) return resolved;
          }

          return FALLBACK_LOCALE;
        }

        const storedLocale = safeStorage.get();
        const resolvedStoredLocale =
          storedLocale && resolveLocale(storedLocale);
        const preferredLocale =
          resolvedStoredLocale || detectLocaleFromNavigator();

        if (!preferredLocale || preferredLocale === DEFAULT_LOCALE) return;

        // Only store the locale if it was loaded from storage (i.e., user-set), not if detected from browser
        if (resolvedStoredLocale) {
          safeStorage.set(preferredLocale);
        }

        const nextPath = `/${preferredLocale}${path}`;
        const nextUrl = `${nextPath}${window.location.search}${window.location.hash}`;

        if (
          nextUrl !==
          window.location.pathname +
            window.location.search +
            window.location.hash
        ) {
          window.location.replace(nextUrl);
        }
      })();
    </script>
    <meta name="theme-color" content="#fdfdfd" />
    <script is:inline>
      (() => {
        const storageKey = "theme";
        const root = document.documentElement;
        const primaryColorScheme = "";
        const darkThemeColor = "#212737";
        const lightThemeColor = "#fdfdfd";

        let theme = "";

        try {
          const storedTheme = localStorage.getItem(storageKey);
          if (storedTheme === "light" || storedTheme === "dark") {
            theme = storedTheme;
          }
        } catch {
          theme = "";
        }

        if (
          !theme &&
          (primaryColorScheme === "light" || primaryColorScheme === "dark")
        ) {
          theme = primaryColorScheme;
        }

        if (!theme) {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        root.setAttribute("data-theme", theme);

        document
          .querySelector("meta[name='theme-color']")
          ?.setAttribute(
            "content",
            theme === "dark" ? darkThemeColor : lightThemeColor
          );
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- hreflang tags for SEO -->
    {
      hreflangLinks.map(link => (
        <link rel="alternate" hreflang={link.locale} href={link.href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={xDefaultURL} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={finalDescription} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:locale" content={langTag.replace("-", "_")} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={finalDescription} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t(Astro, "site.title")}
      href={new URL(
        `rss${currentLocale !== "zh-CN" ? "." + currentLocale : ""}.xml`,
        Astro.site
      )}
    />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />

    <script src="../scripts/toggle-theme.ts"></script>

    {
      import.meta.env.PROD && (
        // Umami Analytics (production only & domain-restricted)
        <script
          is:inline
          defer
          src="https://umami.gaazeon.com/umami"
          data-website-id="82ee4d3c-d021-4a8b-94b3-6ce6840b6416"
          data-domains={siteHostname}
        />
      )
    }

    <style is:inline>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
      }
    </style>
  </head>
  <body>
    <slot />

    {import.meta.env.PROD && <SpeedInsights />}
  </body>
</html>
