---
import { ClientRouter } from "astro:transitions";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { SITE } from "@/config";
import "@/styles/global.css";
import MermaidClient from "@/components/MermaidClient.astro";
import GoogleAdsense from "@/components/GoogleAdsense.astro";
import CookieConsentBanner from "@/components/CookieConsentBanner.astro";
import {
  getCurrentLocale,
  getLangTag,
  getTextDirection,
  t,
  getTranslations,
} from "@/i18n/utils";

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
}

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
} = Astro.props;

// 国际化相关变量
const currentLocale = getCurrentLocale(Astro);
const langTag = getLangTag(Astro);
const textDirection = getTextDirection(Astro);

// 如果没有提供描述，尝试从翻译中获取默认描述
const finalDescription =
  description === SITE.desc ? t(Astro, "site.description") : description;

const socialImageURL = new URL(ogImage ?? "/og.png", Astro.url.origin).href;

// 注意：保留变量示例时请避免未使用的赋值以通过 ESLint

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: `${title}`,
  image: `${socialImageURL}`,
  datePublished: `${pubDatetime?.toISOString()}`,
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: `${author}`,
      ...(profile && { url: profile }),
    },
  ],
};
// 仅用于限制 Umami 统计域名（避免本地与预览域名）
const siteHostname = new URL(SITE.website).hostname;
---

<!doctype html>
<html
  dir={textDirection}
  lang={langTag}
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- hreflang 标签用于 SEO -->
    <link rel="alternate" hreflang={currentLocale} href={canonicalURL} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={canonicalURL.replace(`/${currentLocale}`, "").replace(/\/$/, "") ||
        "/"}
    />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={finalDescription} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:locale" content={langTag.replace("-", "_")} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={finalDescription} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t(Astro, "site.title")}
      href={new URL(
        `rss${currentLocale !== "zh-CN" ? "." + currentLocale : ""}.xml`,
        Astro.site
      )}
    />

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />

    <script is:inline src="/toggle-theme.js"></script>

    <!-- Google AdSense -->
    <GoogleAdsense />

    <!-- Include Mermaid client component -->
    <MermaidClient />

    {
      import.meta.env.PROD && (
        // Umami Analytics（仅生产环境 & 限定域名）
        <script
          defer
          src="https://umami.gaazeon.com/umami"
          data-website-id="82ee4d3c-d021-4a8b-94b3-6ce6840b6416"
          data-domains={siteHostname}
        />
      )
    }

    <!-- Vercel Speed Insights -->
    <script is:inline defer src="/_vercel/speed-insights/script.js"></script>
    <style is:inline>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
      }
    </style>
  </head>
  <body>
    <slot />
    <CookieConsentBanner />
  </body>
</html>
