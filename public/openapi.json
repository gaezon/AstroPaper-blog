    "/pagefind/pagefind-entry.json": {
      "get": {
        "operationId": "getPagefindEntry",
        "tags": ["Discovery"],
        "summary": "Get static Pagefind search entry metadata",
        "responses": {
          "200": {
            "description": "Pagefind static search entry metadata.",
            "content": {
              "application/json": {
