          }
        }
      }
    },
    "/rss.en.xml": {
      "get": {
        "operationId": "getEnglishRssFeed",
        "tags": ["Discovery"],
        "summary": "Get English RSS feed",
        "responses": {
          "200": {
            "description": "RSS feed for English posts.",
            "content": {
              "application/rss+xml": {
