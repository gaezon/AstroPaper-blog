          }
        }
      }
    },
    "/schemamap.xml": {
      "get": {
        "operationId": "getSchemaMap",
        "tags": ["Discovery"],
        "summary": "Get schema map",
        "responses": {
          "200": {
            "description": "XML schema map for structured public resources.",
            "content": {
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/XmlDocument"
                }
              }
            }
          },
          "404": {
