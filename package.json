{
  "name": "astro-paper",
  "type": "module",
  "version": "6.1.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "preinstall": "node scripts/check-toolchain.mjs",
    "predev": "node scripts/check-toolchain.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/check-toolchain.mjs",
    "build": "pnpm run fetch:image-sizes && pnpm run generate:bilingual-mapping && astro build && pnpm run apply:vercel-routes && pagefind --site .vercel/output/static",
    "prebuild:strict": "node scripts/check-toolchain.mjs",
    "build:strict": "pnpm run fetch:image-sizes && pnpm run generate:bilingual-mapping && astro check && astro build && pnpm run apply:vercel-routes && pagefind --site .vercel/output/static",
    "apply:vercel-routes": "pnpm tsx scripts/apply-vercel-routes.ts",
    "og:preview": "tsx scripts/og-preview.ts",
    "prepreview": "node scripts/check-toolchain.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "i18n:scaffold-en": "tsx scripts/create-english-drafts.ts",
    "generate:bilingual-mapping": "pnpm tsx scripts/auto-discover-bilingual.ts",
    "fetch:image-sizes": "pnpm tsx scripts/fetch-image-sizes.ts",
    "twikoo:sri:update": "pnpm tsx scripts/manage-twikoo-sri.ts",
    "twikoo:sri:check": "pnpm tsx scripts/manage-twikoo-sri.ts --check",
    "clean:og": "pnpm tsx scripts/clean-og-cache.ts",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prelint": "node scripts/check-toolchain.mjs",
    "lint": "eslint .",
    "validate:meta": "pnpm tsx scripts/validate-meta-descriptions.ts",
    "pretest:unit": "node scripts/check-toolchain.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "pretest:sitemap": "node scripts/check-toolchain.mjs",
    "test:sitemap": "pnpm build && pnpm exec playwright test --config=playwright.sitemap.config.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.2",
    "@vercel/speed-insights": "^1.3.1",
    "astro": "^7.0.6",
    "lodash.kebabcase": "^4.1.1",
    "probe-image-size": "^7.2.3",
    "rehype-callouts": "^2.1.2",
    "rehype-mermaid": "^3.0.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.15.2",
    "sharp": "^0.34.3",
    "slugify": "1.6.9",
    "tailwindcss": "^4.3.2",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@pagefind/default-ui": "^1.5.2",
    "@playwright/test": "1.59.1",
    "@shikijs/transformers": "^4.0.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.4",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/node": "^24.0.3",
    "@types/probe-image-size": "^7.2.5",
    "eslint": "^9.30.1",
    "eslint-plugin-astro": "^1.7.0",
    "fast-check": "^4.7.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "mermaid": "^11.14.0",
    "pagefind": "^1.5.2",
    "playwright": "1.59.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,md,css,astro,yaml,yml}": "prettier --write"
  }
}
