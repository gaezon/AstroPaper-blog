{
  "name": "astro-paper",
  "type": "module",
  "version": "5.5.0",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run generate:bilingual-mapping && astro check && astro build && pagefind --site .vercel/output/static",
    "og:preview": "tsx scripts/og-preview.ts",
    "preview": "astro preview",
    "sync": "astro sync",
    "i18n:scaffold-en": "tsx scripts/create-english-drafts.ts",
    "generate:bilingual-mapping": "pnpm tsx scripts/auto-discover-bilingual.ts",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "validate:meta": "pnpm tsx scripts/validate-meta-descriptions.ts",
    "test:unit": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/vercel": "^9.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.11",
    "@vercel/speed-insights": "^1.3.1",
    "astro": "^5.14.6",
    "dayjs": "^1.11.13",
    "lodash.kebabcase": "^4.1.1",
    "marked": "^14.1.4",
    "rehype-mermaid": "^3.0.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.15.2",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.11",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@fontsource/noto-sans": "^5.2.6",
    "@fontsource/noto-sans-sc": "^5.2.5",
    "@pagefind/default-ui": "^1.3.0",
    "@playwright/test": "1.54.1",
    "@shikijs/transformers": "^3.7.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/node": "^24.0.3",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.30.1",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "markdownlint-cli": "^0.44.0",
    "mermaid": "^11.7.0",
    "pagefind": "^1.3.0",
    "playwright": "1.54.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^4.0.15"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,md,css,astro,yaml,yml}": "prettier --write"
  }
}
